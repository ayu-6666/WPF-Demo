<UserControl x:Class="GenaralDBTools.Views.RedisBrowserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="220"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 扫描工具栏 -->
  <WrapPanel Grid.Row="0" Margin="0,0,0,10">
   <TextBlock Text="Key 模式" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
   <TextBox Width="200" Height="32" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    ToolTip="支持通配符，例如 user:* 或 session:?" Margin="0,0,10,0"/>
   <TextBlock Text="最多扫描" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
   <TextBox Width="64" Height="32" Text="{Binding MaxKeysText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    ToolTip="10 - 1000" Margin="0,0,10,0"/>
   <Button Content="扫描 Keys" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
   <Button Content="新增 Key" Command="{Binding AddKeyCommand}" Margin="0,0,8,0"/>
   <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
   <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
    TextTrimming="CharacterEllipsis" MaxWidth="420"/>
  </WrapPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*" MinWidth="240"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="3*" MinWidth="280"/>
   </Grid.ColumnDefinitions>

   <!-- Key 列表 -->
   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="10,10,0,0" Padding="12,7"
      BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <TextBlock Text="Key 列表" FontWeight="SemiBold" Foreground="#FF475569"/>
     </Border>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}"
      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
       <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="76"/>
       <DataGridTextColumn Header="大小" Binding="{Binding LengthText}" Width="96"/>
       <DataGridTextColumn Header="TTL" Binding="{Binding TtlText}" Width="82"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>

   <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>

   <!-- Key 详情 -->
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="10,10,0,0" Padding="12,7"
      BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Text="{Binding Detail.TtlText}" Foreground="{StaticResource MutedBrush}"
        VerticalAlignment="Center"/>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Detail.Key}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
         TextTrimming="CharacterEllipsis" MaxWidth="300"/>
        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
         VerticalAlignment="Center">
         <TextBlock Text="{Binding Detail.Type}" FontSize="11.5" Foreground="#FF1E3A8A"/>
        </Border>
       </StackPanel>
      </DockPanel>
     </Border>

     <Grid Grid.Row="1" Margin="12,10,12,4">
      <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
       Style="{StaticResource MultilineTextBox}" Height="Auto" MinHeight="120"
       FontFamily="Cascadia Code,Consolas" FontSize="13"
       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
       Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}"/>
      <TextBlock Text="从左侧选择一个 key 查看类型、TTL 与内容；也可点击“新增 Key”创建。" Foreground="#FF94A3B8"
       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
       Visibility="{Binding Detail, Converter={StaticResource InverseNullToVisibility}}"/>
     </Grid>

     <Border Grid.Row="2" Padding="12,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
      <StackPanel>
       <WrapPanel Margin="0,0,0,6">
        <Button Content="保存内容" Command="{Binding SaveValueCommand}" Style="{StaticResource PrimaryButton}"
         Margin="0,0,8,6"/>
        <Button Content="编辑 Key" Command="{Binding EditKeyCommand}" Margin="0,0,8,6"/>
        <Button Content="删除 Key" Command="{Binding DeleteKeyCommand}" Style="{StaticResource DangerButton}"
         Margin="0,0,8,6"/>
        <TextBlock Text="TTL（秒）" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,6"/>
        <TextBox Width="82" Height="32" Text="{Binding TtlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         ToolTip="留空表示不设置" Margin="0,0,6,6"/>
        <Button Content="应用 TTL" Command="{Binding ApplyTtlCommand}" Height="32" Margin="0,0,6,6"/>
        <Button Content="设为永久" Command="{Binding PersistKeyCommand}" Height="32" Margin="0,0,0,6"/>
       </WrapPanel>
       <TextBlock Text="内容格式：string 直接输入；hash 每行 field=value；list/set 每行一个元素；zset 每行 member=score。"
        Style="{StaticResource MutedText}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>

  <!-- 命令控制台 -->
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="10,10,0,0" Padding="12,6"
     BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostButton}" Height="26" FontSize="12"
       Command="{Binding ClearCommandOutputCommand}"/>
      <TextBlock Text="Redis 命令控制台" FontWeight="SemiBold" Foreground="#FF475569" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="12,8,12,6">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBox Grid.Column="0" Height="32" FontFamily="Cascadia Code,Consolas"
      Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="例如 GET mykey、HGETALL user:1、TTL mykey"/>
     <Button Grid.Column="1" Content="执行命令" Command="{Binding ExecuteCommandCommand}"
      Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="32"/>
    </Grid>
    <TextBox Grid.Row="2" Text="{Binding CommandOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
     Style="{StaticResource MultilineTextBox}" Height="Auto" MinHeight="90" Margin="12,0,12,10"
     FontFamily="Cascadia Code,Consolas" FontSize="12" TextWrapping="NoWrap"
     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
