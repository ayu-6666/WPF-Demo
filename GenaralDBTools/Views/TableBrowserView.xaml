<UserControl x:Class="GenaralDBTools.Views.TableBrowserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 行级与表级操作 -->
  <WrapPanel Grid.Row="0" Margin="0,0,0,8">
   <Button Content="刷新数据" Command="{Binding RefreshCommand}" Margin="0,0,8,6"/>
   <Button Content="新增行" Command="{Binding InsertRowCommand}" Style="{StaticResource PrimaryButton}"
    IsEnabled="{Binding CanEditRows}" Margin="0,0,8,6"/>
   <Button Content="修改行" Command="{Binding EditRowCommand}" IsEnabled="{Binding CanEditRows}" Margin="0,0,8,6"/>
   <Button Content="删除行" Command="{Binding DeleteRowCommand}" Style="{StaticResource DangerButton}"
    IsEnabled="{Binding CanEditRows}" Margin="0,0,8,6"/>
   <Border Width="1" Background="{StaticResource BorderBrushSoft}" Margin="4,4,12,10"/>
   <Button Content="新建表" Command="{Binding CreateTableCommand}" Margin="0,0,8,6"/>
   <Button Content="删除表" Command="{Binding DropTableCommand}" Margin="0,0,8,6"/>
   <TextBlock Text="视图（只读）" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
    Margin="4,0,0,6" Visibility="{Binding IsView, Converter={StaticResource BoolToVisibility}}"/>
  </WrapPanel>

  <!-- 筛选 -->
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock Grid.Column="0" Text="筛选条件（WHERE）" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
    Margin="0,0,8,0"/>
   <TextBox Grid.Column="1" MinWidth="180" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    ToolTip="填写 SQL WHERE 条件，例如 status = 'A' AND id &gt; 10，留空表示不过滤"/>
   <Button Grid.Column="2" Content="应用" Command="{Binding ApplyFilterCommand}" Margin="8,0,0,0"/>
   <Button Grid.Column="3" Content="清除" Command="{Binding ClearFilterCommand}" Margin="6,0,0,0"/>
  </Grid>

  <!-- 数据 + 字段信息 -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MinWidth="200"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="264" MinWidth="180"/>
   </Grid.ColumnDefinitions>

   <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="True"
     IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AlternatingRowBackground="#FFFAFCFF"/>
   </Border>

   <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>

   <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="8,8,0,0" Padding="10,7"
      BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <TextBlock Text="字段信息" FontWeight="SemiBold" Foreground="#FF475569"/>
     </Border>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}"
      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="30" ColumnHeaderHeight="32">
      <DataGrid.Columns>
       <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="Auto"/>
       <DataGridCheckBoxColumn Header="主键" Binding="{Binding IsPrimaryKey}" Width="52"/>
       <DataGridCheckBoxColumn Header="可空" Binding="{Binding IsNullable}" Width="52"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
  </Grid>

  <TextBlock Grid.Row="3" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
   Margin="2,8,2,0" Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}"/>

  <!-- 分页栏 -->
  <Border Grid.Row="4" Background="#FFF8FAFC" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
   CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
   <DockPanel>
    <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock Text="每页" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <ComboBox Width="72" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Margin="0,0,12,0"/>
     <Button Content="首页" Command="{Binding FirstPageCommand}" Height="30" Padding="10,0" Margin="0,0,4,0"
      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
     <Button Content="上一页" Command="{Binding PreviousPageCommand}" Height="30" Padding="10,0" Margin="0,0,6,0"
      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
     <TextBox Width="52" Height="30" Text="{Binding PageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      ToolTip="输入页码后按“跳转”" HorizontalContentAlignment="Center" Margin="0,0,4,0"/>
     <Button Content="跳转" Command="{Binding GoToPageCommand}" Height="30" Padding="10,0" Margin="0,0,6,0"
      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
     <Button Content="下一页" Command="{Binding NextPageCommand}" Height="30" Padding="10,0" Margin="0,0,4,0"
      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
     <Button Content="末页" Command="{Binding LastPageCommand}" Height="30" Padding="10,0" Margin="0,0,10,0"
      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
     <TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
      FontWeight="SemiBold"/>
    </WrapPanel>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
