<Window x:Class="GenaralDBTools.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:GenaralDBTools.Models"
 Title="GenaralDBTools · 数据库工作台" Width="1360" Height="860" MinWidth="1080" MinHeight="660"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
 FontFamily="Microsoft YaHei UI" FontSize="12.5" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 菜单栏 -->
  <Menu Grid.Row="0" Padding="6,0">
   <MenuItem Header="文件">
    <MenuItem Header="新建连接…" Command="{Binding AddConnectionCommand}" InputGestureText="Ctrl+N"/>
    <MenuItem Header="新建 SQL 编辑器" Command="{Binding NewSqlTabCommand}" InputGestureText="Ctrl+T"/>
    <Separator/>
    <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
   </MenuItem>
   <MenuItem Header="编辑">
    <MenuItem Header="编辑连接…" Command="{Binding EditConnectionCommand}"/>
    <MenuItem Header="删除连接" Command="{Binding DeleteConnectionCommand}"/>
   </MenuItem>
   <MenuItem Header="搜索">
    <MenuItem Header="刷新连接列表" Command="{Binding RefreshConnectionsCommand}"/>
    <MenuItem Header="刷新对象" Command="{Binding RefreshObjectsCommand}"/>
   </MenuItem>
   <MenuItem Header="视图">
    <MenuItem Header="清空运行日志" Command="{Binding ClearOutputCommand}"/>
   </MenuItem>
   <MenuItem Header="帮助">
    <MenuItem Header="关于 GenaralDBTools" Command="{Binding ShowAboutCommand}"/>
   </MenuItem>
  </Menu>

  <!-- 工具栏 -->
  <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
   BorderThickness="0,1,0,1" Padding="8,4">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="数据库" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <ComboBox Width="230" Height="28" FontSize="12.5"
      ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
      DisplayMemberPath="Name" ToolTip="选择当前操作的数据库连接"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="＋ 新建连接" Style="{StaticResource GhostButton}" Height="28" FontSize="12.5"
      Command="{Binding AddConnectionCommand}" ToolTip="创建新的连接配置"/>
     <Button Content="打开连接" Style="{StaticResource GhostButton}" Height="28" FontSize="12.5"
      Command="{Binding OpenConnectionCommand}" Margin="2,0,0,0"/>
     <Button Content="断开" Style="{StaticResource GhostButton}" Height="28" FontSize="12.5"
      Command="{Binding DisconnectCommand}" Margin="2,0,0,0"/>
     <Button Content="刷新对象" Style="{StaticResource GhostButton}" Height="28" FontSize="12.5"
      Command="{Binding RefreshObjectsCommand}" Margin="2,0,0,0"/>
     <Border Width="1" Background="{StaticResource BorderBrushSoft}" Margin="8,3"/>
     <Button Content="新建 SQL" Style="{StaticResource GhostButton}" Height="28" FontSize="12.5"
      Command="{Binding NewSqlTabCommand}"/>
     <Button Content="▶ 执行 SQL" Style="{StaticResource PrimaryButton}" Height="28" MinWidth="90"
      FontSize="12.5" Margin="4,0,0,0" Command="{Binding ExecuteSqlCommand}"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- 主工作区：左侧连接与对象 + 右侧标签工作区 -->
  <Grid Grid.Row="2" Margin="10,8,10,8">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="266" MinWidth="220"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="*" MinWidth="500"/>
   </Grid.ColumnDefinitions>

   <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="＋ 新建" Style="{StaticResource GhostButton}" FontSize="12"
        Height="24" Padding="6,0" Command="{Binding AddConnectionCommand}"/>
       <TextBlock Text="连接与对象" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
        VerticalAlignment="Center"/>
      </DockPanel>
     </Border>

     <TreeView x:Name="ConnectionTree" Grid.Row="1" Margin="4,4,4,4" ItemsSource="{Binding Connections}"
      SelectedItemChanged="ConnectionTree_SelectedItemChanged" MouseDoubleClick="ConnectionTree_MouseDoubleClick">
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type models:DatabaseNode}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding LoadError}">
         <TextBlock Text="{Binding Icon}" Width="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
         <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="9" Margin="5,0,0,0"
          VerticalAlignment="Center" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
         <TextBlock Text="…" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
       </HierarchicalDataTemplate>
      </TreeView.Resources>
     </TreeView>

     <Border Grid.Row="2" Padding="10,6" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
      <TextBlock Text="双击连接打开对象；双击表/视图浏览数据；双击 Redis key 查看详情。"
       Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"/>
     </Border>
    </Grid>
   </Border>

   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"/>

   <Grid Grid.Column="2">
    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
     <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
         <Button Content="✕" Width="18" Height="18" MinWidth="18" Padding="0" Margin="6,0,0,0"
          Style="{StaticResource GhostButton}" FontSize="10" Foreground="{StaticResource MutedBrush}"
          Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
          CommandParameter="{Binding}" ToolTip="关闭标签页"/>
        </StackPanel>
       </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
       <DataTemplate>
        <ContentControl Content="{Binding}"/>
       </DataTemplate>
      </TabControl.ContentTemplate>
     </TabControl>
    </Border>

    <Border Background="{StaticResource SurfaceBrush}"
     Visibility="{Binding HasTabs, Converter={StaticResource InverseBoolToVisibility}}">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="◫" FontSize="48" Foreground="#FFCBD5E1" HorizontalAlignment="Center"/>
      <TextBlock Text="选择左侧的表或视图打开数据浏览，或新建 SQL 编辑器" FontSize="13"
       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
       <Button Content="新建 SQL 编辑器" Command="{Binding NewSqlTabCommand}" Style="{StaticResource PrimaryButton}"
        MinWidth="120" Margin="0,0,8,0"/>
       <Button Content="刷新连接列表" Command="{Binding RefreshConnectionsCommand}" MinWidth="110"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>

  <!-- 状态栏 -->
  <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
   BorderThickness="0,1,0,0" Padding="12,4">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ProgressBar Width="80" Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
      Background="#FFE2E8F0" BorderThickness="0" Margin="0,0,10,0"
      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
     <TextBlock Text="{Binding ConnectionSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="12"
      TextTrimming="CharacterEllipsis" MaxWidth="760"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
