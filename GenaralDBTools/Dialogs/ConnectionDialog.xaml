<Window x:Class="GenaralDBTools.Dialogs.ConnectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="数据库连接配置" Width="660" Height="760" MinWidth="560" MinHeight="620"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0" Margin="0,0,0,16">
   <TextBlock Text="连接设置" FontSize="23" FontWeight="SemiBold" Foreground="#FF1F2937"/>
   <TextBlock Text="选择数据库类型并填写连接参数。密码使用当前 Windows 用户凭据加密后保存在本机。"
    Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="18">
     <StackPanel>
      <TextBlock Text="连接名称" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="NameBox" Text="新建连接"/>

      <TextBlock Text="数据库类型" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="KindBox" DisplayMemberPath="DisplayName" SelectionChanged="KindBox_SelectionChanged"/>

      <Grid x:Name="NetworkPanel" Margin="0,0,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="120"/>
       </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0">
        <TextBlock Text="主机地址" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="HostBox" Text="localhost"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PortBox"/>
       </StackPanel>
      </Grid>

      <TextBlock x:Name="DatabaseLabel" Text="数据库名称" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="DatabaseBox"/>

      <TextBlock x:Name="UserLabel" Text="用户名" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="UserBox"/>
      <TextBlock x:Name="UserHint" Text="Redis ACL 用户名可选；未启用 ACL 时留空，仅填写密码。"
       Foreground="#FF94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>

      <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="PasswordBox"/>

      <TextBlock x:Name="FileLabel" Text="SQLite 数据库文件" Style="{StaticResource FieldLabel}"/>
      <Grid x:Name="FilePanel">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBox x:Name="FileBox" Grid.Column="0"/>
       <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Click="Browse_Click" Margin="8,0,0,0"/>
      </Grid>

      <CheckBox x:Name="SslBox" Content="启用 SSL / TLS" Margin="0,12,0,2"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="HintText" Foreground="#FF64748B" TextWrapping="Wrap" Margin="4,12,4,0"/>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="2" Margin="0,16,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock x:Name="TestResult" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
    Foreground="#FF64748B" Margin="0,0,16,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="TestButton" Content="测试连接" MinWidth="96" Style="{StaticResource SecondaryButton}" Click="Test_Click" Margin="0,0,8,0"/>
    <Button Content="取消" MinWidth="88" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
    <Button Content="保存连接" MinWidth="108" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
