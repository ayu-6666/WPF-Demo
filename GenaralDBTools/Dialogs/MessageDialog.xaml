<Window x:Class="GenaralDBTools.Dialogs.MessageDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="提示" Width="540" SizeToContent="Height" MaxHeight="640"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="24,22,24,18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Orientation="Horizontal">
   <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" Background="#FF2563EB" VerticalAlignment="Top">
    <TextBlock x:Name="IconText" Text="i" Foreground="White" FontSize="18" FontWeight="Bold"
     HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <TextBlock x:Name="TitleText" Margin="12,0,0,0" FontSize="17" FontWeight="SemiBold"
    Foreground="#FF1F2937" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBlock x:Name="MessageText" Grid.Row="1" Margin="46,10,0,4" Foreground="#FF475569"
   TextWrapping="Wrap" LineHeight="20"/>
  <Expander x:Name="DetailExpander" Grid.Row="2" Header="技术详情" Margin="46,10,0,0" Foreground="#FF64748B">
   <TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" MaxHeight="220" Height="160"
    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas"
    FontSize="12" Margin="0,6,0,0" TextWrapping="NoWrap"/>
  </Expander>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
   <Button x:Name="CancelButton" Content="取消" MinWidth="88" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="确定" MinWidth="88" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" Margin="0,0,8,0"/>
   <Button x:Name="OkButton" Content="确定" MinWidth="88" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
  </StackPanel>
 </Grid>
</Window>
