<Window x:Class="GenaralDBTools.Dialogs.RowEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑记录" Width="760" Height="640" MinWidth="620" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <TextBlock x:Name="CaptionText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2937"/>
  <TextBlock Grid.Row="1" x:Name="HintText" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,6,0,12"/>

  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="6">
   <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
    CanUserReorderColumns="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="38"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE8EDF3" Background="Transparent" BorderThickness="0">
    <DataGrid.Columns>
     <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="170" IsReadOnly="True"/>
     <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="150" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="NULL" Width="64">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <CheckBox IsChecked="{Binding IsNull, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         IsEnabled="{Binding CanSetNull}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="值" Width="*">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent" Padding="4,2"
         VerticalContentAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>

  <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#FFDC2626" TextWrapping="Wrap" Margin="2,10,2,0"/>

  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" MinWidth="88" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="保存" MinWidth="88" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
