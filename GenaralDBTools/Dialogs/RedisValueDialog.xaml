<Window x:Class="GenaralDBTools.Dialogs.RedisValueDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Redis Key" Width="680" Height="640" MinWidth="560" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <TextBlock x:Name="CaptionText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2937"/>
  <TextBlock x:Name="HintText" Grid.Row="1" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,6,0,14"/>

  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="20"/>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="130"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="Key" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF475569"/>
   <TextBox x:Name="KeyBox" Grid.Column="1"/>
   <TextBlock Text="类型" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF475569"/>
   <ComboBox x:Name="TypeBox" Grid.Column="4"/>
  </Grid>

  <Grid Grid.Row="3" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="TTL（秒）" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF475569"/>
   <TextBox x:Name="TtlBox" Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left" MinWidth="140"
    ToolTip="留空或 0 表示不设置过期时间"/>
  </Grid>

  <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
   <TextBox x:Name="ValueBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
    FontFamily="Cascadia Code,Consolas" FontSize="13" Padding="12"/>
  </Border>

  <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#FFDC2626" TextWrapping="Wrap" Margin="2,10,2,0"/>

  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" MinWidth="88" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="保存" MinWidth="88" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
