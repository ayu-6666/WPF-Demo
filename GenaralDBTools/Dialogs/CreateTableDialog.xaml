<Window x:Class="GenaralDBTools.Dialogs.CreateTableDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="新建表" Width="840" Height="620" MinWidth="700" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
   <TextBlock Text="新建表" FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2937"/>
   <TextBlock x:Name="KindText" Foreground="#FF64748B" Margin="0,4,0,14"/>
  </StackPanel>

  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="表名" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#FF475569"/>
   <TextBox x:Name="TableNameBox" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"/>
  </Grid>

  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
   <TextBlock Text="字段定义" FontWeight="SemiBold" Foreground="#FF475569" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Button Content="+ 添加列" Style="{StaticResource SecondaryButton}" Click="AddColumn_Click" Margin="0,0,8,0"/>
   <Button Content="删除选中列" Style="{StaticResource SecondaryButton}" Click="RemoveColumn_Click"/>
   <TextBlock Text="自增列需同时为主键；默认值请填写 SQL 表达式，如 0 或 'abc'。" Foreground="#FF94A3B8"
    VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
  </StackPanel>

  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="6">
   <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
    SelectionMode="Single" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="Horizontal"
    HorizontalGridLinesBrush="#FFE8EDF3" Background="Transparent" BorderThickness="0">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="字段名" Width="170">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         BorderThickness="0" Background="Transparent" Padding="4,2" VerticalContentAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="类型" Width="190">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <ComboBox IsEditable="True" MinWidth="150" Margin="2"
         ItemsSource="{Binding Types, RelativeSource={RelativeSource AncestorType=Window}}"
         Text="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="主键" Width="70">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <CheckBox IsChecked="{Binding IsPrimaryKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="可空" Width="70">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <CheckBox IsChecked="{Binding IsNullable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="自增" Width="70">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <CheckBox IsChecked="{Binding IsAutoIncrement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTemplateColumn Header="默认值" Width="*">
      <DataGridTemplateColumn.CellTemplate>
       <DataTemplate>
        <TextBox Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         BorderThickness="0" Background="Transparent" Padding="4,2" VerticalContentAlignment="Center"/>
       </DataTemplate>
      </DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>

  <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#FFDC2626" TextWrapping="Wrap" Margin="2,10,2,0"/>

  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="取消" MinWidth="88" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="创建表" MinWidth="96" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
