<Window x:Class="Radae3DDemo3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Radae3DDemo3"
        xmlns:converters="clr-namespace:Radae3DDemo3.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="雷达目标探测系统" 
        Height="850" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"/>
        <converters:KmToPixelConverter x:Key="KmToPixelConverter"/>
        <converters:ScanAngleToPathConverter x:Key="ScanAngleToPathConverter"/>
    </Window.Resources>
    <Border Background="#282828">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧雷达显示区域 -->
            <Border Background="Black">
                <Canvas x:Name="RadarCanvas" Width="800" Height="800" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 100公里同心圆网格（每10公里一个圈） -->
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="80" Height="80" Canvas.Left="360" Canvas.Top="360"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="160" Height="160" Canvas.Left="320" Canvas.Top="320"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="240" Height="240" Canvas.Left="280" Canvas.Top="280"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="320" Height="320" Canvas.Left="240" Canvas.Top="240"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="400" Height="400" Canvas.Left="200" Canvas.Top="200"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="480" Height="480" Canvas.Left="160" Canvas.Top="160"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="560" Height="560" Canvas.Left="120" Canvas.Top="120"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="640" Height="640" Canvas.Left="80" Canvas.Top="80"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="720" Height="720" Canvas.Left="40" Canvas.Top="40"/>
                    <Ellipse Stroke="DarkGreen" StrokeThickness="1" Width="800" Height="800" Canvas.Left="0" Canvas.Top="0"/>

                    <!-- 距离刻度标注 -->
                    <TextBlock Text="10km" Canvas.Left="420" Canvas.Top="395" Foreground="DarkGreen"/>
                    <TextBlock Text="20km" Canvas.Left="440" Canvas.Top="395" Foreground="DarkGreen"/>
                    <TextBlock Text="30km" Canvas.Left="460" Canvas.Top="380" Foreground="DarkGreen"/>
                    <TextBlock Text="40km" Canvas.Left="480" Canvas.Top="370" Foreground="DarkGreen"/>
                    <TextBlock Text="50km" Canvas.Left="500" Canvas.Top="355" Foreground="DarkGreen"/>
                    <TextBlock Text="60km" Canvas.Left="515" Canvas.Top="335" Foreground="DarkGreen"/>
                    <TextBlock Text="70km" Canvas.Left="530" Canvas.Top="315" Foreground="DarkGreen"/>
                    <TextBlock Text="80km" Canvas.Left="540" Canvas.Top="290" Foreground="DarkGreen"/>
                    <TextBlock Text="90km" Canvas.Left="550" Canvas.Top="265" Foreground="DarkGreen"/>
                    <TextBlock Text="100km" Canvas.Left="555" Canvas.Top="235" Foreground="DarkGreen"/>

                    <!-- 方位角刻度 -->
                    <Line X1="400" Y1="400" X2="400" Y2="0" Stroke="DarkGreen" StrokeThickness="1"/>
                    <TextBlock Text="N" Canvas.Left="395" Canvas.Top="10" Foreground="White" FontWeight="Bold" FontSize="14"/>

                    <Line X1="400" Y1="400" X2="800" Y2="400" Stroke="DarkGreen" StrokeThickness="1"/>
                    <TextBlock Text="E" Canvas.Left="780" Canvas.Top="395" Foreground="White" FontWeight="Bold" FontSize="14"/>

                    <Line X1="400" Y1="400" X2="400" Y2="800" Stroke="DarkGreen" StrokeThickness="1"/>
                    <TextBlock Text="S" Canvas.Left="395" Canvas.Top="780" Foreground="White" FontWeight="Bold" FontSize="14"/>

                    <Line X1="400" Y1="400" X2="0" Y2="400" Stroke="DarkGreen" StrokeThickness="1"/>
                    <TextBlock Text="W" Canvas.Left="10" Canvas.Top="395" Foreground="White" FontWeight="Bold" FontSize="14"/>

                    <!-- 扫描尾迹（30度余晖） -->
                    <Path Stroke="LightGreen" StrokeThickness="1" Fill="LightGreen" Opacity="0.3">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource ScanAngleToPathConverter}">
                                <Binding Path="ScanAngle"/>
                                <Binding Path="RadarRange" Converter="{StaticResource KmToPixelConverter}"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>

                    <!-- 扫描线 -->
                    <Line X1="400" Y1="400" X2="400" Y2="0" Stroke="Red" StrokeThickness="2">
                        <Line.RenderTransform>
                            <RotateTransform Angle="{Binding ScanAngle}" CenterX="400" CenterY="400"/>
                        </Line.RenderTransform>
                    </Line>

                    <!-- 雷达中心点 -->
                    <Ellipse Width="10" Height="10" Fill="Red" Canvas.Left="395" Canvas.Top="395"/>

                    <!-- 目标列表 -->
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="Target_MouseLeftButtonUp"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" 
                                 Fill="{Binding IsDetected, Converter={StaticResource BoolToBrushConverter}}" 
                                 Stroke="White" StrokeThickness="1">
                                    <Ellipse.ToolTip>
                                        <StackPanel Background="Black" Opacity="0.9">
                                            <TextBlock Text="目标信息" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="ID: " Foreground="White"/>
                                            <TextBlock Text="{Binding Id}" Foreground="Yellow"/>
                                            <TextBlock Text="距离: " Foreground="White"/>
                                            <TextBlock Text="{Binding Distance, StringFormat={}{0}km}" Foreground="Yellow"/>
                                            <TextBlock Text="方位: " Foreground="White"/>
                                            <TextBlock Text="{Binding Azimuth, StringFormat={}{0}°}" Foreground="Yellow"/>
                                            <TextBlock Text="速度: " Foreground="White"/>
                                            <TextBlock Text="{Binding Speed, StringFormat={}{0}km/h}" Foreground="Yellow"/>
                                            <TextBlock Text="高度: " Foreground="White"/>
                                            <TextBlock Text="{Binding Altitude, StringFormat={}{0}m}" Foreground="Yellow"/>
                                        </StackPanel>
                                    </Ellipse.ToolTip>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>
            <!-- 右侧控制面板 -->
            <StackPanel Margin="10" VerticalAlignment="Top" Grid.Column="1">
                <TextBlock Text="雷达控制面板" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Separator Margin="0,10" Background="DarkGray"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="开始扫描" Command="{Binding StartScanCommand}" 
                        IsEnabled="{Binding IsScanning, Converter={StaticResource BoolToInverseBoolConverter}}" Margin="5" Padding="10,5"/>
                    <Button Content="停止扫描" Command="{Binding StopScanCommand}" 
                        IsEnabled="{Binding IsScanning}" Margin="5" Padding="10,5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Button Content="生成目标" Command="{Binding GenerateTargetsCommand}" Margin="5" Padding="10,5"/>
                    <Button Content="清除目标" Command="{Binding ClearTargetsCommand}" Margin="5" Padding="10,5"/>
                </StackPanel>

                <Separator Margin="0,20" Background="DarkGray"/>
                <TextBlock Text="目标详情" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                <StackPanel DataContext="{Binding SelectedTarget}" Margin="0,10">
                    <TextBlock Text="未选中目标" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20"/>
                    <TextBlock Text="目标ID: " Foreground="White"/>
                    <TextBlock Text="{Binding Id}" Foreground="Yellow" FontWeight="Bold"/>
                    <TextBlock Text="探测距离: " Foreground="White"/>
                    <TextBlock Text="{Binding Distance, StringFormat={}{0} 公里}" Foreground="Yellow" FontWeight="Bold"/>
                    <TextBlock Text="方位角: " Foreground="White"/>
                    <TextBlock Text="{Binding Azimuth, StringFormat={}{0}°}" Foreground="Yellow" FontWeight="Bold"/>
                    <TextBlock Text="飞行速度: " Foreground="White"/>
                    <TextBlock Text="{Binding Speed, StringFormat={}{0} 公里/小时}" Foreground="Yellow" FontWeight="Bold"/>
                    <TextBlock Text="飞行高度: " Foreground="White"/>
                    <TextBlock Text="{Binding Altitude, StringFormat={}{0} 米}" Foreground="Yellow" FontWeight="Bold"/>
                    <TextBlock Text="探测状态: " Foreground="White"/>
                    <TextBlock Text="{Binding IsDetected, Converter={StaticResource BoolToTextConverter}}" 
                           Foreground="{Binding IsDetected, Converter={StaticResource BoolToBrushConverter}}" FontWeight="Bold"/>
                    <TextBlock Text="最后探测时间: " Foreground="White"/>
                    <TextBlock Text="{Binding LastDetectedTime, StringFormat={}{0:HH:mm:ss}}" Foreground="Yellow" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
