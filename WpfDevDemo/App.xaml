<Application x:Class="WpfDevDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WPFDevelopers;component/Themes/Theme.xaml" />
                <!-- wd:Resources 必须在 Theme.xaml 之后 -->
                <wd:Resources Radius="4" />
                <ResourceDictionary Source="pack://application:,,,/WpfDevDemo;component/Controls/CodeViewer/CodeViewer.xaml" />
                <ResourceDictionary Source="pack://application:,,,/WpfDevDemo;component/Controls/NavigateMenu/NavigateMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
