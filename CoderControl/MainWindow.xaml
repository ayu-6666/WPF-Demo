<Window x:Class="CoderControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoderControl"
        xmlns:controls="clr-namespace:CoderControl.Views"
        xmlns:models="clr-namespace:CoderControl.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="CoderControl - 代码查看器"
        Height="820" Width="1280" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#1E1E1E"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#1E1E1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（拖动、双击最大化由 WindowChrome 原生处理） ===== -->
            <Border Grid.Row="0" Background="{StaticResource BgChrome}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#4EC9B0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WindowTitleText" Text="CoderControl - 代码查看器"
                                   FontSize="12" Foreground="#C8C8C8" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Content="&#xE921;" Click="MinimizeButton_Click"
                                ToolTip="最小化" AutomationProperties.Name="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Content="&#xE922;" Click="MaximizeButton_Click"
                                ToolTip="最大化" AutomationProperties.Name="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButtonStyle}"
                                Content="&#xE8BB;" Click="CloseButton_Click"
                                ToolTip="关闭" AutomationProperties.Name="关闭窗口"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 菜单栏 ===== -->
            <Border Grid.Row="1" Background="{StaticResource BgChrome}">
                <Menu x:Name="MainMenu" Background="Transparent" Padding="6,0"
                      VerticalContentAlignment="Center">
                    <Menu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}"/>
                        <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparatorStyle}"/>
                    </Menu.Resources>

                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="新建文件" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
                        <MenuItem Header="打开文件..." InputGestureText="Ctrl+O" Click="OpenFile_Click"/>
                        <MenuItem Header="重新加载当前文件" InputGestureText="F5" Click="ReloadFile_Click"/>
                        <Separator/>
                        <MenuItem Header="关闭标签" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                        <MenuItem Header="关闭所有标签" Click="CloseAllTabs_Click"/>
                        <Separator/>
                        <MenuItem Header="退出" InputGestureText="Alt+F4" Click="Exit_Click"/>
                    </MenuItem>

                    <MenuItem Header="编辑(_E)">
                        <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                        <MenuItem Header="重做" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                        <Separator/>
                        <MenuItem Header="剪切" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                        <MenuItem Header="复制" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                        <MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                        <Separator/>
                        <MenuItem Header="全选" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                    </MenuItem>

                    <MenuItem Header="搜索(_S)">
                        <MenuItem Header="查找" InputGestureText="Ctrl+F" Click="Find_Click"/>
                        <MenuItem Header="查找下一个" InputGestureText="F3" Click="FindNext_Click"/>
                        <MenuItem Header="查找上一个" InputGestureText="Shift+F3" Click="FindPrev_Click"/>
                        <Separator/>
                        <MenuItem Header="复制当前文件路径" Click="CopyPath_Click"/>
                    </MenuItem>

                    <MenuItem Header="视图(_V)">
                        <MenuItem x:Name="ExplorerMenuItem" Header="解决方案资源管理器"
                                  InputGestureText="Ctrl+Alt+L" IsCheckable="True" IsChecked="True"
                                  Click="ToggleExplorer_Click"/>
                        <Separator/>
                        <MenuItem Header="全部展开" Click="ExpandAll_Click"/>
                        <MenuItem Header="全部折叠" Click="CollapseAll_Click"/>
                        <Separator/>
                        <MenuItem Header="增大字号" InputGestureText="Ctrl+=" Click="ZoomIn_Click"/>
                        <MenuItem Header="减小字号" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                        <MenuItem Header="重置字号" Click="ZoomReset_Click"/>
                    </MenuItem>

                    <MenuItem Header="编码(_N)">
                        <MenuItem Header="以 UTF-8 重新加载" Click="ReloadUtf8_Click"/>
                        <MenuItem Header="以 GBK 重新加载" Click="ReloadGbk_Click"/>
                    </MenuItem>

                    <MenuItem Header="语言(_L)">
                        <MenuItem Header="自动识别" Click="LanguageAuto_Click"/>
                        <Separator/>
                        <MenuItem Header="C#" Click="LanguageCSharp_Click"/>
                        <MenuItem Header="XAML / XML" Click="LanguageXml_Click"/>
                        <MenuItem Header="JavaScript" Click="LanguageJs_Click"/>
                        <MenuItem Header="纯文本" Click="LanguageText_Click"/>
                    </MenuItem>

                    <MenuItem Header="设置(_T)">
                        <MenuItem x:Name="WordWrapMenuItem" Header="自动换行" IsCheckable="True" IsChecked="True"
                                  Click="WordWrap_Click"/>
                        <MenuItem x:Name="LineNumbersMenuItem" Header="显示行号" IsCheckable="True" IsChecked="True"
                                  Click="LineNumbers_Click"/>
                        <Separator/>
                        <MenuItem Header="字体大小">
                            <MenuItem Header="12" Tag="12" Click="FontSize_Click"/>
                            <MenuItem Header="14" Tag="14" Click="FontSize_Click"/>
                            <MenuItem Header="16" Tag="16" Click="FontSize_Click"/>
                            <MenuItem Header="18" Tag="18" Click="FontSize_Click"/>
                            <MenuItem Header="20" Tag="20" Click="FontSize_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="工具(_O)">
                        <MenuItem Header="格式化 C# 代码" Click="Format_Click"/>
                        <MenuItem Header="去除行尾空格" Click="TrimTrailing_Click"/>
                        <Separator/>
                        <MenuItem Header="打开模块目录" Click="OpenModuleDir_Click"/>
                    </MenuItem>

                    <MenuItem Header="宏(_M)">
                        <MenuItem Header="一键格式化" Click="Format_Click"/>
                        <MenuItem Header="删除所有空行" Click="RemoveEmptyLines_Click"/>
                    </MenuItem>

                    <MenuItem Header="运行(_R)">
                        <MenuItem Header="运行示例页面" InputGestureText="F6" Click="RunSample_Click"/>
                        <MenuItem Header="重新加载当前文件" InputGestureText="F5" Click="ReloadFile_Click"/>
                    </MenuItem>

                    <MenuItem Header="插件(_P)">
                        <MenuItem Header="源码统计" Click="Statistics_Click"/>
                        <MenuItem Header="复制文件路径" Click="CopyPath_Click"/>
                    </MenuItem>

                    <MenuItem Header="窗口(_W)">
                        <MenuItem Header="最小化" Click="MinimizeButton_Click"/>
                        <MenuItem x:Name="MaximizeRestoreMenuItem" Header="最大化窗口" Click="MaximizeButton_Click"/>
                        <Separator/>
                        <MenuItem Header="关闭窗口" InputGestureText="Alt+F4" Click="CloseButton_Click"/>
                    </MenuItem>

                    <MenuItem Header="帮助(_H)">
                        <MenuItem Header="关于 CoderControl" Click="About_Click"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- ===== 工具栏 ===== -->
            <Border Grid.Row="2" Background="{StaticResource BgChrome}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button Style="{StaticResource IconButtonStyle}" Click="NewFile_Click" ToolTip="新建文件 (Ctrl+N)" AutomationProperties.Name="新建文件">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OpenFile_Click" ToolTip="打开文件 (Ctrl+O)" AutomationProperties.Name="打开文件">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="ReloadFile_Click" ToolTip="重新加载 (F5)" AutomationProperties.Name="重新加载">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Border Width="1" Height="16" Background="#3F3F46" Margin="6,0"/>
                    <Button Style="{StaticResource IconButtonStyle}" Click="CloseTab_Click" ToolTip="关闭当前标签 (Ctrl+W)" AutomationProperties.Name="关闭当前标签">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="CloseAllTabs_Click" ToolTip="关闭所有标签" AutomationProperties.Name="关闭所有标签">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Border Width="1" Height="16" Background="#3F3F46" Margin="6,0"/>
                    <Button Style="{StaticResource IconButtonStyle}" Click="Find_Click" ToolTip="查找 (Ctrl+F)" AutomationProperties.Name="查找">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="RunSample_Click" ToolTip="运行示例页面 (F6)" AutomationProperties.Name="运行示例页面">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Border Width="1" Height="16" Background="#3F3F46" Margin="6,0"/>
                    <Button Style="{StaticResource IconButtonStyle}" Click="About_Click" ToolTip="关于" AutomationProperties.Name="关于">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== 主内容：左侧文件树 + 右侧标签文档区 ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExplorerColumn" Width="300" MinWidth="200"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:SolutionExplorer x:Name="Explorer" Grid.Column="0"/>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderLine}"
                        HorizontalAlignment="Center" IsHitTestVisible="False"/>
                <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              Background="Transparent"/>

                <controls:CodeViewer x:Name="Viewer" Grid.Column="2">
                    <controls:CodeViewer.SourceCodes>
                        <models:SourceCodeModel CodeSource="/Views/BreatheLightExample.xaml" CodeType="Xaml"/>
                        <models:SourceCodeModel CodeSource="/Views/BreatheLightExample.xaml.cs" CodeType="CSharp"/>
                        <models:SourceCodeModel CodeSource="/Views/BreatheLightExample.xaml" CodeType="Sample"/>
                    </controls:CodeViewer.SourceCodes>
                </controls:CodeViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
