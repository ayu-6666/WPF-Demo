<Window x:Class="CoderControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoderControl"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:CoderControl.Views"
        xmlns:models="clr-namespace:CoderControl.Models"
        Title="BreatheLight" Height="800" Width="1100" Background="#1E1E1E">
    <Grid>
        <controls:CodeViewer>
            <controls:CodeViewer.SourceCodes>
                <models:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/Views/BreatheLightExample.xaml" CodeType="Xaml"/>
                <models:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/Views/BreatheLightExample.xaml.cs" CodeType="CSharp"/>
                <models:SourceCodeModel CodeSource="Sample" CodeType="Sample"/>
            </controls:CodeViewer.SourceCodes>
        </controls:CodeViewer>
    </Grid>
</Window>
