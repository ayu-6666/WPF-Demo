<UserControl x:Class="CoderControl.Views.CodeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CoderControl.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1E1E1E">
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <TabControl x:Name="MainTab"
                    Background="#252526"
                    BorderThickness="0"
                    Padding="0"
                    ItemContainerStyle="{StaticResource DocumentTabItemStyle}"
                    ItemsSource="{Binding Documents, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    SelectionChanged="MainTab_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="34" Margin="14,0,10,0" ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Header}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource TabCloseButtonStyle}"
                                Content="&#xE711;"
                                Margin="10,0,0,0"
                                Click="CloseTab_Click"
                                ToolTip="关闭标签"
                                AutomationProperties.Name="关闭标签"/>
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding Content}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- 所有标签关闭后的空状态 -->
        <Grid x:Name="EmptyState" Background="#1E1E1E" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                           Foreground="#3C3C3F" HorizontalAlignment="Center"/>
                <TextBlock Text="没有打开的文档" FontSize="16" Foreground="#9A9A9A"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="从左侧解决方案资源管理器中选择文件，或按 Ctrl+N 新建"
                           FontSize="12" Foreground="#6E6E6E"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
