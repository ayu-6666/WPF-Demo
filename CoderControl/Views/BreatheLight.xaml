<UserControl x:Class="CoderControl.Views.BreatheLight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CoderControl.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Width="60" Height="60">
        <!-- 呼吸灯发光层 -->
        <Ellipse x:Name="GlowEllipse" Width="60" Height="60" Fill="Transparent">
            <Ellipse.Effect>
                <DropShadowEffect x:Name="GlowEffect" Color="#FF4081" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" From="10" To="30" Duration="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1.5"/>
                            <ColorAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Color" From="#FF4081" To="#00E5FF" Duration="0:0:3" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- 头像层 -->
        <Ellipse Width="50" Height="50" Margin="5">
            <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding ImageSource}" Stretch="UniformToFill"/>
            </Ellipse.Fill>
            <!-- 可以加一圈白色边框让层次更清晰 -->
            <Ellipse.Stroke>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </Ellipse.Stroke>
            <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
        </Ellipse>
    </Grid>
</UserControl>
