<UserControl x:Class="CoderControl.Views.BreatheLightExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CoderControl.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:controls="clr-namespace:CoderControl.Views"
             Background="White">
    <Grid Margin="40">
        <ItemsControl x:Name="ItemsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="400" Height="140" Background="#FAFAFA" CornerRadius="8" Margin="10"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 呼吸灯头像 -->
                            <controls:BreatheLight Grid.Column="0" DataContext="{Binding}" VerticalAlignment="Center"/>

                            <!-- 标题和状态 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="{Binding Status}" FontSize="14" Foreground="#4CAF50" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 进入直播按钮 -->
                            <Button Content="进入直播" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                    Background="#2196F3" Foreground="White" BorderThickness="0" Padding="10,5" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
