<UserControl x:Class="CoderControl.Views.SolutionExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="280">
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
        <Style x:Key="NodeNameStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面板标题 -->
        <Border Grid.Row="0" Background="{StaticResource BgChrome}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <TextBlock Text="解决方案资源管理器" FontSize="12" FontWeight="SemiBold"
                           Foreground="#DDDDDD" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CollapseAllButton" Style="{StaticResource IconButtonStyle}"
                            Width="24" Height="22" Click="CollapseAllButton_Click" ToolTip="全部折叠"
                            AutomationProperties.Name="全部折叠">
                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}"
                            Width="24" Height="22" Click="RefreshButton_Click" ToolTip="刷新"
                            AutomationProperties.Name="刷新解决方案">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件树 -->
        <TreeView x:Name="FileTree" Grid.Row="1"
                  Background="Transparent" BorderThickness="0"
                  Padding="4,4,2,6"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewMouseLeftButtonDown="FileTree_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="FileTree_PreviewMouseLeftButtonUp"
                  SelectedItemChanged="FileTree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource DarkTreeViewItemStyle}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Height="23" ToolTip="{Binding FullPath}">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{Binding IconBrush}"
                                   Width="16" TextAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource NodeNameStyle}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
