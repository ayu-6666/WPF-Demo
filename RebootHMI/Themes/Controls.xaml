<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:RebootHMI.Controls"
                    xmlns:conv="clr-namespace:RebootHMI.Core"
                    xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <!-- ================= 转换器 ================= -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:EqToVisibilityConverter x:Key="EqToVis" />
    <conv:EqToBoolConverter x:Key="EqToBool" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:NullToCollapsedConverter x:Key="NullToVis" />
    <conv:StartsWithToBoolConverter x:Key="StartsWithBool" />
    <conv:TitleIconVisibilityConverter x:Key="TitleIconVis" />

    <!-- ================= 基础文字 ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= SciCard 科技卡片 ================= -->
    <Style TargetType="{x:Type ctl:SciCard}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SciCard}">
                    <Grid>
                        <Border x:Name="CardBorder"
                                CornerRadius="{TemplateBinding CornerRadiusValue}"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.5" />
                        <!-- 四角折线 -->
                        <Path Width="26" Height="26" Margin="7"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Data="M2,15 L2,6 Q2,2 6,2 L15,2"
                              Stroke="#62D8FF" StrokeThickness="2" Stretch="None" />
                        <Path Width="26" Height="26" Margin="7"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Data="M2,15 L2,6 Q2,2 6,2 L15,2"
                              Stroke="#62D8FF" StrokeThickness="2" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                        </Path>
                        <Path Width="26" Height="26" Margin="7"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Data="M2,15 L2,6 Q2,2 6,2 L15,2"
                              Stroke="#62D8FF" StrokeThickness="2" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
                        </Path>
                        <Path Width="26" Height="26" Margin="7"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Data="M2,15 L2,6 Q2,2 6,2 L15,2"
                              Stroke="#62D8FF" StrokeThickness="2" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
                        </Path>

                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <Grid Grid.Row="0" Height="42"
                                  Visibility="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左三点 + 斜虚线 -->
                                <Grid Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,10,0">
                                    <Path Width="64" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Data="M0,0 L64,0 L52,17 L0,17"
                                          Stroke="#2E7DB8" StrokeThickness="1.2" Stretch="Fill"
                                          StrokeDashArray="3,3" Margin="0,0,26,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#2E9BFF" />
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#2E9BFF" />
                                        <Ellipse Width="8" Height="8" Fill="#2E9BFF" />
                                    </StackPanel>
                                </Grid>

                                <!-- 标题 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <md:PackIcon Kind="{TemplateBinding TitleIcon}" Width="20" Height="20"
                                                     Foreground="#7ED9FF" Margin="0,0,8,0"
                                                     Visibility="{Binding TitleIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TitleIconVis}}" />
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="19" FontWeight="Bold"
                                                   Foreground="#F2FAFF" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Border Width="46" Height="3" HorizontalAlignment="Center" Margin="0,3,0,0"
                                            Background="{DynamicResource PrimaryButtonBrush}" CornerRadius="2" />
                                </StackPanel>

                                <!-- 右三点 + 斜虚线 -->
                                <Grid Grid.Column="2" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <Path Width="64" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M0,0 L64,0 L12,17 L64,17"
                                          Stroke="#2E7DB8" StrokeThickness="1.2" Stretch="Fill"
                                          StrokeDashArray="3,3" Margin="26,0,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#2E9BFF" />
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#2E9BFF" />
                                        <Ellipse Width="8" Height="8" Fill="#2E9BFF" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <ContentPresenter Grid.Row="1" Margin="16,4,16,16" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 蓝色主按钮 ================= -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource PrimaryButtonBrush}">
                        <Border.Effect><DropShadowEffect Color="#1E88F0" BlurRadius="14" ShadowDepth="0" Opacity="0.55" /></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 白底按钮（取盘） -->
    <Style x:Key="WhiteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="#F4F8FF" BorderBrush="#B9D2F2" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DDEAFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 蓝底按钮（送盘 / 手动读码） -->
    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="110" />
    </Style>

    <!-- ================= 胶囊开关 NeonSwitch ================= -->
    <Style x:Key="NeonSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="78" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="17" Background="#39465F" BorderBrush="#4A5A78" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="26" Height="26" HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Fill="White" VerticalAlignment="Center">
                            <Ellipse.Effect><DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="1" Opacity="0.5" /></Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#5FC0FF" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= IO 圆形信号灯 IoLamp ================= -->
    <Style x:Key="IoLamp" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="24" Height="24" Margin="0,0,8,0">
                            <Ellipse x:Name="Ring" Width="23" Height="23" Stroke="#7FA3CC" StrokeThickness="1.6" Fill="#0D1E3C" />
                            <Ellipse x:Name="Dot" Width="11" Height="11" Fill="#2E9BFF" Visibility="Collapsed">
                                <Ellipse.Effect><DropShadowEffect Color="#2E9BFF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="#56CEFF" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= SciSlider 滑杆 ================= -->
    <Style x:Key="SciSlider" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="8" CornerRadius="4" Background="#E8EDF5" Opacity="0.92" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="8" CornerRadius="4" Background="{DynamicResource PrimaryButtonBrush}"
                                                    HorizontalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Width="20" Height="20" Fill="White" Stroke="#2E9BFF" StrokeThickness="2">
                                                <Ellipse.Effect><DropShadowEffect Color="#2E9BFF" BlurRadius="8" ShadowDepth="0" Opacity="0.7" /></Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 速度滑杆：浅青轨道 -->
    <Style x:Key="SpeedSlider" TargetType="Slider" BasedOn="{StaticResource SciSlider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#9FC9EC" Opacity="0.85" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" CornerRadius="2" Background="#BFE6FF" HorizontalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Width="18" Height="18" Fill="#DDF1FF" Stroke="#7FC4F2" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= NumberUpDown ================= -->
    <Style TargetType="{x:Type ctl:NumberUpDown}">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:NumberUpDown}">
                    <Border CornerRadius="4" Background="White" BorderBrush="#9DB8DC" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Foreground="#15294C"
                                     FontSize="15" VerticalContentAlignment="Center" Padding="6,0,0,0" />
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <RepeatButton x:Name="PART_Up" Grid.Row="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="#E3EDFA" BorderBrush="#B9CCE6" BorderThickness="0,0,1,1">
                                                <Path Data="M0,4 L5,0 L10,4 Z" Fill="#5A7299" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <RepeatButton x:Name="PART_Down" Grid.Row="1">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="#E3EDFA" BorderBrush="#B9CCE6" BorderThickness="0,0,1,0">
                                                <Path Data="M0,0 L5,4 L10,0 Z" Fill="#5A7299" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ComboBox 项（深色） ================= -->
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="12,9" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B4E9C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色下拉 -->
    <Style x:Key="SciComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="7" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1.2">
                                        <Grid>
                                            <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,12,0"
                                                  Data="M0,0 L8,0 L4,5 Z" Fill="#7FB6E8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5FC0FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,8" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1.2" CornerRadius="7">
                                <Border.Effect><DropShadowEffect Color="#000" BlurRadius="14" ShadowDepth="3" Opacity="0.6" /></Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
    </Style>

    <!-- 虚线边框下拉（报警日期） -->
    <Style x:Key="DashedComboBox" TargetType="ComboBox" BasedOn="{StaticResource SciComboBox}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- 白色下拉（料道控制） -->
    <Style x:Key="WhiteComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="42" />
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource WhiteComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="7" Background="White" BorderBrush="#B9D2F2" BorderThickness="1">
                                        <Grid>
                                            <ContentPresenter Margin="14,0,36,0" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path HorizontalAlignment="Right" Margin="0,0,14,0"
                                                  Data="M0,0 L8,0 L4,5 Z" Fill="#5A7299" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,8" Background="White" BorderBrush="#B9D2F2" BorderThickness="1" CornerRadius="7">
                                <Border.Effect><DropShadowEffect Color="#000" BlurRadius="14" ShadowDepth="3" Opacity="0.45" /></Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WhiteComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="14,10" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DDEAFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TextBox ================= -->
    <Style x:Key="SciTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="CaretBrush" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="7" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1.2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5FC0FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 白底输入（外协码） -->
    <Style x:Key="WhiteTextBox" TargetType="TextBox" BasedOn="{StaticResource SciTextBox}">
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="CaretBrush" Value="#15294C" />
    </Style>

    <!-- 登录白输入 -->
    <Style x:Key="LoginTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="58" />
        <Setter Property="Foreground" Value="#24375C" />
        <Setter Property="CaretBrush" Value="#24375C" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="9" Background="White">
                        <Border.Effect><DropShadowEffect Color="#0A2C66" BlurRadius="16" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 方形 CheckBox（自动登录） ================= -->
    <Style x:Key="SquareCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="3" Background="White" Margin="0,0,10,0">
                                            <md:PackIcon x:Name="Check" Kind="Check" Width="16" Height="16"
                                                         Foreground="#1E88F0" Visibility="Collapsed" />
                                        </Border>
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 故障查询 chip ================= -->
    <Style x:Key="KeywordChip" TargetType="Border">
        <Setter Property="Background" Value="#1B4E9C" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- ================= 左侧操作按钮 OpButton ================= -->
    <Style x:Key="OpButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="78" />
        <Setter Property="Height" Value="106" />
        <Setter Property="Margin" Value="0,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" CornerRadius="12" Background="{DynamicResource OpIdleBrush}"
                                            BorderBrush="#2A4A7F" BorderThickness="1.2">
                                        <Grid>
                                            <Border x:Name="TopBar" Width="34" Height="4" VerticalAlignment="Top" Margin="0,8,0,0"
                                                    CornerRadius="2" Background="#8FA8CC" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" HorizontalAlignment="Center"
                                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                                                <Border x:Name="IconCircle" Width="50" Height="50" CornerRadius="25"
                                                        HorizontalAlignment="Center" Background="#16294E"
                                                        BorderBrush="#34567F" BorderThickness="1.2">
                                                    <md:PackIcon x:Name="Icon" Kind="{Binding Icon}" Width="30" Height="30"
                                                                 Foreground="#C7DBF5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding State}" Value="Running" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource StartButtonBrush}" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#45E0A3" />
                            <Setter TargetName="TopBar" Property="Background" Value="#7CF5C4" />
                            <Setter TargetName="IconCircle" Property="Background" Value="#45E0A3" />
                            <Setter TargetName="IconCircle" Property="BorderBrush" Value="#7CF5C4" />
                            <Setter TargetName="Icon" Property="Foreground" Value="White" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding State}" Value="Paused" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PauseButtonBrush}" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F5B82E" />
                            <Setter TargetName="TopBar" Property="Background" Value="#FFE39A" />
                            <Setter TargetName="IconCircle" Property="Background" Value="#F5B82E" />
                            <Setter TargetName="IconCircle" Property="BorderBrush" Value="#FFE39A" />
                            <Setter TargetName="Icon" Property="Foreground" Value="#1B2A4A" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding State}" Value="EStop" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CardBorder" Property="Background" Value="#B3261E" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#FF7A7A" />
                            <Setter TargetName="TopBar" Property="Background" Value="#FF9E9E" />
                            <Setter TargetName="IconCircle" Property="Background" Value="#E0483E" />
                            <Setter TargetName="IconCircle" Property="BorderBrush" Value="#FF9E9E" />
                            <Setter TargetName="Icon" Property="Foreground" Value="White" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding State}" Value="Reset" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CardBorder" Property="Background" Value="#1268D6" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#5FC0FF" />
                            <Setter TargetName="TopBar" Property="Background" Value="#9ED8FF" />
                            <Setter TargetName="IconCircle" Property="Background" Value="#3FA9FF" />
                            <Setter TargetName="IconCircle" Property="BorderBrush" Value="#9ED8FF" />
                            <Setter TargetName="Icon" Property="Foreground" Value="White" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 底部导航按钮 BottomNav ================= -->
    <Style x:Key="BottomNavStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Gd" Background="Transparent">
                        <Border x:Name="Indicator" Height="4" VerticalAlignment="Bottom" Margin="14,-2"
                                CornerRadius="2" Background="{DynamicResource PrimaryButtonBrush}" Visibility="Collapsed" />
                        <Viewbox Width="30" Height="40">
                            <md:PackIcon x:Name="Icon" Kind="{Binding Icon}" Foreground="#93A9C9" />
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Foreground" Value="#5FD0FF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="Foreground" Value="#BFE4FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 位置参数页 Tab ================= -->
    <Style x:Key="PosTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#A9C3E4" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                                    <StackPanel VerticalAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center" />
                                        <Border x:Name="Line" Height="2" Width="46" Margin="0,8"
                                                HorizontalAlignment="Center" Background="Transparent" />
                                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#46CCFF" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="Line" Property="Background" Value="#2E9BFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
