<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:RebootHMI.Models">

    <!-- 单个 IO 信号点：名称 + 圆形信号灯 -->
    <DataTemplate DataType="{x:Type m:IoItem}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#EAF4FF"
                       MinWidth="96" VerticalAlignment="Center"
                       Visibility="{Binding Name, Converter={StaticResource StringToVis}}" />
            <ToggleButton Style="{StaticResource IoLamp}"
                         Content="{Binding Option}"
                         IsChecked="{Binding IsOn, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate>

    <!-- 一行两个信号点 -->
    <DataTemplate x:Key="IoRow2" DataType="{x:Type m:IoRow}">
        <Grid Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" Content="{Binding Left}" Margin="8,0"
                              Visibility="{Binding Left, Converter={StaticResource NullToVis}}" />
            <ContentPresenter Grid.Column="1" Content="{Binding Right}" Margin="8,0"
                              Visibility="{Binding Right, Converter={StaticResource NullToVis}}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#1C3760" />
        </Grid>
    </DataTemplate>

    <!-- 一行三个信号点 -->
    <DataTemplate x:Key="IoRow3" DataType="{x:Type m:IoRow}">
        <Grid Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" Content="{Binding Left}" Margin="8,0"
                              Visibility="{Binding Left, Converter={StaticResource NullToVis}}" />
            <ContentPresenter Grid.Column="1" Content="{Binding Middle}" Margin="8,0"
                              Visibility="{Binding Middle, Converter={StaticResource NullToVis}}" />
            <ContentPresenter Grid.Column="2" Content="{Binding Right}" Margin="8,0"
                              Visibility="{Binding Right, Converter={StaticResource NullToVis}}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#1C3760" />
        </Grid>
    </DataTemplate>

    <!-- 列间竖向 chevron 装饰 -->
    <Style x:Key="ChevronDecor" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Viewbox Width="22" Height="16">
                        <Path Data="M2,2 L11,11 L2,20" Stroke="#3E72A8" StrokeThickness="3" Stretch="None" />
                    </Viewbox>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
