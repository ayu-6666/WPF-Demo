<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 基础色板 ============ -->
    <Color x:Key="BgDeepColor">#040B1E</Color>
    <Color x:Key="BgMidColor">#0A1C42</Color>
    <Color x:Key="BgGlowColor">#163875</Color>

    <Color x:Key="CardTopColor">#12294F</Color>
    <Color x:Key="CardBottomColor">#0A1B39</Color>

    <Color x:Key="CyanColor">#46CCFF</Color>
    <Color x:Key="CyanDimColor">#2E7DB8</Color>
    <Color x:Key="BlueColor">#2E9BFF</Color>
    <Color x:Key="BlueDeepColor">#1268D6</Color>

    <Color x:Key="TextMainColor">#EAF4FF</Color>
    <Color x:Key="TextDimColor">#8FB3D9</Color>
    <Color x:Key="TextFaintColor">#5E82AC</Color>

    <Color x:Key="GreenColor">#34D399</Color>
    <Color x:Key="GreenDeepColor">#0E7A52</Color>
    <Color x:Key="YellowColor">#F5B82E</Color>
    <Color x:Key="YellowDeepColor">#9A6E00</Color>
    <Color x:Key="RedColor">#FF5252</Color>
    <Color x:Key="RedDeepColor">#B3261E</Color>

    <Color x:Key="TrackOffColor">#3A4763</Color>
    <Color x:Key="InputDarkColor">#0C1E42</Color>

    <!-- ============ 画刷 ============ -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="CyanDimBrush" Color="{StaticResource CyanDimColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="TrackOffBrush" Color="{StaticResource TrackOffColor}" />
    <SolidColorBrush x:Key="InputDarkBrush" Color="{StaticResource InputDarkColor}" />

    <!-- 全屏背景：深蓝径向渐变 -->
    <RadialGradientBrush x:Key="WindowBgBrush" GradientOrigin="0.5,0.42" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#10295C" Offset="0" />
        <GradientStop Color="#0A1C42" Offset="0.45" />
        <GradientStop Color="#050F2A" Offset="1" />
    </RadialGradientBrush>

    <!-- 卡片背景：自上而下微亮渐变 -->
    <LinearGradientBrush x:Key="CardBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#132C56" Offset="0" />
        <GradientStop Color="#0C1E40" Offset="0.55" />
        <GradientStop Color="#0A1836" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片内部小面板（更深一层） -->
    <LinearGradientBrush x:Key="PanelBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F2449" Offset="0" />
        <GradientStop Color="#0A1A38" Offset="1" />
    </LinearGradientBrush>

    <!-- 卡片青色描边 -->
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5AD4FF" Offset="0" />
        <GradientStop Color="#2E9BFF" Offset="0.5" />
        <GradientStop Color="#1C66B8" Offset="1" />
    </LinearGradientBrush>

    <!-- 主按钮蓝 -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3FA9FF" Offset="0" />
        <GradientStop Color="#1E88F0" Offset="0.5" />
        <GradientStop Color="#1268D6" Offset="1" />
    </LinearGradientBrush>

    <!-- 开始按钮绿 -->
    <LinearGradientBrush x:Key="StartButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B9E6B" Offset="0" />
        <GradientStop Color="#0E6E4B" Offset="1" />
    </LinearGradientBrush>

    <!-- 暂停按钮黄 -->
    <LinearGradientBrush x:Key="PauseButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D99A1C" Offset="0" />
        <GradientStop Color="#8A5F00" Offset="1" />
    </LinearGradientBrush>

    <!-- 普通操作按钮底 -->
    <LinearGradientBrush x:Key="OpIdleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A3160" Offset="0" />
        <GradientStop Color="#0E2148" Offset="1" />
    </LinearGradientBrush>

    <!-- 顶部标题托底 -->
    <LinearGradientBrush x:Key="TitlePlateBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#22000000" Offset="0.25" />
        <GradientStop Color="#660B3B82" Offset="0.5" />
        <GradientStop Color="#22000000" Offset="0.75" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ 星空点阵（平铺） ============ -->
    <DrawingBrush x:Key="StarBrush" Stretch="None" TileMode="Tile" Viewport="0,0,260,260" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#33FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,30" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="80,14" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="150,46" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="220,22" RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="40,90" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="120,80" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="190,110" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="250,70" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="20,150" RadiusX="1.3" RadiusY="1.3" />
                            <EllipseGeometry Center="96,140" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="170,170" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="236,150" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="60,210" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="140,224" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="208,200" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="30,244" RadiusX="0.9" RadiusY="0.9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#66BFE4FF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="120,24" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="232,118" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="44,176" RadiusX="1.4" RadiusY="1.4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
