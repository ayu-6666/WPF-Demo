<UserControl x:Class="RebootHMI.Views.PositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:ctl="clr-namespace:RebootHMI.Controls">
    <Grid Margin="14">
        <ctl:SciCard Title="缓存设置">
            <Grid Margin="10,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab 行 -->
                <Grid Grid.Row="0" Height="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="44" Height="44" Background="Transparent"
                            Cursor="Hand" Command="{Binding PrevTabCommand}">
                        <md:PackIcon Kind="ChevronLeft" Width="34" Height="34" Foreground="#9DB8DC" />
                    </Button>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource PosTab}" Content="{Binding Name}"
                                             GroupName="PosTab" HorizontalAlignment="Center"
                                             IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Width="44" Height="44" HorizontalAlignment="Right"
                            Background="Transparent" Cursor="Hand" Command="{Binding NextTabCommand}">
                        <md:PackIcon Kind="ChevronRight" Width="34" Height="34" Foreground="#9DB8DC" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" Height="1.5" Background="#2A4A7F" />

                <!-- 参数区 -->
                <Grid Grid.Row="2" Margin="10,14,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 位置设定 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="位置设定（M）" FontSize="21" FontWeight="Bold"
                                   Foreground="#D6E7FA" Margin="6,0,0,10" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                           Foreground="#EAF4FF" Width="56" />
                                                <TextBlock Text="0--136" FontSize="16" Foreground="#8FB3D9" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Run Text="{Binding Position, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#46CCFF" />
                                                <Run Text="m" FontSize="16" Foreground="#8FB3D9" />
                                            </TextBlock>
                                        </Grid>
                                        <Slider Grid.Row="1" Style="{StaticResource SciSlider}" Margin="0,10,0,0"
                                                Minimum="0" Maximum="136"
                                                Value="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 速度设定 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="速度设定（M/S）" FontSize="21" FontWeight="Bold"
                                   Foreground="#D6E7FA" Margin="6,0,0,10" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Speed, StringFormat=0.0, Mode=OneWay}"
                                                   FontSize="18" Foreground="#9DB8DC" HorizontalAlignment="Left"
                                                   Margin="30,0,0,2" />
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Style="{StaticResource SpeedSlider}"
                                                    Minimum="0" Maximum="1"
                                                    Value="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                                            <ctl:NumberUpDown Grid.Column="1" Margin="14,0,8,0"
                                                              Value="{Binding Unit, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="个单位" FontSize="16"
                                                       Foreground="#9DB8DC" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>

                <!-- 确定 -->
                <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Width="170" Height="54"
                        HorizontalAlignment="Center" Margin="0,14,0,6"
                        Command="{Binding ConfirmCommand}">
                    <TextBlock Text="确定" FontSize="20" />
                </Button>
            </Grid>
        </ctl:SciCard>
    </Grid>
</UserControl>
