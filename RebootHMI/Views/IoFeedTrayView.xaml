<UserControl x:Class="RebootHMI.Views.IoFeedTrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RebootHMI.Controls">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ctl:SciCard Grid.Column="0" Title="{Binding Columns[0].Title}" TitleIcon="{Binding Columns[0].TitleIcon}">
            <ItemsControl ItemsSource="{Binding Columns[0].Rows}" ItemTemplate="{StaticResource IoRow2}" />
        </ctl:SciCard>

        <ItemsControl Grid.Column="1" Style="{StaticResource ChevronDecor}"
                      ItemsSource="{Binding Columns[0].Rows}" />

        <ctl:SciCard Grid.Column="2" Title="{Binding Columns[1].Title}" TitleIcon="{Binding Columns[1].TitleIcon}">
            <ItemsControl ItemsSource="{Binding Columns[1].Rows}" ItemTemplate="{StaticResource IoRow2}" />
        </ctl:SciCard>
    </Grid>
</UserControl>
