<Window x:Class="RebootHMI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:vm="clr-namespace:RebootHMI.ViewModels"
        xmlns:v="clr-namespace:RebootHMI.Views"
        Title="自动化设备" Width="1920" Height="1080" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBgBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="76" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmViewModel}"><v:AlarmView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoModeViewModel}"><v:AutoModeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PositionViewModel}"><v:PositionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IoGripperViewModel}"><v:IoGripperRobotView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IoFeedTrayViewModel}"><v:IoFeedTrayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IoDischargeViewModel}"><v:IoDischargeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IoNgInspectViewModel}"><v:IoNgInspectView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><v:PlaceholderView /></DataTemplate>

        <!-- 标题栏窗控按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BFE4FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 子菜单按钮 -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Foreground" Value="#CFE4FA" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B4E9C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="98" />
        </Grid.RowDefinitions>

        <!-- 星空背景 -->
        <Rectangle Fill="{DynamicResource StarBrush}" />

        <!-- ================= 顶栏 ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 标题栏：Logo + 标题文字 + 时间 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center">
                <Grid Width="44" Height="44" Margin="0,0,14,0">
                    <Rectangle RadiusX="3" RadiusY="3" Width="9" Height="30" HorizontalAlignment="Left" Fill="White" />
                    <Rectangle RadiusX="3" RadiusY="3" Width="9" Height="22" HorizontalAlignment="Center" Fill="#9FD8FF" />
                    <Rectangle RadiusX="3" RadiusY="3" Width="9" Height="34" HorizontalAlignment="Right">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#3FA9FF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#3FA9FF" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PLC自动化设备" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="MODAO.CC" FontSize="10" Foreground="#8FB3D9" Margin="0,2,0,0" />
                </StackPanel>
                <Border Width="1" Height="38" Background="#1C3760" Margin="22,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="17" Foreground="#DCEBFF" />
                    <TextBlock Text="{Binding TimeText}" FontSize="20" Foreground="White" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 居中科技标题 -->
            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0">
                <Path Width="560" Height="56" Stretch="Fill" Fill="{DynamicResource TitlePlateBrush}"
                      Data="M120,2 L440,2 L486,46 L74,46 Z" />
                <Path Width="560" Height="56" Stretch="Fill" Stroke="#3FA9FF" StrokeThickness="1.6"
                      Data="M120,2 L440,2 L486,46 L74,46 Z" Opacity="0.55" />
                <Path Width="150" Height="10" HorizontalAlignment="Left" Margin="150,6,0,0" Stretch="Fill"
                      Data="M0,5 L120,5 L140,0" Stroke="#46CCFF" StrokeThickness="3" Opacity="0.7" />
                <Path Width="150" Height="10" HorizontalAlignment="Right" Margin="0,6,150,0" Stretch="Fill"
                      Data="M30,0 L20,5 L150,5" Stroke="#46CCFF" StrokeThickness="3" Opacity="0.7" />
                <TextBlock Text="自动化设备" FontSize="34" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock.Effect><DropShadowEffect Color="#46CCFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- 用户 + 电源 + 窗控 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                <Border Height="48" CornerRadius="8" BorderBrush="#3FA9FF" BorderThickness="1.5" Margin="0,0,16,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33123B74" Offset="0" />
                            <GradientStop Color="#220A1E42" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Border Width="6" HorizontalAlignment="Left" Background="#3FA9FF" />
                        <StackPanel Orientation="Horizontal" Margin="16,0,20,0">
                            <md:PackIcon Kind="AccountCircle" Width="28" Height="28" Foreground="#BFE4FF"  VerticalAlignment="Center"/>
                            <TextBlock Text="用户" FontSize="19" Foreground="#DCEBFF" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#3FA9FF" BorderThickness="1.8"
                        Background="#110A2C66" Margin="0,0,20,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <md:PackIcon Kind="Power" Width="25" Height="25" Foreground="#46CCFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize">
                        <md:PackIcon Kind="WindowMinimize" Width="17" Height="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore">
                        <md:PackIcon Kind="WindowMaximize" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose">
                        <md:PackIcon Kind="WindowClose" Width="17" Height="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= 中间内容（登录页） ================= -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" />

        <!-- ================= 中间内容（登录后主界面） ================= -->
        <Grid Grid.Row="1" Margin="18,2,18,2"
              Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="22" BorderThickness="2.5"
                    BorderBrush="{DynamicResource CardBorderBrush}" Background="#0A0A2246">
                <Border.Effect><DropShadowEffect Color="#2E9BFF" BlurRadius="28" ShadowDepth="0" Opacity="0.55" /></Border.Effect>
            </Border>
            <!-- 大外框四角 -->
            <Path Width="44" Height="44" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M2,26 L2,8 Q2,2 8,2 L26,2" Stroke="#62D8FF" StrokeThickness="3" />
            <Path Width="44" Height="44" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M2,26 L2,8 Q2,2 8,2 L26,2" Stroke="#62D8FF" StrokeThickness="3">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
            </Path>
            <Path Width="44" Height="44" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Data="M2,26 L2,8 Q2,2 8,2 L26,2" Stroke="#62D8FF" StrokeThickness="3">
                <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
            </Path>
            <Path Width="44" Height="44" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M2,26 L2,8 Q2,2 8,2 L26,2" Stroke="#62D8FF" StrokeThickness="3">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
            </Path>

            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧操作栏 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource OpButtonStyle}" Content="{Binding OpButtons[0]}"
                            Command="{Binding StartCommand}" />
                    <Button Style="{StaticResource OpButtonStyle}" Content="{Binding OpButtons[1]}"
                            Command="{Binding PauseCommand}" />
                    <Button Style="{StaticResource OpButtonStyle}" Content="{Binding OpButtons[2]}"
                            Command="{Binding StopCommand}" />
                    <Button Style="{StaticResource OpButtonStyle}" Content="{Binding OpButtons[3]}"
                            Command="{Binding EStopCommand}" />
                    <Button Style="{StaticResource OpButtonStyle}" Content="{Binding OpButtons[4]}"
                            Command="{Binding ResetCommand}" />
                </StackPanel>

                <ContentControl Grid.Column="2" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>

        <!-- ================= 底部导航 ================= -->
        <Grid Grid.Row="2">
            <Border Width="1080" Height="80" CornerRadius="40" Background="#09152C"
                    BorderBrush="#17305A" BorderThickness="1.2" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,10" />
            <Grid Width="1080" HorizontalAlignment="Center"  Margin="0,0,0,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0" Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[0]}" VerticalAlignment="Center"
                             IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=manual, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" />
                <RadioButton Grid.Column="1" Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[1]}" VerticalAlignment="Center"
                             IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=auto, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" />

                <Grid Grid.Column="2">
                    <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[2]}"  VerticalAlignment="Center"
                                 IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StartsWithBool}, ConverterParameter=pos_, Mode=OneWay}"
                                 Command="{Binding DataContext.OpenPosMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <md:PackIcon Kind="MenuUp" Width="12" Height="12" Foreground="#7FA3CC"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18,0,0,12" />
                    <Popup IsOpen="{Binding IsPosMenuOpen}" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="0">
                        <Border Margin="0,0,0,10" CornerRadius="10" Background="#0C1E42"
                                BorderBrush="#3A6BA6" BorderThickness="1.2" Padding="6">
                            <Border.Effect><DropShadowEffect Color="#000" BlurRadius="16" ShadowDepth="0" Opacity="0.7" /></Border.Effect>
                            <ItemsControl ItemsSource="{Binding PositionChildren}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuItemButton}"
                                                Content="{Binding Label}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>

                <RadioButton Grid.Column="3" Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[3]}"  VerticalAlignment="Center"
                             IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=roller, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" />
                <RadioButton Grid.Column="4" Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[4]}" VerticalAlignment="Center"
                             IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=alarm, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" />
                <RadioButton Grid.Column="5" Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[5]}" VerticalAlignment="Center"
                             IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=agv, Mode=OneWay}"
                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding Key}" />

                <Grid Grid.Column="6">
                    <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[6]}"
                                 IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StartsWithBool}, ConverterParameter=io_, Mode=OneWay}"
                                 Command="{Binding DataContext.OpenIoMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <md:PackIcon Kind="MenuUp" Width="12" Height="12" Foreground="#7FA3CC"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18,0,0,12" />
                    <Popup IsOpen="{Binding IsIoMenuOpen}" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Slide">
                        <Border Margin="0,0,0,10" CornerRadius="10" Background="#0C1E42"
                                BorderBrush="#3A6BA6" BorderThickness="1.2" Padding="6">
                            <Border.Effect><DropShadowEffect Color="#000" BlurRadius="16" ShadowDepth="0" Opacity="0.7" /></Border.Effect>
                            <ItemsControl ItemsSource="{Binding IoChildren}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuItemButton}"
                                                Content="{Binding Label}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
