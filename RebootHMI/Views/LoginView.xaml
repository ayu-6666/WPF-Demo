<UserControl x:Class="RebootHMI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:ctl="clr-namespace:RebootHMI.Controls">
    <Grid>
        <ctl:SciCard Title="登录" Width="650" Height="452" HorizontalAlignment="Center" VerticalAlignment="Center"
                     CornerRadiusValue="16">
            <Grid Margin="18,8,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab -->
                <Grid Grid.Row="0" Margin="20,0,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="帐户密码登录" FontSize="18" Foreground="#9DB8DC" />
                        <Border Height="2" Margin="0,8" Background="Transparent" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="手机号登录" FontSize="18" Foreground="#46CCFF" FontWeight="Bold" />
                        <Border Height="2" Width="96" Margin="0,8" Background="#2E9BFF" />
                    </StackPanel>
                </Grid>

                <!-- 手机号 -->
                <Border Grid.Row="1" Height="58" CornerRadius="9" Background="White" Margin="0,6">
                    <Border.Effect><DropShadowEffect Color="#0A2C66" BlurRadius="16" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Grid.Column="0" Kind="Cellphone" Width="26" Height="26"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="#9DB0CE" />
                        <Grid Grid.Column="1" Margin="4,0,16,0">
                            <TextBox x:Name="PhoneBox" BorderThickness="0" Background="Transparent"
                                     Foreground="#24375C" CaretBrush="#24375C" FontSize="17"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="手机号" FontSize="16" Foreground="#9DB0CE" Margin="1,0,0,0"
                                       IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PhoneBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 验证码 -->
                <Border Grid.Row="2" Height="58" CornerRadius="9" Background="White" Margin="0,14,0,0">
                    <Border.Effect><DropShadowEffect Color="#0A2C66" BlurRadius="16" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Grid.Column="0" Kind="ShieldKey" Width="25" Height="25"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="#9DB0CE" />
                        <Grid Grid.Column="1" Margin="4,0,16,0">
                            <TextBox x:Name="CodeBox" BorderThickness="0" Background="Transparent"
                                     Foreground="#24375C" CaretBrush="#24375C" FontSize="17"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="验证码" FontSize="16" Foreground="#9DB0CE" Margin="1,0,0,0"
                                       IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CodeBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Column="2" Width="1" Background="#D8E2F0" Margin="0,14" />
                        <Button Grid.Column="3" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding SendCodeCommand}">
                            <TextBlock Text="发送验证码" FontSize="16" Foreground="#1E88F0" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 自动登录 / 忘记密码 -->
                <Grid Grid.Row="3" Margin="4,18,4,0">
                    <CheckBox Style="{StaticResource SquareCheckBox}" Content="自动登录"
                              IsChecked="{Binding AutoLogin}" HorizontalAlignment="Left" />
                    <TextBlock Text="忘记密码" FontSize="15" Foreground="#46CCFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- 登录按钮 -->
                <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" Width="164" Height="52"
                        HorizontalAlignment="Right" Margin="0,18,0,0"
                        Command="{Binding LoginCommand}">
                    <TextBlock Text="登录" FontSize="19" />
                </Button>
            </Grid>
        </ctl:SciCard>
    </Grid>
</UserControl>
