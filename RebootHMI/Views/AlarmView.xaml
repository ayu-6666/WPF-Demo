<UserControl x:Class="RebootHMI.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:ctl="clr-namespace:RebootHMI.Controls"
             xmlns:m="clr-namespace:RebootHMI.Models">
    <UserControl.Resources>
        <!-- 故障分类列表 -->
        <Style x:Key="CategoryList" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#CFE4FA" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="14,11" CornerRadius="6" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1151A8" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="356" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左列 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 故障查询 -->
            <ctl:SciCard Grid.Row="0" Title="故障查询">
                <StackPanel>
                    <!-- chips -->
                    <ItemsControl ItemsSource="{Binding Keywords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource KeywordChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="White" Margin="2,0,6,0" />
                                        <md:PackIcon Kind="Close" Width="12" Height="12" Foreground="#CFE4FA" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 搜索 -->
                    <Grid Margin="0,4,0,10">
                        <TextBox Style="{StaticResource SciTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <md:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#7FB6E8"
                                     HorizontalAlignment="Right" Margin="0,0,12,0" />
                    </Grid>

                    <!-- 分类列表 -->
                    <Border CornerRadius="8" BorderBrush="#2A4A7F" BorderThickness="1" Background="#0A1B39">
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CategoryList}" />
                    </Border>
                </StackPanel>
            </ctl:SciCard>

            <!-- 运行日志 -->
            <ctl:SciCard Grid.Row="2" Title="运行日志">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 时间线 -->
                                <Rectangle Grid.Column="0" Width="2" Fill="#2A4A7F" HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch" Margin="0,-8" />
                                <Ellipse Grid.Column="0" Width="11" Height="11" HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#CFE4FA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Pause">
                                                    <Setter Property="Fill" Value="#FF6B6B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Run">
                                                    <Setter Property="Fill" Value="#4ADE80" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="15"
                                               Foreground="#D6E7FA" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EAF4FF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Pause">
                                                        <Setter Property="Foreground" Value="#FF6B6B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Run">
                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:SciCard>
        </Grid>

        <!-- 右列：报警信息 -->
        <ctl:SciCard Grid.Column="2" Title="报警信息">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Style="{StaticResource DashedComboBox}" Width="250"
                          ItemsSource="{Binding Dates}" SelectedItem="{Binding SelectedDate}" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Alarms}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Grid.Column="0" Kind="AlarmLight" Width="44" Height="44"
                                             Foreground="#FF5252" VerticalAlignment="Top"
                                             HorizontalAlignment="Left" />
                                <Border Grid.Column="1" CornerRadius="6" Background="White"
                                        BorderBrush="#FF5252" BorderThickness="1.6" Padding="14,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" FontSize="20" FontWeight="Bold"
                                                   Foreground="#E0483E" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding Text}" FontSize="19" FontWeight="Bold"
                                                   Foreground="#E0483E" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ctl:SciCard>
    </Grid>
</UserControl>
