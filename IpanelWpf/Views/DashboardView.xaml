<UserControl x:Class="IpanelWpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:IpanelWpf.Controls"
             xmlns:vm="clr-namespace:IpanelWpf.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页签栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,10">
            <ListBox Style="{StaticResource HListBox}" SelectedIndex="0" ItemContainerStyle="{StaticResource PageTabItem}">
                <ListBoxItem Content="概览"/>
            </ListBox>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左列 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 概览统计 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="概览" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="Cog" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <UniformGrid Columns="4">
                            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,10">
                                <TextBlock Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="智能体" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,10">
                                <TextBlock Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="网站" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,10">
                                <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="数据库 · 所有" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,10">
                                <TextBlock Text="6" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="已安装应用" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 状态仪表 -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="状态" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,4,0,0">
                            <c:GaugeCircle Value="{Binding LoadValue}" CenterValue="0.0 %" CenterLabel="" BottomText="运行消耗"
                                           GaugeBrush="{StaticResource GaugeTrackBrush}"/>
                            <c:GaugeCircle Value="{Binding CpuValue}" CenterValue="4.7 %" CenterLabel="CPU" BottomText="( 0.1 / 2 )核"/>
                            <c:GaugeCircle Value="{Binding MemValue}" CenterValue="59.69%" CenterLabel="内存" BottomText="2.2 GB / 3.60 GB"/>
                            <c:GaugeCircle Value="{Binding DiskValue}" CenterValue="16.49 %" CenterLabel="/" BottomText="9.6 GB/58.99 GB"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 监控 -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="监控" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnBlueSmall}" Content="流量" Height="26" Padding="12,0"/>
                                <Button Style="{StaticResource BtnGhostSmall}" Content="磁盘 IO" Height="26" Margin="8,0,0,0"
                                        BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" Width="128" Margin="8,0,0,0" Height="26" SelectedIndex="0">
                                    <ComboBoxItem Content="网卡: 所有"/>
                                    <ComboBoxItem Content="网卡: eth0"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 图表 -->
                        <Border Grid.Row="1" CornerRadius="6" Background="{StaticResource InputBgBrush}">
                            <Grid Margin="12,8,12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 统计 + 图例 -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                            <TextBlock Text="上行" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="0 KB/s" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                            <TextBlock Text="下行" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="0 KB/s" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                            <TextBlock Text="总发送" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="1.27 GB" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="总接收" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="0.77 GB" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="上行" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,14,0" VerticalAlignment="Center"/>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource TealBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="下行" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 曲线区 -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="(KB/S)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <Viewbox Grid.Column="1" Stretch="Fill">
                                        <Canvas Width="600" Height="150">
                                            <Line X1="0" Y1="0" X2="0" Y2="150" Stroke="{StaticResource DividerBrush}" StrokeThickness="1"/>
                                            <Line X1="0" Y1="149" X2="600" Y2="149" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                                            <Polyline Points="{Binding UpSeries}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                            <Polyline Points="{Binding DownSeries}" Stroke="{StaticResource TealBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <!-- 时间滑杆 -->
                                <Grid Grid.Row="2" Margin="34,8,0,0">
                                    <Border Height="12" CornerRadius="6" Background="{StaticResource ChipBgBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="460"
                                            HorizontalAlignment="Center">
                                        <Border Height="6" CornerRadius="3" Background="{StaticResource TextSecondaryBrush}"
                                                Margin="10,0" VerticalAlignment="Center" Opacity="0.7"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 右列 ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 系统信息 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="系统信息" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconBtn}" Width="24" Height="24">
                                    <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Width="24" Height="24">
                                    <materialDesign:PackIcon Kind="ArrowExpandAll" Width="13" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Width="24" Height="24">
                                    <materialDesign:PackIcon Kind="Fullscreen" Width="13" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Width="24" Height="24">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="13" Height="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SysInfo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="27">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 应用 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="应用" Style="{StaticResource CardTitle}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="Cog" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="8" Background="{Binding ColorHex}">
                                                    <materialDesign:PackIcon Kind="{Binding IconKind}" Width="19" Height="19"
                                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="ChevronDown" Width="10" Height="10" Foreground="{StaticResource TextMutedBrush}"
                                                                                 VerticalAlignment="Center" Margin="5,1,0,0"/>
                                                        <materialDesign:PackIcon Kind="Fire" Width="12" Height="12"
                                                                                 Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                                 Visibility="{Binding ShowFlame, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Style="{StaticResource BtnLink}" Content="来源" FontSize="11"/>
                                                        <Button Style="{StaticResource BtnLink}" Content="详情" FontSize="11"/>
                                                        <Button Style="{StaticResource BtnLink}" Content="更多" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource BtnGhostSmall}" Content="安装"
                                                        Foreground="{StaticResource PrimaryBrush}" Width="52" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
