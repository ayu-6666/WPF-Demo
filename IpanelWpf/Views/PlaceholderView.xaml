<UserControl x:Class="IpanelWpf.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="Cog" Width="46" Height="46"
                                     Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="演示版本暂未收录该页面，敬请期待" FontSize="12" Margin="0,8,0,0"
                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
