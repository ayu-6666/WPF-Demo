<UserControl x:Class="IpanelWpf.Views.AppStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:IpanelWpf.Controls"
             xmlns:m="clr-namespace:IpanelWpf.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页签栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,10">
            <ListBox Style="{StaticResource HListBox}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding TabIndex}"
                     ItemContainerStyle="{StaticResource PageTabItem}"/>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 分类芯片 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8">
                <ListBox Style="{StaticResource HListBox}" ItemsSource="{Binding Categories}"
                         SelectedIndex="{Binding CategoryIndex}" ItemContainerStyle="{StaticResource ChipTabItem}"/>
            </Border>

            <!-- 工具栏 -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnBlueSmall}" Content="新建"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="排序" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <c:SearchBoxControl Placeholder="搜索" BoxWidth="240" Text="{Binding SearchText, Mode=TwoWay}"/>
                    <Button Style="{StaticResource IconBtn}" Margin="8,0,0,0" Width="28" Height="28">
                        <materialDesign:PackIcon Kind="Cog" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 提示条 -->
            <Border Grid.Row="2" Style="{StaticResource InfoBanner}" Margin="0,12,0,0">
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Run Text="配置镜像加速可以解决未接触拉取失败的问题，" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Run Text="点此去配置" Foreground="{StaticResource PrimaryBrush}"/>
                </TextBlock>
            </Border>

            <!-- 应用卡片 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <UniformGrid Columns="2">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo -->
                                        <Border Width="46" Height="46" CornerRadius="10">
                                            <Grid>
                                                <!-- mysql -->
                                                <Border Background="White" CornerRadius="10"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=mysql}">
                                                    <TextBlock Text="MySQL" FontSize="10.5" FontWeight="Bold" Foreground="#FF0A6CBD"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- redis -->
                                                <Border Background="#FFA62423" CornerRadius="10"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=redis}">
                                                    <materialDesign:PackIcon Kind="Layers" Width="22" Height="22" Foreground="White"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- nginx -->
                                                <Border Background="White" CornerRadius="10"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=nginx}">
                                                    <materialDesign:PackIcon Kind="Hexagon" Width="22" Height="22" Foreground="#FF3E8E5A"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- openvpn -->
                                                <Border Background="#FFEA7E29" CornerRadius="10"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=openvpn}">
                                                    <materialDesign:PackIcon Kind="Lock" Width="20" Height="20" Foreground="White"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- tomcat -->
                                                <Border Background="#FFF6C344" CornerRadius="10"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=tomcat}">
                                                    <materialDesign:PackIcon Kind="Cat" Width="22" Height="22" Foreground="#FF5B4319"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- bilibili -->
                                                <Border Background="#FF232C3D" CornerRadius="10" BorderBrush="#FF39415A" BorderThickness="1"
                                                        Visibility="{Binding LogoKind, Converter={StaticResource EqToVis}, ConverterParameter=bilibili}">
                                                    <materialDesign:PackIcon Kind="TelevisionPlay" Width="22" Height="22" Foreground="#FF3370FF"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 信息 -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <materialDesign:PackIcon Kind="ChevronDown" Width="11" Height="11"
                                                                         Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                                <Border Style="{StaticResource BadgeGreen}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BadgeGreenText}" Text="已启动"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconBtn}" Width="22" Height="22">
                                                        <materialDesign:PackIcon Kind="FolderOpen" Width="12" Height="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconBtn}" Width="22" Height="22">
                                                        <materialDesign:PackIcon Kind="Console" Width="12" Height="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconBtn}" Width="22" Height="22">
                                                        <materialDesign:PackIcon Kind="FileDocument" Width="12" Height="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconBtn}" Width="22" Height="22">
                                                        <materialDesign:PackIcon Kind="OpenInNew" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                                    <Run Text="版本: "/><Run Text="{Binding Version}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="端口:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="16,0,6,0"/>
                                                <ItemsControl ItemsSource="{Binding Ports}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource PortChip}">
                                                                <TextBlock Style="{StaticResource PortChipText}" Text="{Binding Text}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Style="{StaticResource PortChip}"
                                                        Visibility="{Binding HasJump, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="OpenInNew" Width="10" Height="10"
                                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                                 VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Style="{StaticResource PortChipText}" Text="跳转"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding InstallText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>

                                            <ItemsControl ItemsSource="{Binding Ops}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Button Content="{Binding Text}" Padding="8,0" FontSize="12"
                                                                    Style="{StaticResource BtnLink}"
                                                                    Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}"/>
                                                            <Button Content="{Binding Text}" Padding="8,0" FontSize="12"
                                                                    Style="{StaticResource BtnLinkMuted}"
                                                                    Visibility="{Binding Enabled, Converter={StaticResource InverseBool}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 备份按钮 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource BtnGhostSmall}" Content="导入备份" Height="26"/>
                                            <Button Style="{StaticResource BtnGhostSmall}" Content="备份" Height="26" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </UniformGrid>
            </ScrollViewer>
        </Grid>

        <!-- 分页 -->
        <Grid Grid.Row="2" Margin="0,12,0,2">
            <c:PagerControl TotalText="共 6 条" PageSizeIndex="1" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
