<UserControl x:Class="IpanelWpf.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:IpanelWpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页签栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,10">
            <ListBox Style="{StaticResource HListBox}" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding TabIndex}"
                     ItemContainerStyle="{StaticResource PageTabItem}"/>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource BadgeGreen}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BadgeGreenText}" Text="status docker"/>
                </Border>
                <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="版本 1.6.6" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <materialDesign:PackIcon Kind="Fire" Width="13" Height="13" Foreground="{StaticResource OrangeBrush}"
                                         VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Style="{StaticResource BtnLink}" Content="刷新" Margin="12,0,0,0"/>
                <Button Style="{StaticResource BtnLink}" Content="重置"/>
            </StackPanel>
        </Border>

        <!-- 主卡 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnBlueSmall}" Content="创建"/>
                        <Button Style="{StaticResource BtnGhostSmall}" Content="编辑" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource BtnGhostSmall}" Content="导入" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource BtnGhostSmall}" Content="导出" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <c:SearchBoxControl Placeholder="搜索" BoxWidth="200"
                                            Text="{Binding SearchText, Mode=TwoWay}"/>
                        <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="Cog" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 提示条 -->
                <Border Grid.Row="1" Style="{StaticResource InfoBanner}" Margin="0,0,0,12">
                    <TextBlock Text="为 Docker 容器发布到宿主机的端口配置访问规则；未设置防护的端口保持 Docker 默认访问方式。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <!-- 表头 -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="3.2*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="名称" Style="{StaticResource ThText}"/>
                            <materialDesign:PackIcon Kind="ArrowUpDown" Width="10" Height="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Compose / 应用" Style="{StaticResource ThText}"/>
                        <TextBlock Grid.Column="3" Text="端口" Style="{StaticResource ThText}"/>
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource ThText}"/>
                    </Grid>
                </Border>

                <!-- 数据行 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="3.2*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TdLink}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Compose}" Style="{StaticResource TdPrimary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Ports}" VerticalAlignment="Top">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border Style="{StaticResource PortChip}"
                                                                Visibility="{Binding IsGreen, Converter={StaticResource InverseBool}}">
                                                            <TextBlock Style="{StaticResource PortChipText}" Text="{Binding Text}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource PortChipGreen}"
                                                                Visibility="{Binding IsGreen, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Style="{StaticResource PortChipTextGreen}" Text="{Binding Text}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="4" Text="详情" Style="{StaticResource TdLink}" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 分页 -->
        <Grid Grid.Row="3" Margin="0,12,0,2">
            <c:PagerControl TotalText="共 6 条" PageSizeIndex="1" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
