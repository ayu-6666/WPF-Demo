<Window x:Class="IpanelWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:IpanelWpf.Models"
        xmlns:vm="clr-namespace:IpanelWpf.ViewModels"
        xmlns:v="clr-namespace:IpanelWpf.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="1Panel - 简单好用的 Linux 服务器管理面板"
        Width="1440" Height="820" MinWidth="1280" MinHeight="720"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 转换器 -->
        <Core:NavBrushConverter xmlns:Core="clr-namespace:IpanelWpf.Core" x:Key="NavBrush"/>

        <!-- 页面路由：ViewModel -> View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppStoreViewModel}">
            <v:AppStoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
            <v:DatabaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContainerViewModel}">
            <v:ContainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirewallViewModel}">
            <v:FirewallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PanelSettingsViewModel}">
            <v:PanelSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilesViewModel}">
            <v:FilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <v:PlaceholderView/>
        </DataTemplate>

        <!-- 侧边栏导航按钮 -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ChipBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航箭头旋转 -->
        <Style x:Key="NavChevron" TargetType="materialDesign:PackIcon">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 导航项模板（含子级递归） -->
        <DataTemplate DataType="{x:Type m:NavItem}">
            <StackPanel>
                <Border CornerRadius="8" Margin="8,2" Height="38" Background="Transparent">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Style="{StaticResource NavBtn}"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="17" Height="17"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding IsSelected, Converter={StaticResource NavBrush}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding IsSelected, Converter={StaticResource NavBrush}}"/>
                            <Grid Grid.Column="2" Visibility="{Binding ShowChevron, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="12" Height="12"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"
                                                         Style="{StaticResource NavChevron}"/>
                            </Grid>
                        </Grid>
                    </Button>
                </Border>

                <!-- 子级 -->
                <ItemsControl ItemsSource="{Binding Children}"
                              Margin="14,0,8,2"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <DockPanel Grid.Row="0" Margin="14,0,10,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="22" Height="22"
                            VerticalAlignment="Center" Command="{Binding ShowMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="12" Height="12"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3370FF" Offset="0"/>
                                    <GradientStop Color="#FF1E4FD8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="1" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="1Panel" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 菜单 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,4,0,4">
                    <ItemsControl ItemsSource="{Binding Menu}"/>
                </ScrollViewer>

                <!-- 主节点 -->
                <StackPanel Grid.Row="2" Margin="18,0,0,4">
                    <Separator Background="{StaticResource DividerBrush}" Height="1" Margin="0,0,14,4"/>
                    <Button Style="{StaticResource NavBtn}" HorizontalContentAlignment="Left" Height="34">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <materialDesign:PackIcon Kind="Monitor" Width="15" Height="15"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="主节点" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右侧内容 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}" Margin="14,10,14,0"/>

            <!-- 页脚 -->
            <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                    Background="Transparent" Height="34" Margin="0,8,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="Copyright © 2014-2026 飞致云" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="了解商业版" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="论坛求助" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="使用手册" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="项目地址" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="社区" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="v1.3.2" FontSize="12" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="更新" FontSize="12" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧悬浮工具条 -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{StaticResource ChipBgBrush}" CornerRadius="6" Width="22" Margin="0,0,3,0">
            <StackPanel Height="56">
                <Button Style="{StaticResource IconBtn}" Width="20" Height="26">
                    <materialDesign:PackIcon Kind="Keyboard" Width="12" Height="12"/>
                </Button>
                <Button Style="{StaticResource IconBtn}" Width="20" Height="26">
                    <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="12" Height="12"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
