<UserControl x:Class="IpanelWpf.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:IpanelWpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件页签 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource ChipBgBrush}" CornerRadius="6" Height="30" Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Folder" Width="13" Height="13"
                                                 Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="面板" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="6,0,10,0"/>
                        <materialDesign:PackIcon Kind="Close" Width="10" Height="10"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="6" Height="30" Padding="12,0" Margin="6,0,0,0">
                    <TextBlock Text="home" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource IconBtn}" Width="26" Height="26" Margin="4,0,0,0">
                    <materialDesign:PackIcon Kind="Plus" Width="12" Height="12"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 路径导航 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="ArrowUp" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="Home" Width="13" Height="13"/>
                    </Button>
                    <Border Style="{StaticResource SearchBox}" Width="420" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource SearchInput}" Text="{Binding PathText}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                    <TextBlock Text="子目录" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,14,0"/>
                    <Border Style="{StaticResource SearchBox}" Width="220" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchInput}"/>
                            <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Width="13" Height="13"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource BtnLink}" Content="AI 搜索" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnBlueSmall}" Height="26">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="创建"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="10" Height="10" VerticalAlignment="Center" Margin="4,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="上传/下载" Height="26" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="回收站" Height="26" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="终端" Height="26" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="收藏夹" Height="26" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="文件工具" Height="26" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="计算" Height="26" Margin="6,0,0,0"/>
                    <TextBlock Text="|  / (根目录) 50.01 GB" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"/>
                    </Button>
                    <TextBlock Text="复制" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="13" Height="13"/>
                    </Button>
                    <TextBlock Text="移动" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="Calculator" Width="13" Height="13"/>
                    </Button>
                    <TextBlock Text="计算" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13"/>
                    </Button>
                    <TextBlock Text="权限" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13"/>
                    </Button>
                    <TextBlock Text="删除" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="26" Height="26">
                        <materialDesign:PackIcon Kind="Cog" Width="13" Height="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 提示条 -->
        <Border Grid.Row="3" Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Padding="12,6">
            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Text="1. 请谨慎修改目录或目录权限，2. 文件夹无法拖拽大小传输。"/>
        </Border>

        <!-- 主卡：文件表 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="名称" Style="{StaticResource ThText}"/>
                            <materialDesign:PackIcon Kind="ArrowUpDown" Width="10" Height="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="权限" Style="{StaticResource ThText}"/>
                        <TextBlock Grid.Column="3" Text="用户 / 用户组" Style="{StaticResource ThText}"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="大小" Style="{StaticResource ThText}"/>
                            <materialDesign:PackIcon Kind="ArrowUpDown" Width="10" Height="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <TextBlock Text="修改时间" Style="{StaticResource ThText}"/>
                            <materialDesign:PackIcon Kind="ArrowUpDown" Width="10" Height="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="6" Text="备注" Style="{StaticResource ThText}"/>
                        <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource ThText}"/>
                    </Grid>
                </Border>

                <!-- 数据行 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource DarkCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Folder" Width="15" Height="15" Foreground="{StaticResource YellowBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                            <materialDesign:PackIcon Kind="File" Width="14" Height="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsFolder, Converter={StaticResource InverseBool}}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TdPrimary}" Margin="7,0,0,0"/>
                                            <materialDesign:PackIcon Kind="StarOutline" Width="12" Height="12"
                                                                     Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                     Visibility="{Binding ShowStar, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Perm}" Style="{StaticResource TdText}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UserGroup}" Style="{StaticResource TdText}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource TdLink}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Time}" Style="{StaticResource TdPrimary}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Remark}" Style="{StaticResource TdText}"/>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal">
                                            <Button Style="{StaticResource BtnLink}" Content="打开"/>
                                            <Button Style="{StaticResource BtnLink}" Content="下载"/>
                                            <Button Style="{StaticResource BtnLink}" Content="更多"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="5" Margin="0,10,0,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Run Text="共 21 个 目录，2 个文件，当前目录大小 " Foreground="{StaticResource TextMutedBrush}"/>
                    <Run Text="计算" Foreground="{StaticResource PrimaryBrush}"/>
                </TextBlock>
            </StackPanel>
            <c:PagerControl TotalText="共 25 条" PageSizeIndex="3" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
