<UserControl x:Class="IpanelWpf.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Border Style="{StaticResource SearchBox}" Width="{Binding BoxWidth, ElementName=Root}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="26"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="Tb" Style="{StaticResource SearchInput}"
                         Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding Placeholder, ElementName=Root}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Tb}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Width="14" Height="14"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
