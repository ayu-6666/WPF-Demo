<UserControl x:Class="IpanelWpf.Controls.GaugeCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center">
        <Grid Width="86" Height="86" HorizontalAlignment="Center">
            <Ellipse x:Name="Track" Stroke="{StaticResource GaugeTrackBrush}" StrokeThickness="6"/>
            <Ellipse x:Name="Fill" StrokeThickness="6"
                     Stroke="{Binding GaugeBrush, ElementName=Root}"
                     StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CenterValue, ElementName=Root}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CenterLabel, ElementName=Root}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding BottomText, ElementName=Root}"
                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
