<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1Panel 暗色主题色板 -->

    <!-- 主色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3370FF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF5A8BFF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF2A57C4"/>

    <!-- 背景 -->
    <SolidColorBrush x:Key="PageBgBrush" Color="#FF1B2130"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FF171C29"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF242B3D"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#FF2B3247"/>
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#FF333C55"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FF202738"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#FF263453"/>
    <SolidColorBrush x:Key="BannerBgBrush" Color="#FF263048"/>

    <!-- 边框/分隔 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF39415A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2F374D"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6EAF3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA6AFC4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF76809A"/>

    <!-- 语义色 -->
    <SolidColorBrush x:Key="GreenBrush" Color="#FF23B26D"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFFF9F43"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FFF55450"/>
    <SolidColorBrush x:Key="TealBrush" Color="#FF36CFC9"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFF7C948"/>

    <!-- 图表/仪表 -->
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#FF39415A"/>

</ResourceDictionary>
