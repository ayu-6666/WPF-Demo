<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 微信视觉规范（集中定义，避免散落硬编码） ============ -->
    <Color x:Key="WxGreenColor">#FF07C160</Color>
    <Color x:Key="WxGreenHoverColor">#FF06AD56</Color>
    <Color x:Key="WxGreenPressedColor">#FF059B4D</Color>
    <Color x:Key="WxPageColor">#FFEDEDED</Color>
    <Color x:Key="WxNavColor">#FFF2F2F2</Color>
    <Color x:Key="WxSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="WxTextColor">#FF1A1A1A</Color>
    <Color x:Key="WxTextSecondaryColor">#FF8C8C8C</Color>
    <Color x:Key="WxTextMutedColor">#FFA8A8A8</Color>
    <Color x:Key="WxDividerColor">#FFE6E6E6</Color>
    <Color x:Key="WxHoverColor">#FFE4E4E4</Color>
    <Color x:Key="WxBubbleSelfColor">#FF95EC69</Color>
    <Color x:Key="WxBubbleOtherColor">#FFFFFFFF</Color>
    <Color x:Key="WxBadgeColor">#FFFA5151</Color>
    <Color x:Key="WxLinkColor">#FF576B95</Color>
    <Color x:Key="WxDisabledColor">#FFC9C9C9</Color>

    <SolidColorBrush x:Key="WxGreenBrush" Color="{StaticResource WxGreenColor}" />
    <SolidColorBrush x:Key="WxGreenHoverBrush" Color="{StaticResource WxGreenHoverColor}" />
    <SolidColorBrush x:Key="WxGreenPressedBrush" Color="{StaticResource WxGreenPressedColor}" />
    <SolidColorBrush x:Key="WxPageBrush" Color="{StaticResource WxPageColor}" />
    <SolidColorBrush x:Key="WxNavBrush" Color="{StaticResource WxNavColor}" />
    <SolidColorBrush x:Key="WxSurfaceBrush" Color="{StaticResource WxSurfaceColor}" />
    <SolidColorBrush x:Key="WxTextBrush" Color="{StaticResource WxTextColor}" />
    <SolidColorBrush x:Key="WxTextSecondaryBrush" Color="{StaticResource WxTextSecondaryColor}" />
    <SolidColorBrush x:Key="WxTextMutedBrush" Color="{StaticResource WxTextMutedColor}" />
    <SolidColorBrush x:Key="WxDividerBrush" Color="{StaticResource WxDividerColor}" />
    <SolidColorBrush x:Key="WxHoverBrush" Color="{StaticResource WxHoverColor}" />
    <SolidColorBrush x:Key="WxBubbleSelfBrush" Color="{StaticResource WxBubbleSelfColor}" />
    <SolidColorBrush x:Key="WxBubbleOtherBrush" Color="{StaticResource WxBubbleOtherColor}" />
    <SolidColorBrush x:Key="WxBadgeBrush" Color="{StaticResource WxBadgeColor}" />
    <SolidColorBrush x:Key="WxLinkBrush" Color="{StaticResource WxLinkColor}" />
    <SolidColorBrush x:Key="WxDisabledBrush" Color="{StaticResource WxDisabledColor}" />
    <SolidColorBrush x:Key="WxWhiteBrush" Color="White" />
    <SolidColorBrush x:Key="WxTransparentBrush" Color="Transparent" />

    <FontFamily x:Key="WxFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="WxIconFont">Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="WxFontSizeBase">14</sys:Double>
    <sys:Double x:Key="WxFontSizeSmall">12</sys:Double>
    <sys:Double x:Key="WxFontSizeMeta">11</sys:Double>
    <sys:Double x:Key="WxFontSizeTitle">16</sys:Double>
    <sys:Double x:Key="WxCornerRadius">4</sys:Double>

    <CornerRadius x:Key="WxCorner">4</CornerRadius>
    <CornerRadius x:Key="WxCornerSmall">3</CornerRadius>

    <!-- ============ 基础排版 ============ -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource WxFont}" />
        <Setter Property="FontSize" Value="{StaticResource WxFontSizeBase}" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="Background" Value="{StaticResource WxPageBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WxFont}" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="WxTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
    </Style>

    <Style x:Key="WxMetaText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource WxFontSizeMeta}" />
        <Setter Property="Foreground" Value="{StaticResource WxTextMutedBrush}" />
    </Style>

    <Style x:Key="WxSecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource WxFontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource WxTextSecondaryBrush}" />
    </Style>

    <!-- ============ 图标按钮 ============ -->
    <Style x:Key="WxIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WxTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource WxIconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource WxIconFont}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource WxHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxWindowButton" TargetType="Button" BasedOn="{StaticResource WxIconButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource WxIconFont}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE5E5E5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxCloseWindowButton" TargetType="Button" BasedOn="{StaticResource WxWindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource WxIconFont}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 导航图标（选中变绿） ============ -->
    <Style x:Key="WxNavToggle" TargetType="RadioButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,3,0,3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource WxTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource WxIconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" ClipToBounds="True">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource WxIconFont}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextOptions.TextRenderingMode="ClearType"
                                   UseLayoutRounding="True"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE7E7E7" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFE2F4E8" />
                            <Setter Property="Foreground" Value="{StaticResource WxGreenBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 主按钮 / 次按钮 ============ -->
    <Style x:Key="WxPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WxGreenBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource WxFontSizeBase}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource WxGreenHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource WxGreenPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource WxDisabledBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxGhostButton" TargetType="Button">
        <Setter Property="Background" Value="#FFF7F7F7" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WxDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFEFEFEF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxTextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WxLinkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource WxFontSizeSmall}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 会话列表 ============ -->
    <Style x:Key="WxListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource WxHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource WxGreenBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 输入框 ============ -->
    <Style x:Key="WxSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource WxSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CaretBrush" Value="{StaticResource WxTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderThickness="0">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="watermark" Text="{TemplateBinding Tag}" Foreground="{StaticResource WxTextMutedBrush}"
                                       VerticalAlignment="Center" Margin="4,0" FontSize="12" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxInputBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource WxTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxLabelInput" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderBrush" Value="{StaticResource WxDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource WxSurfaceBrush}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderBrush" Value="{StaticResource WxDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource WxSurfaceBrush}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 开关 ============ -->
    <Style x:Key="WxToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Width="40" Height="20" CornerRadius="10" Background="#FFD9D9D9">
                        <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8" Background="White"
                                HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.3" />
                            </Border.Effect>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource WxGreenBrush}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 细滚动条 ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FFC8C8C8" CornerRadius="3" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WxSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource WxDividerBrush}" />
    </Style>

    <Style x:Key="WxPopupMenu" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WxSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{StaticResource WxDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
