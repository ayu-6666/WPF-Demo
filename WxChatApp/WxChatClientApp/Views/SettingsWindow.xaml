<Window x:Class="WxChatApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}" Width="720" Height="640" MinWidth="640" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Border Margin="12" CornerRadius="8" Background="White" BorderBrush="#FFE2E2E2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#FFF7F7F7" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="{DynamicResource Settings.Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0" />
                    <Button Style="{StaticResource WxCloseWindowButton}" Width="40" Height="32"
                            HorizontalAlignment="Right" Content="&#xE8BB;" ToolTip="{DynamicResource Common.Close}"
                            Click="Close_Click" AutomationProperties.AutomationId="SettingsClose" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,12,18,8">

                        <!-- 一、缓存 -->
                        <Border Background="#FFFAFAFA" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.SectionCache}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.CachePath}" FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" />
                                    <TextBox x:Name="CachePathBox" Grid.Column="1" Style="{StaticResource WxLabelInput}"
                                             Height="30" Margin="0,0,8,0"
                                             AutomationProperties.AutomationId="CachePathBox" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Browse}" Style="{StaticResource WxGhostButton}"
                                            Width="64" Height="30" Click="BrowseCache_Click"
                                            AutomationProperties.AutomationId="BrowseCacheButton" />
                                    <Button Grid.Column="3" Content="{DynamicResource Common.Open}" Style="{StaticResource WxGhostButton}"
                                            Width="64" Height="30" Margin="8,0,0,0" Click="OpenCache_Click" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Settings.CurrentUsage}" FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CacheSizeText" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="CacheSizeText" />
                                    <Button Content="{DynamicResource Settings.ClearCache}" Style="{StaticResource WxGhostButton}" Width="88" Height="30"
                                            Margin="16,0,0,0" Click="ClearCache_Click"
                                            AutomationProperties.AutomationId="ClearCacheButton" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 二、图片/文件存放 -->
                        <Border Background="#FFFAFAFA" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.SectionFiles}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.StorageDir}" FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" />
                                    <TextBox x:Name="FilesPathBox" Grid.Column="1" Style="{StaticResource WxLabelInput}"
                                             Height="30" IsReadOnly="True" Margin="0,0,8,0"
                                             AutomationProperties.AutomationId="FilesPathBox" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Browse}" Style="{StaticResource WxGhostButton}"
                                            Width="64" Height="30" Click="BrowseFiles_Click"
                                            AutomationProperties.AutomationId="BrowseFilesButton" />
                                </Grid>
                                <TextBlock Text="{DynamicResource Settings.FilesHint}" FontSize="11"
                                           Foreground="#FF8A8A8A" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 三、聊天 / 朋友圈背景 -->
                        <Border Background="#FFFAFAFA" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.SectionBackground}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="120" Height="72" CornerRadius="6" Background="#FFF2F2F2"
                                            BorderBrush="#FFE2E2E2" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="BgPreview" Stretch="UniformToFill"
                                                   AutomationProperties.AutomationId="BgPreview" />
                                            <TextBlock x:Name="BgPreviewHint" Text="{DynamicResource Settings.DefaultBackground}" FontSize="11"
                                                       Foreground="#FF8A8A8A" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Common.ChooseImage}" Style="{StaticResource WxGhostButton}"
                                                Width="96" Height="30" Click="BrowseBackground_Click"
                                                AutomationProperties.AutomationId="BrowseBgButton" />
                                        <Button Content="{DynamicResource Common.RestoreDefault}" Style="{StaticResource WxGhostButton}"
                                                Width="96" Height="30" Margin="0,8,0,0" Click="ResetBackground_Click"
                                                AutomationProperties.AutomationId="ResetBgButton" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Settings.BackgroundHint}" FontSize="11" Foreground="#FF8A8A8A" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 四、通用 -->
                        <Border Background="#FFFAFAFA" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.SectionGeneral}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox x:Name="NotifyCheck" Content="{DynamicResource Settings.Notify}" Margin="0,4"
                                          Checked="Notify_Changed" Unchecked="Notify_Changed"
                                          AutomationProperties.AutomationId="NotifyCheck" />
                                <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource Settings.AutoStart}" Margin="0,4"
                                          Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"
                                          AutomationProperties.AutomationId="AutoStartCheck" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.Language}" FontSize="12"
                                               Foreground="#FF666666" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" Height="28"
                                              HorizontalAlignment="Left" SelectionChanged="Language_SelectionChanged"
                                              AutomationProperties.AutomationId="LanguageCombo">
                                        <ComboBoxItem Content="{DynamicResource Settings.LanguageZh}" />
                                        <ComboBoxItem Content="{DynamicResource Settings.LanguageEn}" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="{DynamicResource Settings.LanguageHint}" FontSize="11" Foreground="#FF8A8A8A"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Settings.ThemeHint}"
                                           FontSize="11" Foreground="#FF8A8A8A" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 四、快捷键 -->
                        <Border Background="#FFFAFAFA" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.SectionShortcuts}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.ShortcutSend}" FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" />
                                    <TextBox x:Name="ShortcutSendBox" Grid.Column="1" Style="{StaticResource WxLabelInput}"
                                             Height="30" IsReadOnly="True" PreviewKeyDown="Shortcut_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ShortcutSendBox" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Reset}" Style="{StaticResource WxGhostButton}"
                                            Width="60" Height="30" Margin="8,0,0,0" Click="ResetSend_Click"
                                            AutomationProperties.AutomationId="ResetSendButton" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Settings.ShortcutOpenChat}" FontSize="12" Foreground="#FF666666" VerticalAlignment="Center" />
                                    <TextBox x:Name="ShortcutChatBox" Grid.Column="1" Style="{StaticResource WxLabelInput}"
                                             Height="30" IsReadOnly="True" PreviewKeyDown="Shortcut_PreviewKeyDown"
                                             AutomationProperties.AutomationId="ShortcutChatBox" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Reset}" Style="{StaticResource WxGhostButton}"
                                            Width="60" Height="30" Margin="8,0,0,0" Click="ResetChat_Click"
                                            AutomationProperties.AutomationId="ResetChatButton" />
                                </Grid>
                                <TextBlock x:Name="ShortcutError" Foreground="#FFE64340" FontSize="11" Margin="0,8,0,0"
                                           TextWrapping="Wrap" AutomationProperties.AutomationId="ShortcutError" />
                                <TextBlock Text="{DynamicResource Settings.ShortcutHint}"
                                           FontSize="11" Foreground="#FF8A8A8A" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Background="#FFF7F7F7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button Content="{DynamicResource Common.Cancel}" Style="{StaticResource WxGhostButton}" Width="84" Height="32"
                                Click="Cancel_Click" AutomationProperties.AutomationId="SettingsCancel" />
                        <Button Content="{DynamicResource Common.Save}" Style="{StaticResource WxPrimaryButton}" Width="84" Height="32"
                                Margin="10,0,0,0" Click="Save_Click"
                                AutomationProperties.AutomationId="SettingsSave" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
