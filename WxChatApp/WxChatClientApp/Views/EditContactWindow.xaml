<Window x:Class="WxChatApp.Views.EditContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Contact.ProfileEditTitle}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Grid>
        <Border Margin="12" CornerRadius="8" Background="White" BorderBrush="#FFE2E2E2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#FFF7F7F7" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="{DynamicResource Contact.ProfileEditHeader}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0" />
                    <Button Style="{StaticResource WxCloseWindowButton}" Width="40" Height="32"
                            HorizontalAlignment="Right" Content="&#xE8BB;" ToolTip="{DynamicResource Common.Close}"
                            Click="Close_Click" AutomationProperties.AutomationId="CloseButton" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="18,14,18,16">
                    <TextBlock Text="{DynamicResource Contact.Remark}" FontSize="12"
                               Foreground="{StaticResource WxTextSecondaryBrush}" />
                    <TextBox x:Name="RemarkBox" Style="{StaticResource WxInputBox}" Height="32" Margin="0,6,0,0"
                             MaxLength="30" AutomationProperties.AutomationId="EditRemarkBox" />
                    <TextBlock Text="{DynamicResource Contact.RemarkHint}" FontSize="11"
                               Foreground="{StaticResource WxTextMutedBrush}" Margin="0,4,0,0" />

                    <TextBlock Text="{DynamicResource Contact.Tags}" FontSize="12" Margin="0,12,0,0"
                               Foreground="{StaticResource WxTextSecondaryBrush}" />
                    <WrapPanel x:Name="TagPanel" Margin="0,6,0,0" AutomationProperties.AutomationId="EditTagPanel" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TagInputBox" Style="{StaticResource WxInputBox}" Height="30"
                                 MaxLength="20" KeyDown="TagInputBox_KeyDown"
                                 AutomationProperties.AutomationId="EditTagInputBox" />
                        <Button Grid.Column="1" Style="{StaticResource WxGhostButton}" Width="64" Margin="8,0,0,0"
                                Content="{DynamicResource Contact.TagAdd}" Click="AddTag_Click"
                                AutomationProperties.AutomationId="EditTagAddButton" />
                    </Grid>
                    <TextBlock Text="{DynamicResource Contact.TagInputHint}" FontSize="11"
                               Foreground="{StaticResource WxTextMutedBrush}" Margin="0,4,0,0" />

                    <TextBlock Text="{DynamicResource Contact.Group}" FontSize="12" Margin="0,12,0,0"
                               Foreground="{StaticResource WxTextSecondaryBrush}" />
                    <ComboBox x:Name="GroupCombo" Height="32" Margin="0,6,0,0" IsEditable="True"
                              AutomationProperties.AutomationId="EditGroupCombo" />
                    <TextBlock Text="{DynamicResource Contact.GroupHint}" FontSize="11"
                               Foreground="{StaticResource WxTextMutedBrush}" Margin="0,4,0,0" />

                    <TextBlock x:Name="ErrorText" Foreground="#FFE64340" FontSize="11" TextWrapping="Wrap"
                               Margin="0,10,0,0" AutomationProperties.AutomationId="EditContactErrorText" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource WxGhostButton}" Content="{DynamicResource Common.Cancel}"
                                Width="72" Click="Cancel_Click" />
                        <Button x:Name="SaveButton" Style="{StaticResource WxPrimaryButton}"
                                Content="{DynamicResource Common.Save}" Width="72" Margin="8,0,0,0"
                                Click="Save_Click" AutomationProperties.AutomationId="SaveContactButton" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
