<Window x:Class="WxChatApp.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dialog.InputTitle}" Width="380" Height="220" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Border Margin="12" CornerRadius="8" Background="White" BorderBrush="#FFE2E2E2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="#FFF7F7F7" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Text="{DynamicResource Dialog.InputTitle}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="18,12,18,16">
                    <TextBlock x:Name="PromptText" Text="" FontSize="12"
                               Foreground="{StaticResource WxTextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="ValueTextBox" Style="{StaticResource WxLabelInput}" Margin="0,10,0,0"
                             MaxLength="40" KeyDown="Value_KeyDown" />
                    <TextBlock x:Name="ErrorText" Foreground="#FFE64340" FontSize="11" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource WxGhostButton}" Content="{DynamicResource Common.Cancel}" Width="72"
                                Click="Cancel_Click" />
                        <Button Style="{StaticResource WxPrimaryButton}" Content="{DynamicResource Common.Ok}" Width="72"
                                Margin="8,0,0,0" Click="Ok_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
