<Window x:Class="WxChatApp.Views.CreateGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Group.Title}" Width="440" Height="560" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Border Margin="12" CornerRadius="8" Background="White" BorderBrush="#FFE2E2E2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#FFF7F7F7" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="{DynamicResource Group.Title}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="18,14,18,6">
                    <TextBlock Text="{DynamicResource Group.Name}" FontSize="12" Foreground="{StaticResource WxTextSecondaryBrush}" />
                    <TextBox x:Name="NameTextBox" Style="{StaticResource WxLabelInput}" Margin="0,8,0,0"
                             MaxLength="30" />
                    <TextBlock Text="{DynamicResource Group.SelectMembers}" FontSize="12"
                               Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,14,0,0" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource WxDividerBrush}" BorderThickness="1"
                        CornerRadius="4" Margin="18,6,18,6">
                    <ListBox x:Name="ContactList" Style="{StaticResource WxListBox}" Margin="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="5"
                                            Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarText}" Foreground="White" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="13"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="3" Margin="18,4,18,16">
                    <TextBlock x:Name="ErrorText" Foreground="#FFE64340" FontSize="11" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource WxGhostButton}" Content="{DynamicResource Common.Cancel}" Width="72"
                                Click="Cancel_Click" />
                        <Button x:Name="CreateButton" Style="{StaticResource WxPrimaryButton}" Content="{DynamicResource Group.CreateButton}"
                                Width="72" Margin="8,0,0,0" Click="Create_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
