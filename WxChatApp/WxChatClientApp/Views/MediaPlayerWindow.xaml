<Window x:Class="WxChatApp.Views.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Media.PlayerTitle}"
        Width="820" Height="540" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF111111" ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WxPlayerIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WxTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#FF07C160" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WxTrackBg" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#FF3A3A3A" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WxSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FF07C160" Stroke="White" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WxMediaSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WxTrackFill}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource WxSliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WxTrackBg}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1A1A1A" MouseLeftButtonDown="Header_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock FontFamily="{StaticResource WxIconFont}" Text="&#xE714;" FontSize="16"
                               Foreground="#FF07C160" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontSize="13" Foreground="#FFE8E8E8" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="44" Height="44" Style="{StaticResource WxPlayerIconButton}"
                        Click="Close_Click" ToolTip="{DynamicResource Common.Close}"
                        AutomationProperties.AutomationId="MediaCloseButton">
                    <TextBlock FontFamily="{StaticResource WxIconFont}" Text="&#xE711;" FontSize="14"
                               Foreground="#FFB0B0B0" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="Black">
            <MediaElement x:Name="Player" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"
                          MediaEnded="Player_MediaEnded" MouseLeftButtonUp="Video_Click" />

            <Border x:Name="AudioPanel" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0B3D24" Offset="0" />
                        <GradientStop Color="#FF1D2B22" Offset="0.55" />
                        <GradientStop Color="#FF101010" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" Background="#33FFFFFF">
                        <TextBlock FontFamily="{StaticResource WxIconFont}" Text="&#xE8D6;" FontSize="52"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AudioName" FontSize="15" Foreground="#FFF0F0F0" Margin="0,20,0,0"
                               HorizontalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{DynamicResource Media.PlayerTitle}" FontSize="11" Foreground="#99FFFFFF"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="LoadingPanel" Background="#CC000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Media.Loading}" FontSize="13" Foreground="#FFE8E8E8" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Background="#E6111111" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock FontFamily="{StaticResource WxIconFont}" Text="&#xEA39;" FontSize="34"
                               Foreground="#FFE64340" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" Foreground="#FFE8E8E8" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" FontSize="13" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF1A1A1A" Padding="18,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayButton" Grid.Column="0" Width="44" Height="44"
                        Style="{StaticResource WxPlayerIconButton}"
                        Click="PlayPause_Click" ToolTip="{DynamicResource Media.Play}"
                        AutomationProperties.AutomationId="MediaPlayButton">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#FF07C160">
                        <TextBlock x:Name="PlayGlyph" FontFamily="{StaticResource WxIconFont}" Text="&#xE768;"
                                   FontSize="15" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Button>

                <TextBlock x:Name="CurrentText" Grid.Column="1" Text="0:00" FontSize="11"
                           Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="10,0,4,0"
                           MinWidth="42" TextAlignment="Right" />

                <Slider x:Name="Progress" Grid.Column="2" Style="{StaticResource WxMediaSlider}"
                        Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                        AutomationProperties.AutomationId="MediaProgress" />

                <TextBlock x:Name="TotalText" Grid.Column="3" Text="0:00" FontSize="11"
                           Foreground="#FF8A8A8A" VerticalAlignment="Center" Margin="4,0,18,0"
                           MinWidth="42" />

                <TextBlock Grid.Column="4" FontFamily="{StaticResource WxIconFont}" Text="&#xE767;"
                           FontSize="15" Foreground="#FFB0B0B0" VerticalAlignment="Center" Margin="0,0,6,0" />

                <Slider x:Name="Volume" Grid.Column="5" Style="{StaticResource WxMediaSlider}"
                        Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="MediaVolume" />
            </Grid>
        </Border>
    </Grid>
</Window>
