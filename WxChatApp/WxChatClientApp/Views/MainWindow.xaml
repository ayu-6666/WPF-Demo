<Window x:Class="WxChatApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WxChatApp.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource App.MainTitle}" Width="1028" Height="750" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="None" ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource WxPageBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="5"
                           GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7E7E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FF576B95" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Padding="12,5" Background="#FFF2F2F2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF576B95" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE4E8F2" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#FF4A5C83" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchHotChip" TargetType="Button">
            <Setter Property="Background" Value="#FFF2F2F2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF444444" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE8E8E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SearchRowTemplate">
            <Border Margin="0,0,0,8" Padding="12,10" Background="White" CornerRadius="6"
                    MouseLeftButtonUp="SearchRow_Click" Tag="{Binding}" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                   MaxHeight="44" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource WxTextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" FontSize="11" Margin="10,0,0,0"
                               Foreground="{StaticResource WxTextMutedBrush}" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏 ============ -->
        <Grid Grid.Row="0" Background="#FFF2F2F2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WxWindowButton}" Content="&#xE921;"
                        Click="Minimize_Click" ToolTip="{DynamicResource Main.Minimize}" />
                <Button x:Name="MaxButton" Style="{StaticResource WxWindowButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="{DynamicResource Main.Maximize}" />
                <Button Style="{StaticResource WxCloseWindowButton}" Content="&#xE8BB;"
                        Click="Close_Click" ToolTip="{DynamicResource Common.Close}" />
            </StackPanel>
        </Grid>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition x:Name="LeftPanelColumn" Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="#FFF2F2F2">
                <Grid>
                    <StackPanel Margin="0,14,0,0">
                        <Button x:Name="MeAvatar" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Center"
                                Cursor="Hand" ToolTip="{DynamicResource Main.Me}" Click="MeAvatar_Click"
                                AutomationProperties.AutomationId="MeAvatar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{Binding MeAvatarBrush}" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding MeAvatarText}" Foreground="White"
                                                       FontSize="18" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding MeAvatarUrl, Converter={StaticResource ImageUrl}}" ImageFailed="Avatar_ImageFailed"
                                                   Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MeHasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <RadioButton x:Name="ChatNav" Style="{StaticResource WxNavToggle}" GroupName="RailNav"
                                     Command="{Binding SelectTabCommand}" CommandParameter="chat"
                                     Content="&#xE8BD;" ToolTip="{DynamicResource Nav.Chats}" Margin="0,20,0,3"
                                     AutomationProperties.AutomationId="ChatNav" />
                        <RadioButton x:Name="ContactsNav" Style="{StaticResource WxNavToggle}" GroupName="RailNav"
                                     Command="{Binding SelectTabCommand}" CommandParameter="contacts"
                                     Content="&#xE716;" ToolTip="{DynamicResource Nav.Contacts}"
                                     AutomationProperties.AutomationId="ContactsNav" />
                        <RadioButton x:Name="DiscoverNav" Style="{StaticResource WxNavToggle}" GroupName="RailNav"
                                     Command="{Binding SelectTabCommand}" CommandParameter="discover"
                                     Content="&#xE774;" ToolTip="{DynamicResource Nav.Discover}"
                                     AutomationProperties.AutomationId="DiscoverNav" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <Button Style="{StaticResource WxIconButton}" Width="36" Height="36" HorizontalAlignment="Center"
                                FontSize="18" Content="&#xE717;" ToolTip="{DynamicResource Nav.CallUnsupported}"
                                Click="Unsupported_Click" />
                        <Button Style="{StaticResource WxIconButton}" Width="36" Height="36" HorizontalAlignment="Center"
                                FontSize="18" Content="&#xE700;" ToolTip="{DynamicResource Common.Settings}"
                                Click="Settings_Click" AutomationProperties.AutomationId="SettingsButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左侧列表区 -->
            <Border Grid.Column="1" Background="#FFF7F7F7" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- 会话列表 -->
                    <DockPanel Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVis}}">
                        <Grid DockPanel.Dock="Top" Height="44" Margin="8,8,8,4">
                            <Border Background="White" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource WxIconFont}"
                                               FontSize="13" Foreground="{StaticResource WxTextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource WxSearchBox}"
                                             Tag="{DynamicResource Common.Search}" Height="26" Margin="0,0,28,0"
                                             Text="{Binding ConversationSearch, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Button HorizontalAlignment="Right" Width="24" Height="24" Margin="0,0,2,0"
                                    Style="{StaticResource WxIconButton}" FontSize="12" Content="&#xE710;"
                                    ToolTip="{DynamicResource Common.More}" Click="PlusMenu_Click"
                                    AutomationProperties.AutomationId="PlusButton">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFF2F2F2" CornerRadius="12"
                                                BorderBrush="#FFE0E0E0" BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       FontFamily="{StaticResource WxIconFont}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFE7E7E7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ListBox x:Name="ChatList" Style="{StaticResource WxListBox}" ItemsSource="{Binding Conversations}"
                                 SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ChatList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="64" Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                                VerticalAlignment="Center" Background="{Binding AvatarBrush}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding AvatarText}" Foreground="White"
                                                           FontSize="17" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource ImageUrl}}" ImageFailed="Avatar_ImageFailed"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="9,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,0,44,0"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{Binding IsSelected, Converter={StaticResource SelectedForeground}}" />
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{Binding IsSelected, Converter={StaticResource SelectedSubForeground}}" />
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <TextBlock Text="{Binding LastMessage}" FontSize="12" Margin="0,0,26,0"
                                                           VerticalAlignment="Top"
                                                           Foreground="{Binding IsSelected, Converter={StaticResource SelectedSubForeground}}" />
                                                <Border Background="{StaticResource WxBadgeBrush}" CornerRadius="9"
                                                        MinWidth="18" Height="18" Padding="5,0" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="0,2,0,0"
                                                        Visibility="{Binding Unread, Converter={StaticResource CountToVis}}">
                                                    <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 通讯录 -->
                    <DockPanel Visibility="{Binding IsContactsTab, Converter={StaticResource BoolToVis}}">
                        <Grid DockPanel.Dock="Top" Height="44" Margin="8,8,8,4">
                            <Border Background="White" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource WxIconFont}"
                                               FontSize="13" Foreground="{StaticResource WxTextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Style="{StaticResource WxSearchBox}"
                                             Tag="{DynamicResource Common.Search}" Height="26"
                                             Text="{Binding ContactSearch, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Button HorizontalAlignment="Right" Width="24" Height="24" Margin="0,0,2,0"
                                    Style="{StaticResource WxIconButton}" FontSize="12" Content="&#xE710;"
                                    ToolTip="{DynamicResource Contact.AddFriend}" Click="AddFriend_Click"
                                    AutomationProperties.AutomationId="AddFriendButton">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFF2F2F2" CornerRadius="12"
                                                BorderBrush="#FFE0E0E0" BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       FontFamily="{StaticResource WxIconFont}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFE7E7E7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <ListBox x:Name="ContactsList" Style="{StaticResource WxListBox}" ItemsSource="{Binding ContactsView}"
                                 SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ContactsList">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       Foreground="{StaticResource WxTextSecondaryBrush}"
                                                       Margin="14,8,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="6" VerticalAlignment="Center"
                                                Background="{Binding AvatarBrush}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding AvatarText}" Foreground="White" FontSize="15"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource ImageUrl}}" ImageFailed="Avatar_ImageFailed"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding IsSelected, Converter={StaticResource SelectedForeground}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 发现 -->
                    <StackPanel Visibility="{Binding IsDiscoverTab, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="DiscoverMenuPanel">
                        <TextBlock Text="{DynamicResource Discover.Title}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}"
                                   Margin="14,14,0,10" />
                        <Button Style="{StaticResource MenuRowButton}"
                                AutomationProperties.AutomationId="DiscoverSearchButton"
                                Command="{Binding SelectTabCommand}" CommandParameter="search">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77E;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="{StaticResource WxTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Search}" FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource WxIconFont}"
                                           FontSize="13" Foreground="{StaticResource WxTextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Click="DiscoverMoments_Click"
                                AutomationProperties.AutomationId="DiscoverMomentsButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscoverMoments}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WxGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FF3AAE3A" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Moments}" FontSize="14"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscoverMoments}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2" Width="22" Height="22" CornerRadius="4" Background="#FFF0A030">
                                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource WxIconFont}" FontSize="11"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Click="DiscoverOfficial_Click"
                                AutomationProperties.AutomationId="DiscoverOfficialButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscoverOfficial}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WxGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FF3A8DE0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Official}" FontSize="14" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WxTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiscoverOfficial}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource WxIconFont}"
                                           FontSize="13" Foreground="{StaticResource WxTextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Unsupported_Click"
                                ToolTip="{DynamicResource Discover.ChannelsTip}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FFE1674A" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Channels}" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Unsupported_Click"
                                ToolTip="{DynamicResource Discover.ScanTip}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FFE1674A" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Scan}" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Unsupported_Click"
                                ToolTip="{DynamicResource Discover.GamesTip}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FF4C9BD6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.Games}" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Unsupported_Click"
                                ToolTip="{DynamicResource Discover.MiniProgramsTip}">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource WxIconFont}" FontSize="15"
                                           Foreground="#FF8E72C7" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Discover.MiniPrograms}" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="2">
                <!-- 聊天 -->
                <Grid Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasChatOpen, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Border Width="64" Height="64" CornerRadius="12" Background="#FFE3E3E3"
                                HorizontalAlignment="Center">
                            <Image Width="40" Height="40" Stretch="Uniform"
                                   Source="pack://application:,,,/Resources/Brand/logo-128.png"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Main.SelectConversation}" FontSize="13"
                                   Foreground="{StaticResource WxTextMutedBrush}" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <views:ChatPaneView x:Name="ChatPaneHost" DataContext="{Binding ChatPane}"
                                        Visibility="{Binding DataContext.HasChatOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 联系人资料 -->
                <Grid Visibility="{Binding IsContactsTab, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowContactEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource WxIconFont}" FontSize="42"
                                   Foreground="#FFCFCFCF" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Main.SelectContact}" FontSize="13"
                                   Foreground="{StaticResource WxTextMutedBrush}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedContact, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="48,36,48,40" MaxWidth="560" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="8" Background="{Binding SelectedContact.AvatarBrush}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedContact.AvatarText}" Foreground="White"
                                                   FontSize="26" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding SelectedContact.AvatarUrl, Converter={StaticResource ImageUrl}}" ImageFailed="Avatar_ImageFailed"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedContact.HasAvatar}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedContact.DisplayName}" FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedContact.WxIdDisplay}" FontSize="12"
                                               Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,8,0,0"
                                               AutomationProperties.AutomationId="ContactWxIdText" />
                                    <TextBlock Text="{Binding SelectedContact.RegionText}" FontSize="12"
                                               Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource WxIconButton}" Width="30" Height="30"
                                        FontSize="16" Content="&#xE712;" ToolTip="{DynamicResource Contact.More}" Click="Unsupported_Click" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource WxDividerBrush}" Margin="0,20,0,0" />

                            <Grid Margin="0,18,0,12">
                                <TextBlock Text="{DynamicResource Contact.Profile}" FontSize="12"
                                           Foreground="{StaticResource WxTextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Content="{DynamicResource Common.Edit}" Width="48" Height="24"
                                        FontSize="11" Style="{StaticResource WxGhostButton}"
                                        Click="EditContactProfile_Click"
                                        ToolTip="{DynamicResource Contact.ProfileEditTitle}"
                                        AutomationProperties.AutomationId="EditContactProfileButton" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Remark}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13"
                                           Text="{Binding SelectedContact.RemarkText}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Nickname}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding SelectedContact.NickNameText}"
                                           AutomationProperties.AutomationId="ContactNickNameText" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.WxId}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding SelectedContact.WxIdText}"
                                           AutomationProperties.AutomationId="ContactWxIdRow" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Group}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding SelectedContact.GroupText}"
                                           AutomationProperties.AutomationId="ContactGroupRow" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Tags}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13"
                                           Text="{Binding SelectedContact.TagText}" />
                                <Button Grid.Column="2" Content="{DynamicResource Common.Edit}" Width="48" Height="24" Margin="12,0,0,0"
                                        FontSize="11" Style="{StaticResource WxGhostButton}"
                                        Click="EditContactTag_Click" ToolTip="{DynamicResource Contact.EditTagsTip}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Contact.Moments}" FontSize="12" Foreground="{StaticResource WxTextSecondaryBrush}"
                                       Margin="0,20,0,10" />
                            <ItemsControl ItemsSource="{Binding SelectedContactImages}"
                                          Visibility="{Binding HasSelectedContactMoments, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="64" Height="64" CornerRadius="4" Margin="0,0,6,0"
                                                Background="#FFEFEFEF" ClipToBounds="True">
                                            <Image Source="{Binding Converter={StaticResource ImageUrl}}"
                                                   Stretch="UniformToFill"
                                                   Cursor="Hand"
                                                   MouseLeftButtonDown="ContactPreviewImage_Click" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Contact.NoMoments}" FontSize="12" Foreground="{StaticResource WxTextMutedBrush}"
                                       Visibility="{Binding HasSelectedContactMoments, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                            <TextBlock Text="{DynamicResource Contact.MoreInfo}" FontSize="12" Foreground="{StaticResource WxTextSecondaryBrush}"
                                       Margin="0,20,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Signature}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                           Text="{Binding SelectedContact.SignatureText}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.Source}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{DynamicResource Contact.SourceAccount}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Contact.AddedAt}" FontSize="13" Foreground="{StaticResource WxTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding SelectedContact.CreatedAtText}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                                <Button Style="{StaticResource WxGhostButton}" Height="34" Padding="18,0"
                                        Click="SendMessageToContact_Click" ToolTip="{DynamicResource Contact.SendMessage}"
                                        AutomationProperties.AutomationId="SendMessageToContactButton">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                               Source="pack://application:,,,/Resources/Brand/logo-32.png" />
                                        <TextBlock Text="{DynamicResource Contact.SendMessage}" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WxGhostButton}" Height="34" Padding="18,0" Margin="10,0,0,0"
                                        Click="CallContactVoice_Click" ToolTip="{DynamicResource Contact.VoiceCallTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE717;" FontFamily="{StaticResource WxIconFont}" FontSize="14"
                                                   Foreground="{StaticResource WxTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Contact.VoiceCall}" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WxGhostButton}" Height="34" Padding="18,0" Margin="10,0,0,0"
                                        Click="CallContactVideo_Click" ToolTip="{DynamicResource Contact.VideoCallTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource WxIconFont}" FontSize="14"
                                                   Foreground="{StaticResource WxTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Contact.VideoCall}" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 朋友圈 -->
                <Grid Visibility="{Binding IsDiscoverMoments, Converter={StaticResource BoolToVis}}">
                    <views:MomentsPane DataContext="{Binding Moments}" />
                </Grid>

                <!-- 公众号 -->
                <Grid Background="{StaticResource WxPageBrush}" AutomationProperties.AutomationId="OfficialPane"
                      Visibility="{Binding IsDiscoverOfficial, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 账号筛选（内容面板内，保持左侧发现菜单不变） -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#FFE6E6E6" BorderThickness="0,0,0,1">
                        <DockPanel Margin="16,0" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Official.Label}" FontSize="12"
                                       Foreground="{StaticResource WxTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Official.All}" Height="28" FontSize="12"
                                    Style="{StaticResource WxGhostButton}" Click="OfficialAll_Click"
                                    ToolTip="{DynamicResource Official.AllTip}" VerticalAlignment="Center" />
                            <ComboBox Width="220" Height="28" VerticalAlignment="Center"
                                      ItemsSource="{Binding OfficialAccounts}"
                                      SelectedItem="{Binding SelectedOfficialAccount, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.AutomationId="OfficialAccountFilter" />
                        </DockPanel>
                    </Border>

                    <!-- 图文列表 -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <DockPanel Margin="16,10,16,0">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Official.Articles}" FontSize="12"
                                       Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,0,0,10" />
                            <ListBox x:Name="OfficialMessageList" ItemsSource="{Binding OfficialMessages}"
                                     SelectionChanged="OfficialMessage_SelectionChanged"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="White" CornerRadius="4"
                                                            Padding="14,10" Margin="0,0,0,6">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFF7F7F7" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource WxTextMutedBrush}">
                                                    <Run Text="{Binding AccountName}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding CreatedAt}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 图文详情 -->
                        <Border Background="White" BorderBrush="#FFE6E6E6" BorderThickness="1,0,0,0"
                                Visibility="{Binding HasSelectedOfficialMessage, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="26,16,26,20">
                                <Button DockPanel.Dock="Top" Content="{DynamicResource Official.BackList}" HorizontalAlignment="Left"
                                        FontSize="12" Style="{StaticResource WxGhostButton}"
                                        Click="OfficialDetailBack_Click" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedOfficialMessage.Title}"
                                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock FontSize="11" Foreground="{StaticResource WxGreenBrush}">
                                        <Run Text="{Binding SelectedOfficialMessage.AccountName}" />
                                    </TextBlock>
                                    <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource WxTextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedOfficialMessage.CreatedAt}" FontSize="11"
                                               Foreground="{StaticResource WxTextMutedBrush}" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedOfficialMessage.Content}" FontSize="13"
                                               TextWrapping="Wrap" LineHeight="24" Foreground="#FF444444" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 搜一搜 -->
                <Grid Background="{StaticResource WxPageBrush}"
                      Visibility="{Binding IsSearchTab, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="640" HorizontalAlignment="Center" Margin="0,26,0,40">
                            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,16">
                                <TextBlock Text="{DynamicResource Search.Brand}" FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Search.BrandHint}" FontSize="12"
                                           Foreground="{StaticResource WxTextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Background="White" CornerRadius="8" Padding="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource WxIconFont}" FontSize="14"
                                               Foreground="{StaticResource WxTextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Height="32" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" FontSize="14"
                                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="SearchBox_KeyDown"
                                             AutomationProperties.AutomationId="GlobalSearchBox" />
                                    <Button Grid.Column="2" Content="{DynamicResource Common.Search}" Height="34" Width="84"
                                            Style="{StaticResource WxPrimaryButton}"
                                            Command="{Binding DoSearchCommand}"
                                            AutomationProperties.AutomationId="GlobalSearchButton" />
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,14,0,0">
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat" IsChecked="True"
                                             Content="{DynamicResource Search.CatAll}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="all"
                                             AutomationProperties.AutomationId="SearchCatAll" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatMoment}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="moment"
                                             AutomationProperties.AutomationId="SearchCatMoment" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatArticle}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="article"
                                             AutomationProperties.AutomationId="SearchCatArticle" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatSticker}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="sticker"
                                             AutomationProperties.AutomationId="SearchCatSticker" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatOfficial}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="official"
                                             AutomationProperties.AutomationId="SearchCatOfficial" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatMini}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="mini"
                                             AutomationProperties.AutomationId="SearchCatMini" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatChannels}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="channels"
                                             AutomationProperties.AutomationId="SearchCatChannels" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatFriend}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="friend"
                                             AutomationProperties.AutomationId="SearchCatFriend" />
                                <RadioButton Style="{StaticResource SearchChip}" GroupName="SearchCat"
                                             Content="{DynamicResource Search.CatMessage}"
                                             Command="{Binding SelectSearchCategoryCommand}" CommandParameter="message"
                                             AutomationProperties.AutomationId="SearchCatMessage" />
                            </WrapPanel>

                            <TextBlock Text="{Binding SearchCategoryHint}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding HasSearchCategoryHint, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.AutomationId="SearchCategoryHint" />

                            <!-- 搜索发现（尚未搜索时） -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding ShowSearchHot, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Search.DiscoverTitle}" FontSize="14" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SearchHotItems}" Margin="0,10,0,0"
                                              AutomationProperties.AutomationId="SearchHotPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SearchHotChip}" Content="{Binding}"
                                                    Command="{Binding DataContext.PickSearchHotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 结果分区 -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding HasSearchContacts, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Search.SectionContacts}" FontSize="13" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SearchContactResults}" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource SearchRowTemplate}" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding HasSearchMessages, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Search.SectionMessages}" FontSize="13" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SearchMessageResults}" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource SearchRowTemplate}" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding HasSearchMoments, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Search.SectionMoments}" FontSize="13" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding SearchMomentResults}" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource SearchRowTemplate}" />
                            </StackPanel>

                            <!-- 空状态 -->
                            <StackPanel Margin="0,30,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Search.EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource WxTextSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Search.EmptyHint}" FontSize="12"
                                           Foreground="{StaticResource WxTextMutedBrush}" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 我 -->
                <Grid Background="{StaticResource WxPageBrush}"
                      Visibility="{Binding IsMeTab, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="620" HorizontalAlignment="Center" Margin="0,36,0,40">
                            <Border Background="White" CornerRadius="6" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="8" Background="{Binding MeAvatarBrush}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding MeAvatarText}" Foreground="White" FontSize="26"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding MeAvatarUrl, Converter={StaticResource ImageUrl}}" ImageFailed="Avatar_ImageFailed"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MeHasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MeName}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MeWxId}" FontSize="12"
                                                   Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,8,0,0"
                                                   AutomationProperties.AutomationId="MeWxIdText" />
                                        <TextBlock Text="{Binding MePhone}" FontSize="12"
                                                   Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,4,0,0"
                                                   AutomationProperties.AutomationId="MePhoneText" />
                                        <TextBlock Text="{Binding MeSignature}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource WxTextSecondaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="26" Height="26" Background="White"
                                            BorderBrush="#FFDCDCDC" BorderThickness="1" CornerRadius="2" Padding="3"
                                            VerticalAlignment="Top" ToolTip="{DynamicResource Me.QR}">
                                        <UniformGrid Rows="3" Columns="3">
                                            <Border Background="#FF333333" Margin="0.5" />
                                            <Border Margin="0.5" />
                                            <Border Background="#FF333333" Margin="0.5" />
                                            <Border Margin="0.5" />
                                            <Border Background="#FF333333" Margin="0.5" />
                                            <Border Margin="0.5" />
                                            <Border Background="#FF333333" Margin="0.5" />
                                            <Border Background="#FF333333" Margin="0.5" />
                                            <Border Margin="0.5" />
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="White" CornerRadius="6" Margin="0,12,0,0">
                                <StackPanel>
                                    <Button x:Name="ProfileEntry" Style="{StaticResource MenuRowButton}" Click="EditProfile_Click"
                                            AutomationProperties.AutomationId="ProfileEntry">
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                                       Foreground="#FF4C9BD6" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Me.Profile}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource WxIconFont}"
                                                       FontSize="12" Foreground="{StaticResource WxTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Background="#FFF0F0F0" Margin="20,0" />
                                    <Button x:Name="MyMomentsEntry" Style="{StaticResource MenuRowButton}" Click="MyMoments_Click"
                                            AutomationProperties.AutomationId="MyMomentsEntry">
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                                       Foreground="#FFE1674A" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Me.Moments}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource WxIconFont}"
                                                       FontSize="12" Foreground="{StaticResource WxTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Background="#FFF0F0F0" Margin="20,0" />
                                    <Grid Height="52" Margin="20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                                   Foreground="#FFE1A030" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Me.Notifications}" FontSize="14" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="NotificationsToggle" Grid.Column="2" Style="{StaticResource WxToggleSwitch}"
                                                      IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="NotificationsToggle" />
                                    </Grid>
                                    <Border Height="1" Background="#FFF0F0F0" Margin="20,0" />
                                    <Button x:Name="ClearHistoryEntry" Style="{StaticResource MenuRowButton}" Click="ClearHistory_Click"
                                            AutomationProperties.AutomationId="ClearHistoryEntry">
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                                       Foreground="#FF8C8C8C" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Me.ClearHistory}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource WxIconFont}"
                                                       FontSize="12" Foreground="{StaticResource WxTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Border Height="1" Background="#FFF0F0F0" Margin="20,0" />
                                    <Button x:Name="SignOutEntry" Style="{StaticResource MenuRowButton}" Click="SignOut_Click"
                                            AutomationProperties.AutomationId="SignOutEntry">
                                        <Grid Margin="20,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                                       Foreground="#FFE64340" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Me.SignOut}" FontSize="14" VerticalAlignment="Center"
                                                       Foreground="#FFE64340" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ConnectionText}" FontSize="11"
                                       Foreground="{StaticResource WxTextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- 离线提示 -->
        <Border Grid.Row="1" VerticalAlignment="Top" Height="26" Background="#FFFFF1C4"
                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="4">
            <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="#FF8A6D00"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Toast -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56"
                Background="#CC000000" CornerRadius="4" Padding="16,8" Panel.ZIndex="6"
                Visibility="{Binding Toast, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
