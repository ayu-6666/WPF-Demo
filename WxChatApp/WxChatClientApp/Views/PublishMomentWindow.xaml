<Window x:Class="WxChatApp.Views.PublishMomentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Publish.Title}" Width="520" Height="580" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid>
        <Border Margin="12" CornerRadius="8" Background="White" BorderBrush="#FFE2E2E2" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#FFF7F7F7" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="HeaderText" Text="{DynamicResource Publish.Title}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0" />
                </Grid>

                <Grid Grid.Row="1" Margin="18,12,18,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource WxDividerBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="ContentBox" Style="{StaticResource WxInputBox}" Margin="10,8"
                                 MinHeight="140" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500"
                                 AutomationProperties.AutomationId="MomentContentBox" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <ItemsControl x:Name="ImageList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="84" Height="84" Margin="0,0,6,6">
                                        <Border CornerRadius="4" Background="#FFEFEFEF" ClipToBounds="True"
                                                Cursor="Hand" MouseLeftButtonUp="Preview_Click">
                                            <Image Source="{Binding}" Stretch="UniformToFill" />
                                        </Border>
                                        <Button Width="16" Height="16" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Margin="0,3,3,0" Cursor="Hand"
                                                Click="RemoveImage_Click" ToolTip="{DynamicResource Publish.RemoveImageTip}"
                                                AutomationProperties.AutomationId="RemoveImageButton">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#B2000000" CornerRadius="8">
                                                        <TextBlock Text="&#x00D7;" Foreground="White" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource WxGhostButton}" Content="{DynamicResource Publish.AddImage}" Width="90"
                                    Click="Pick_Click" AutomationProperties.AutomationId="AddImagesButton" />
                            <Button Style="{StaticResource WxTextButton}" Content="{DynamicResource Publish.ClearImages}" Margin="10,0,0,0"
                                    Click="ClearImages_Click" />
                            <TextBlock x:Name="CountText" Text="{DynamicResource Publish.Count}" FontSize="11"
                                       Foreground="{StaticResource WxTextMutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Text="{DynamicResource Publish.FormatHint}" FontSize="11"
                                       Foreground="{StaticResource WxTextMutedBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="18,4,18,16">
                    <TextBlock x:Name="ErrorText" Foreground="#FFE64340" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource WxGhostButton}" Content="{DynamicResource Common.Cancel}" Width="72"
                                Click="Cancel_Click" />
                        <Button x:Name="PublishButton" Style="{StaticResource WxPrimaryButton}" Content="{DynamicResource Common.Publish}"
                                Width="72" Margin="8,0,0,0" Click="Publish_Click"
                                AutomationProperties.AutomationId="SaveMomentButton" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
