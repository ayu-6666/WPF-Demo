<Window x:Class="WxChatApp.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Call.Title}" Width="360" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF2B2B2B" ShowInTaskbar="True">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <Border Width="92" Height="92" CornerRadius="46" Background="#FF454545" HorizontalAlignment="Center">
                <TextBlock x:Name="AvatarText" FontSize="34" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="PeerNameText" FontSize="17" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="KindText" FontSize="12" Foreground="#FFB9B9B9"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="StateText" FontSize="12" Foreground="#FFB9B9B9"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="TimeText" FontSize="22" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Button x:Name="AcceptButton" Content="{DynamicResource Call.Accept}" Width="100" Height="42" Margin="0,0,18,0"
                    Background="#FF07C160" Foreground="White" BorderThickness="0" FontSize="14"
                    Cursor="Hand" Visibility="Collapsed" Click="Accept_Click" />
            <Button x:Name="HangUpButton" Content="{DynamicResource Call.Cancel}" Width="100" Height="42"
                    Background="#FFE64340" Foreground="White" BorderThickness="0" FontSize="14"
                    Cursor="Hand" Click="HangUp_Click" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{DynamicResource Call.DemoHint}"
                   FontSize="10" Foreground="#FF8A8A8A" HorizontalAlignment="Center" />
    </Grid>
</Window>
