<Window x:Class="WxChatApp.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#CC000000"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" Title="{DynamicResource Viewer.Title}"
        KeyDown="Window_KeyDown" MouseWheel="Window_MouseWheel">
    <Grid x:Name="RootGrid" Background="#E6000000" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- 关闭按钮（右上角） -->
        <Button x:Name="CloseBtn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,16,16,0"
                Width="36" Height="36" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand"
                Click="Close_Click" ToolTip="{DynamicResource Viewer.CloseTip}"
                AutomationProperties.AutomationId="ViewerClose">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource WxIconFont}" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 居中显示区 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 图片 -->
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                   MouseLeftButtonDown="Image_MouseLeftButtonDown"
                   MouseLeftButtonUp="Image_MouseLeftButtonUp"
                   MouseMove="Image_MouseMove"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 视频 -->
            <MediaElement x:Name="PreviewVideo" Width="720" Height="480" LoadedBehavior="Play"
                          UnloadedBehavior="Stop" Stretch="Uniform"
                          MouseLeftButtonDown="Video_Click"
                          MediaOpened="Video_MediaOpened" MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed"
                          Visibility="Collapsed" />

            <!-- 视频播放暂停提示 -->
            <TextBlock x:Name="VideoHint" FontSize="14" Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <!-- 加载失败提示 -->
            <Border x:Name="ErrorPanel" Background="#CC000000" CornerRadius="6" Padding="16,10"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#FFFFB4B4" FontSize="13"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
            </Border>

            <!-- 底部标题栏：当前索引 / 总数 + 文件名 -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,30">
                <Border Background="#66000000" CornerRadius="4" Padding="10,6">
                    <TextBlock x:Name="InfoText" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 左右箭头（多图时显示） -->
        <Button x:Name="PrevBtn" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="24,0,0,0" Width="44" Height="44" Background="#33FFFFFF" BorderThickness="0"
                Cursor="Hand" Click="Prev_Click" ToolTip="{DynamicResource Viewer.PrevTip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource WxIconFont}" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMultiple}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.28" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="NextBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,24,0" Width="44" Height="44" Background="#33FFFFFF" BorderThickness="0"
                Cursor="Hand" Click="Next_Click" ToolTip="{DynamicResource Viewer.NextTip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource WxIconFont}" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMultiple}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.28" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 底部操作按钮组 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button Content="{DynamicResource Viewer.ZoomOut}" Width="72" Height="28" FontSize="12" Style="{StaticResource WxGhostButton}"
                    Foreground="White" Background="#44000000" BorderThickness="0" Click="ZoomOut_Click" />
            <Button Content="{DynamicResource Viewer.Fit}" Width="72" Height="28" FontSize="12" Margin="6,0,0,0"
                    Style="{StaticResource WxGhostButton}" Foreground="White" Background="#44000000"
                    BorderThickness="0" Click="ResetZoom_Click" />
            <Button Content="{DynamicResource Viewer.ZoomIn}" Width="72" Height="28" FontSize="12" Margin="6,0,0,0"
                    Style="{StaticResource WxGhostButton}" Foreground="White" Background="#44000000"
                    BorderThickness="0" Click="ZoomIn_Click" />
            <Button Content="{DynamicResource Viewer.SaveAs}" Width="80" Height="28" FontSize="12" Margin="12,0,0,0"
                    Style="{StaticResource WxGhostButton}" Foreground="White" Background="#44000000"
                    BorderThickness="0" Click="SaveAs_Click" />
        </StackPanel>
    </Grid>
</Window>
