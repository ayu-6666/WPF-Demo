<Window x:Class="WxChatApp.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WxChatApp.Views"
        mc:Ignorable="d"
        Title="ChatWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:ChatViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部标题栏 -->
            <RowDefinition Height="*"/>
            <!-- 消息列表 -->
            <RowDefinition Height="Auto"/>
            <!-- 输入区域 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <TextBlock Grid.Row="0" Text="{Binding CurrentChatPartner.NickName}" FontSize="16" Padding="10"/>

        <!-- 消息列表 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10" Background="{Binding IsRecalled, Converter={StaticResource BoolToBrushConverter}}" 
                            CornerRadius="5" HorizontalAlignment="{Binding SenderId, Converter={StaticResource SenderToAlignmentConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Content}" FontSize="14"/>
                            <TextBlock Text="{Binding SendTime, StringFormat=HH:mm}" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                            <!-- 已读回执显示 -->
                            <TextBlock Text="已读" FontSize="10" Foreground="Green" HorizontalAlignment="Right" Visibility="{Binding IsRead, Converter={StaticResource BoolToVisConverter}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 输入区域 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- @群成员Popup -->
            <Popup IsOpen="{Binding IsAtPopupOpen}" PlacementTarget="{Binding ElementName=InputTextBox}" StaysOpen="False">
                <ListBox ItemsSource="{Binding GroupMembers}" Width="200" Height="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NickName}" Padding="5" MouseLeftButtonUp="SelectAtUser_OnClick"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>

            <!-- 输入框 -->
            <TextBox Grid.Row="1" x:Name="InputTextBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>

            <!-- 功能按钮栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="表情" Command="{Binding OpenEmojiCommand}" Margin="0,0,5,0"/>
                <Button Content="@" Command="{Binding OpenAtCommand}" Margin="0,0,5,0" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisConverter}}"/>
                <Button Content="撤回" Command="{Binding RetractMessageCommand}" CommandParameter="{Binding SelectedMessage}" Margin="0,0,5,0"/>
                <Button Content="发送" Command="{Binding SendMessageCommand}" Width="60"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
