<Window x:Class="TVisionUpperDemp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVisionUpperDemp · 坐标绘图工作台"
        Width="1400" Height="860" MinWidth="1050" MinHeight="650"
        Background="#0B1220" Foreground="#E8EEF7"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="#172338"/>
            <Setter Property="Foreground" Value="#DCE8F8"/>
            <Setter Property="BorderBrush" Value="#2B4161"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AFC1D9"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="GroupName" Value="Renderer"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
            <TextBlock Text="TVisionUpperDemp" FontSize="28" FontWeight="Bold" Foreground="#64B5FF"/>
            <TextBlock Text="平面坐标绘图工作台 · 多渲染机制演示" Foreground="#8298B5" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#111D30" CornerRadius="12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="渲染方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <RadioButton Content="Canvas" Tag="Canvas" IsChecked="True" Click="Renderer_Click"/>
                    <RadioButton Content="FrameworkElement" Tag="FrameworkElement" Click="Renderer_Click"/>
                    <RadioButton Content="DrawingVisual" Tag="DrawingVisual" Click="Renderer_Click"/>
                    <RadioButton Content="SkiaSharp" Tag="SkiaSharp" Click="Renderer_Click"/>
                    <RadioButton Content="WriteableBitmap" Tag="WriteableBitmap" Click="Renderer_Click"/>
                    <Separator Margin="0,16,0,12"/>
                    <TextBlock Text="坐标系" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CoordinateModeBox" SelectedIndex="0" SelectionChanged="CoordinateMode_Changed">
                        <ComboBoxItem Content="四象限"/>
                        <ComboBoxItem Content="第一象限"/>
                        <ComboBoxItem Content="第二象限"/>
                    </ComboBox>
                    <TextBlock Text="图形工具" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,4"/>
                    <ComboBox x:Name="ShapeBox" SelectedIndex="0">
                        <ComboBoxItem Content="文字"/><ComboBoxItem Content="矩形"/>
                        <ComboBoxItem Content="三角形"/><ComboBoxItem Content="多边形"/>
                        <ComboBoxItem Content="直线"/><ComboBoxItem Content="直线箭头"/>
                        <ComboBoxItem Content="圆弧"/><ComboBoxItem Content="圆环"/>
                        <ComboBoxItem Content="椭圆"/>
                    </ComboBox>
                    <Button Content="＋ 添加图形" Click="AddShape_Click"/>
                    <Button Content="清空图形" Click="Clear_Click"/>
                    <Button Content="重置视图" Click="Reset_Click"/>
                    <TextBlock Text="滚轮：锚点缩放&#xA;左键拖动：平移&#xA;右键：添加 Tag 椭圆" Foreground="#7187A5" FontSize="12" Margin="2,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="#09111D" BorderBrush="#243A58" BorderThickness="1" CornerRadius="12">
            <Grid>
                <ContentControl x:Name="SurfaceHost"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Background="#172338" CornerRadius="6" Padding="9,5">
                    <TextBlock x:Name="RendererLabel" Foreground="#8FD5FF"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" x:Name="Status" Text="就绪" Foreground="#8298B5" Margin="4,12,0,0"/>
    </Grid>
</Window>
