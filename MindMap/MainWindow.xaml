<Window x:Class="MindMapWpf48.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MindMap WPF - 流程图编辑器" Height="760" Width="1200" WindowStartupLocation="CenterScreen" Background="#FFF3F5F8">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#FF202B3C" Padding="10">
   <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="流程图设计器" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,22,0" VerticalAlignment="Center"/>
    <Button Content="矩形" Tag="Rectangle" Click="AddNode_Click" Margin="3" Padding="12,6"/>
    <Button Content="正方形" Tag="Square" Click="AddNode_Click" Margin="3" Padding="12,6"/>
    <Button Content="圆角矩形" Tag="RoundedRectangle" Click="AddNode_Click" Margin="3" Padding="12,6"/>
    <Button Content="椭圆" Tag="Ellipse" Click="AddNode_Click" Margin="3" Padding="12,6"/>
    <Button Content="菱形" Tag="Diamond" Click="AddNode_Click" Margin="3" Padding="12,6"/>
    <Separator Width="14" Opacity="0"/>
    <Button Content="连接箭头" Click="ConnectMode_Click" Margin="3" Padding="12,6"/>
    <Button Content="添加Tag" Click="AddTag_Click" Margin="3" Padding="12,6"/>
    <Button Content="编辑文字" Click="EditText_Click" Margin="3" Padding="12,6"/>
    <Button Content="删除选中" Click="Delete_Click" Margin="3" Padding="12,6"/>
    <Button Content="保存项目" Click="Save_Click" Margin="3" Padding="12,6"/>
    <Button Content="打开项目" Click="Load_Click" Margin="3" Padding="12,6"/>
    <Button Content="导出PNG" Click="ExportPng_Click" Margin="3" Padding="12,6"/>
    <Separator Width="14" Opacity="0"/>
    <Button Content="族谱世系图" Click="OpenGenealogy_Click" Margin="3" Padding="12,6" Background="#FF8A3A2E" Foreground="White" FontWeight="Bold"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" Padding="8">
   <TextBlock x:Name="StatusText" Text="提示：选择图形添加节点；拖动节点调整位置；点击“连接箭头”后依次点击起点和终点。" Foreground="#FF536174"/>
  </Border>
  <Grid Margin="12">
   <Border Background="White" BorderBrush="#FFD6DCE5" BorderThickness="1" CornerRadius="6">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
     <Canvas x:Name="DiagramCanvas" Width="1800" Height="1100" Background="White" ClipToBounds="False"/>
    </ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>