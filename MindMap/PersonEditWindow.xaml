<Window x:Class="MindMapWpf48.PersonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人信息" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF7F4EE" ShowInTaskbar="False" WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#FF7A1F1F" BorderThickness="1">
        <StackPanel>
            <!-- 自定义标题栏 -->
            <Border Background="#FF7A1F1F" Height="34">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="CloseBtn" Width="40" Height="28"
                            Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Foreground="White" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseBtn_Click" VerticalAlignment="Center"
                            ToolTip="关闭"/>
                    <TextBlock x:Name="HeaderTxt" Text="填写个人信息" Foreground="White" FontSize="13"
                               FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="18,14,18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="姓名(*):" VerticalAlignment="Center" Grid.Row="0"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Text="性别:" VerticalAlignment="Center" Grid.Row="1"/>
                    <ComboBox x:Name="GenderCombo" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" FontSize="13">
                        <ComboBoxItem Content="男"/>
                        <ComboBoxItem Content="女"/>
                    </ComboBox>

                    <TextBlock Text="出生:" VerticalAlignment="Center" Grid.Row="2"/>
                    <TextBox x:Name="BirthBox" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Text="逝世:" VerticalAlignment="Center" Grid.Row="3"/>
                    <TextBox x:Name="DeathBox" Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Text="字/号:" VerticalAlignment="Center" Grid.Row="4"/>
                    <TextBox x:Name="CourtesyBox" Grid.Row="4" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,0"/>

                    <TextBlock Text="备注:" VerticalAlignment="Top" Margin="0,8,0,0" Grid.Row="5"/>
                    <TextBox x:Name="NoteBox" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Padding="4"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <CheckBox x:Name="EndedCheck" Content="无后（止）" VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox x:Name="AdoptedCheck" Content="入继/过继（入）" VerticalAlignment="Center" FontSize="13" Margin="18,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="确定" Width="76" Height="28" Click="Ok_Click" IsDefault="True"
                            Background="#FF7A1F1F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="取消" Width="76" Height="28" Margin="10,0,0,0" IsCancel="True" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
