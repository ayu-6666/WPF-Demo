<Application x:Class="VisioLikeWpf48.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#238B57"/>
  <DropShadowEffect x:Key="MenuShadow" Color="#1B2A3D" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.18"/>
  <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
    <Border Height="1" Margin="12,5" Background="#E9EFF7"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ContextMenu">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#DCE5F0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="0,5"/><Setter Property="HasDropShadow" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" MinWidth="190" Effect="{StaticResource MenuShadow}">
     <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Foreground" Value="#2C3B4F"/><Setter Property="Padding" Value="6,6"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid>
     <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Margin="4,1" Padding="{TemplateBinding Padding}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Path x:Name="Check" Grid.Column="0" Data="M2,7 L5.6,10.6 L12,3.6" Stroke="#238B57" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="13" Height="13" Stretch="Uniform"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,10,0"/>
       <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="#93A3B7" StrokeThickness="1.6" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,2,0"/>
       <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" PopupAnimation="Fade">
        <Border Background="#FFFFFF" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="10" Padding="0,5" MinWidth="160" Effect="{StaticResource MenuShadow}">
         <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAF3FF"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#A9B5C4"/><Setter TargetName="Bd" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#263548"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D5DEE9"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F7FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#6A9FE4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E1EDFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2878D0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToggleButton">
   <Setter Property="Foreground" Value="#263548"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D5DEE9"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F7FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#6A9FE4"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E6F5EC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#238B57"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#D7EDDF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>