<Application x:Class="VisioLikeWpf48.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#238B57"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#263548"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D5DEE9"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F7FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#6A9FE4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E1EDFC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#2878D0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToggleButton">
   <Setter Property="Foreground" Value="#263548"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D5DEE9"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F1F7FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#6A9FE4"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E6F5EC"/><Setter TargetName="Bd" Property="BorderBrush" Value="#238B57"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#D7EDDF"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>