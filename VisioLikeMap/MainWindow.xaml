<Window x:Class="VisioLikeWpf48.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:VisioLikeWpf48.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="VisioLike WPF 流程图编辑器" Height="820" Width="1320" MinHeight="560" MinWidth="850"
 WindowStyle="None" ResizeMode="CanResize" Background="#EEF2F7" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#F4F7FB">
  <DockPanel>
   <Grid DockPanel.Dock="Top" Height="38" Background="#172437">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
     <Border Width="20" Height="20" CornerRadius="5" Background="#238B57" Margin="0,0,9,0"><TextBlock Text="V" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="VisioLike · 流程图设计器" Foreground="#F5F8FC" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" x:Name="MinButton" Content="—" Width="46" Height="37" Margin="0" Background="Transparent" Foreground="White" BorderThickness="0" Click="Minimize_Click"/>
     <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" x:Name="MaxButton" Content="□" Width="46" Height="37" Margin="0" Background="Transparent" Foreground="White" BorderThickness="0" Click="Maximize_Click"/>
     <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="×" Width="48" Height="37" Margin="0" Background="Transparent" Foreground="White" BorderThickness="0" Click="Close_Click"/>
    </StackPanel>
   </Grid>
   <Border DockPanel.Dock="Top" Background="#202E43" Padding="8,7">
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="图形" Foreground="#AFC0D6" VerticalAlignment="Center" Margin="5,0,4,0"/>
     <ToggleButton x:Name="RectTool" Content="矩形" Tag="Rectangle" Click="AddShape_Click"/>
     <ToggleButton Content="圆角矩形" Tag="RoundedRectangle" Click="AddShape_Click"/>
     <ToggleButton Content="椭圆" Tag="Ellipse" Click="AddShape_Click"/>
     <ToggleButton Content="菱形" Tag="Diamond" Click="AddShape_Click"/>
     <ToggleButton Content="平行四边形" Tag="Parallelogram" Click="AddShape_Click"/>
     <ToggleButton Content="文档" Tag="Document" Click="AddShape_Click"/>
     <Separator Width="10" Opacity="0"/>
     <Button Content="连接箭头" Click="Connect_Click"/>
     <Button Content="编辑文字" Click="EditText_Click"/>
     <Button Content="添加 Tag" Click="AddTag_Click"/>
     <Button Content="删除" Click="Delete_Click"/>
     <Button Content="撤销 Ctrl+Z" Click="Undo_Click"/>
     <Button Content="重做 Ctrl+Y" Click="Redo_Click"/>
     <Separator Width="8" Opacity="0"/>
     <TextBlock Text="布局" Foreground="#AFC0D6" VerticalAlignment="Center" Margin="5,0,2,0"/>
     <ToggleButton x:Name="HorizontalLayout" Content="左 → 右" IsChecked="True" Click="HorizontalLayout_Click"/>
     <ToggleButton x:Name="VerticalLayout" Content="上 ↓ 下" Click="VerticalLayout_Click"/>
     <Button Content="适应窗口" Click="Fit_Click"/>
     <Button Content="保存项目" Click="Save_Click"/>
     <Button Content="打开项目" Click="Load_Click"/>
     <Button Content="导出高清 PNG" Click="Export_Click"/>
    </WrapPanel>
   </Border>
   <Border DockPanel.Dock="Bottom" Background="#172437" Padding="12,7">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" Fill="#35C477" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="StatusText" Text="就绪  ·  左键拖动节点  ·  Ctrl+点击多选  ·  空白处拖框选择  ·  滚轮缩放  ·  空格+拖动平移" Foreground="#D7E2EF" FontSize="11" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100%" Foreground="#9FC5FF" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Grid Margin="12">
    <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
     <controls:DiagramSurface x:Name="Surface"/>
    </Border>
   </Grid>
  </DockPanel>
 </Border>
</Window>