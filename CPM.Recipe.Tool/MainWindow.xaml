<Window x:Class="CPM.Recipe.Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CMP Recipe 迁移工具" Height="780" Width="1280" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#161926"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei"
        Foreground="#D6DBEC">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="80" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ============= 主题色 ============= -->
        <SolidColorBrush x:Key="BgBrush" Color="#161926" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E2132" />
        <SolidColorBrush x:Key="Card2Brush" Color="#252838" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#2F3350" />
        <SolidColorBrush x:Key="TextMain" Color="#F2F4FF" />
        <SolidColorBrush x:Key="TextSub" Color="#9CA3B8" />
        <SolidColorBrush x:Key="TextDim" Color="White" />
        <SolidColorBrush x:Key="ControlBg" Color="#2A2D42" />
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E7CFF" Offset="0" />
            <GradientStop Color="#6366F1" Offset="0.5" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>

        <!-- ============= 全局覆盖 SystemColors（让所有 Popup / ComboBox / ListBox 下拉都是深色） ============= -->
        <!-- 注：只使用 .NET Framework 4.8 存在的键，ScrollBarThumb/Track/Arrow BrushKey 在 net48 中不存在 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2D42" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F4FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2D42" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F4FF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#6366F1" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

        <!-- ============= 渐变主按钮 ============= -->
        <Style TargetType="Button" x:Key="GradientBtn">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============= 描边次按钮 ============= -->
        <Style TargetType="Button" x:Key="OutlineBtn">
            <Setter Property="Background" Value="#2A2D42" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#363A4F" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============= 标题栏按钮 ============= -->
        <Style TargetType="Button" x:Key="TitleBarBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============= ComboBox（完整 ControlTemplate：Background/BorderBrush 直接 TemplateBinding，改 Setter 即生效） ============= -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2b2e43" />
            <Setter Property="Foreground" Value="#6366F1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 外框：Background/BorderBrush 由 Setter 控制，改 Style 即生效 -->
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />

                            <!-- 命中区（透明，接管点击展开） -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 选中项显示区：用 ItemTemplate（白字 TextBlock），IsHitTestVisible=False 让点击穿透到 ToggleButton -->
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <!-- 下拉箭头 -->
                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="#9CA3B8"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0" IsHitTestVisible="False" />

                            <!-- 下拉面板：官方标准结构 ScrollViewer + StackPanel IsItemsHost -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2A2D42" BorderBrush="#3E4366"
                                        BorderThickness="1" CornerRadius="4" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2,4">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============= ScrollBar（修复：深灰 Track #1E2132 + 中灰 Thumb #6B7190 + 亮灰 Hover） ============= -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E2132" />
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{TemplateBinding Foreground}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#00ffff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="MinHeight" Value="22" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============= TextBox（深色输入） ============= -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2D42" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="CaretBrush" Value="#F2F4FF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ============= ListBox（全局：日志框 + ComboBox 下拉 Popup 共用） ============= -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4366" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B52C4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem 同步配色 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2a2d42" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B52C4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B52C4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏 ============ -->
        <Grid Grid.Row="0" Background="#11131F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：Logo + 标题 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                        MouseLeftButtonDown="OnTitleBarDrag">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                    <TextBlock Text="⚙" Foreground="White" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="CPM Recipe 迁移工具" FontSize="16" FontWeight="Bold" 
                           Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 右：最小化 / 最大化 / 关闭 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TitleBarBtn}" Width="46" Height="32" Click="OnMinimize"
                        ToolTip="最小化">
                    <Path Data="M8,6 L20,6" Stroke="#B8C0D4" StrokeThickness="1.8"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource TitleBarBtn}" Width="46" Height="32" Click="OnToggleMax"
                        ToolTip="最大化 / 还原">
                    <TextBlock x:Name="MaxIcon" Text="▢" Foreground="#B8C0D4" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Width="46" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="OnClose" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Path Data="M11,11 L21,21 M21,11 L11,21" Stroke="#D6DBEC" StrokeThickness="1.8" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="1" Margin="20,14,20,0" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 文件路径 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁 文件路径" FontSize="13" Foreground="{StaticResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBox x:Name="PathTextBox" Width="340" IsReadOnly="True" />
                    <Button Content="浏览..." Style="{StaticResource OutlineBtn}" Margin="10,0,0,0" Click="OnBrowseFile" />
                    <Button Content="打开目录" Style="{StaticResource OutlineBtn}" Margin="10,0,0,0" Click="OnOpenDirectory" />
                </StackPanel>

                <!-- Recipe 类型 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <TextBlock Text="Recipe 类型" FontSize="13" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="RecipeTypeCombo" Width="240" SelectionChanged="OnRecipeTypeChanged">
                        <!-- 显式模板：下拉项和选中区共用，Foreground 写死白色，任何继承链都覆盖不掉 -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="White" FontSize="13" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 迁移按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚀 迁移根系" Style="{StaticResource GradientBtn}" Click="OnMigrateDirectory" />
                    <Button Content="单文件迁移" Style="{StaticResource GradientBtn}" Margin="14,0,0,0" Click="OnMigrateOne" />
                    <Button Content="保存到迁移目录" Style="{StaticResource GradientBtn}" Margin="14,0,0,0" Click="OnSaveMigrated" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ JSON 预览 ============ -->
        <Border Grid.Row="2" Margin="20,14,20,0" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄 JSON 文件预览" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="{StaticResource TextSub}" Margin="16,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Selected File:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
                        <TextBlock x:Name="fileTxt" Text="" FontSize="12" Foreground="{StaticResource TextSub}" Margin="16,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#11131F" CornerRadius="6" BorderBrush="#2F3350" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16">
                        <TextBlock x:Name="JsonPreview" FontFamily="Consolas, Menlo, Courier New"
                                   FontSize="18" Foreground="LightYellow" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 日志 ============ -->
        <Border Grid.Row="3" Margin="20,14,20,0" Background="{StaticResource CardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📜 迁移变更日志" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
                    <Button Grid.Column="1" Content="清空" Style="{StaticResource OutlineBtn}" Padding="14,5" FontSize="11" Click="OnClearLog" />
                </Grid>
                <Border Grid.Row="1" Background="#11131F" BorderBrush="#2F3350" BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="LogList" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" />
                </Border>
            </Grid>
        </Border>

        <!-- ============ 底部状态栏（版权垂直居中） ============ -->
        <Grid Grid.Row="4" Background="#11131F" Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="© 2025 CPM.Co  |  Recipe 迁移工具" FontSize="15" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock Grid.Column="1" Text="Version 1.0.0  |  Powered by WPF + Newtonsoft.Json"
                       FontSize="15" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,20,0" />
        </Grid>
    </Grid>
</Window>
