<Window x:Class="CPM.Recipe.Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CMP Recipe 迁移工具" Height="820" Width="1280" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei"
        Foreground="{DynamicResource WindowText}"
        Icon="app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="80" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏 ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：Logo + 标题 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                        MouseLeftButtonDown="OnTitleBarDrag">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentGradient}" Margin="0,0,12,0">
                    <Image Source="app.ico" Width="22" Height="22" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleBarTitle" Text="CPM Recipe 迁移工具" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 右：主题 / 帮助 / 语言 / 最小化 / 最大化 / 关闭 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeBtn" Style="{DynamicResource TitleBarBtn}" Width="42" Height="32" Click="OnToggleTheme"
                        ToolTip="切换到浅色主题">
                    <TextBlock x:Name="ThemeIcon" Text="☾" Foreground="{DynamicResource IconStroke}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="HelpBtn" Style="{DynamicResource TitleBarBtn}" Width="42" Height="32" Click="OnOpenHelp"
                        ToolTip="打开帮助文档 (PDF)">
                    <TextBlock Text="?" Foreground="{DynamicResource IconStroke}" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="LangBtn" Style="{DynamicResource TitleBarBtn}" Width="46" Height="32" Click="OnToggleLanguage"
                        ToolTip="切换界面语言">
                    <TextBlock x:Name="LangIcon" Text="EN" Foreground="{DynamicResource IconStroke}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <Border Width="1" Height="22" Background="{DynamicResource DividerBrush}" Margin="6,0" />

                <Button Style="{DynamicResource TitleBarBtn}" Width="46" Height="32" Click="OnMinimize"
                        ToolTip="最小化">
                    <Path Data="M8,6 L20,6" Stroke="{DynamicResource IconStroke}" StrokeThickness="1.8"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Style="{DynamicResource TitleBarBtn}" Width="46" Height="32" Click="OnToggleMax"
                        ToolTip="最大化 / 还原">
                    <TextBlock x:Name="MaxIcon" Text="▢" Foreground="{DynamicResource IconStroke}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Width="46" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="OnClose" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Path Data="M11,11 L21,21 M21,11 L11,21" Stroke="{DynamicResource WindowText}" StrokeThickness="1.8" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 顶层页签：recipe configuration / EC Configuration ============ -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="20,10,20,0">
            <TabItem x:Name="RecipeConfigTab" Header="recipe configuration">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏（两行） ============ -->
        <Border Grid.Row="0" Margin="0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：文件路径 + 输出目录 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PathLabel" Text="📁 文件路径" FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBox x:Name="PathTextBox" Width="300" IsReadOnly="True" />
                    <Button x:Name="BrowseBtn" Content="选择目录" Style="{DynamicResource OutlineBtn}" Margin="10,0,0,0" Click="OnBrowseFolder" />

                    <Border Width="1" Height="24" Background="{DynamicResource DividerBrush}" Margin="16,0,16,0" />

                    <TextBlock x:Name="OutputLabel" Text="输出目录" FontSize="13" Foreground="{DynamicResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBox x:Name="OutputPathTextBox" Width="240" IsReadOnly="True" />
                    <Button x:Name="BrowseOutputBtn" Content="选择目录" Style="{DynamicResource OutlineBtn}" Margin="10,0,0,0"
                            MinWidth="76" Padding="12,9" Click="OnBrowseOutputFolder" />
                    <Button x:Name="OpenOutputBtn" Content="打开输出" Style="{DynamicResource OutlineBtn}" Margin="8,0,0,0"
                            MinWidth="76" Padding="12,9" Click="OnOpenOutputDirectory" />
                </StackPanel>

                <!-- 第二行：Recipe 类型 + Recipe 文件 + 刷新 + 迁移按钮 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TypeLabel" Text="Recipe 类型" FontSize="13" Foreground="{DynamicResource TextMain}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RecipeTypeCombo" Width="180" SelectionChanged="OnRecipeTypeChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextMain}" FontSize="13" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Width="1" Height="24" Background="{DynamicResource DividerBrush}" Margin="14,0,14,0" />

                        <TextBlock x:Name="FileLabel" Text="Recipe 文件" FontSize="13" Foreground="{DynamicResource TextMain}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RecipeFileCombo" Width="300" Style="{DynamicResource RecipeFileCombo}"
                                  SelectionChanged="OnRecipeFileChanged" />
                        <Button x:Name="RefreshBtn" Content="⟳" Style="{DynamicResource OutlineBtn}" Width="40" MinWidth="40" Height="36"
                                Padding="0" Margin="8,0,0,0" FontSize="16" Click="OnRefreshFileList" ToolTip="刷新文件列表" />
                        <TextBlock x:Name="FileHintText" Text="" FontSize="12" Foreground="{DynamicResource TextSub}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddBtnBar" Content="➕ 新增" Style="{DynamicResource OutlineBtn}" Padding="12,8" FontSize="12" MinWidth="0" Click="OnAddItem" />
                        <Button x:Name="DeleteBtnBar" Content="🗑 删除" Style="{DynamicResource OutlineBtn}" Padding="12,8" FontSize="12" MinWidth="0" Margin="8,0,0,0" Click="OnDeleteItem" />
                        <Button x:Name="EditBtnBar" Content="✏ 修改" Style="{DynamicResource OutlineBtn}" Padding="12,8" FontSize="12" MinWidth="0" Margin="8,0,0,0"
                                Click="OnEditItem" IsEnabled="False" ToolTip="选中数据列表中的一行后可修改" ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="SaveAllBtnBar" Content="💾 全部保存" Style="{DynamicResource OutlineBtn}" Padding="12,8" FontSize="12" MinWidth="0" Margin="8,0,0,0" Click="OnSaveEdits" />
                        <Button x:Name="MigrateOutputBtn" Content="📦 迁移并导出" Style="{DynamicResource GradientBtn}" Padding="12,8" FontSize="12" MinWidth="0" Margin="10,0,0,0" Click="OnMigrateAndExport" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ JSON 数据（Tab：数据列表 / 原文 / 文件列表） ============ -->
        <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PreviewTitle" Text="📄 JSON 数据预览" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="{DynamicResource TextSub}" Margin="16,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>


                </Grid>

                <TabControl x:Name="PreviewTabs" Grid.Row="1">

                    <!-- ========== Tab 1：数据列表 ========== -->
                    <TabItem x:Name="DataTab" Header="📋 数据列表">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DataListHint" Text="共 0 条数据" FontSize="12" Foreground="{DynamicResource TextSub}" />
                                    <TextBlock x:Name="DirtyHint" Text="" FontSize="12" Foreground="{DynamicResource WarningText}" Margin="14,0,0,0" />
                                    <TextBlock x:Name="DoubleClickHint" Text="双击行或右键 → 修改" FontSize="12" Foreground="{DynamicResource HintText}" Margin="14,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="AddBtn" Content="➕ 新增" Style="{DynamicResource OutlineBtn}" Padding="14,7" FontSize="12"
                                            MinWidth="0" Click="OnAddItem" ToolTip="新增一条数据对象（可指定插入索引）" />
                                    <Button x:Name="DeleteBtn" Content="🗑 删除" Style="{DynamicResource OutlineBtn}" Padding="14,7" FontSize="12"
                                            MinWidth="0" Margin="8,0,0,0" Click="OnDeleteItem" ToolTip="按 ID 从所有 JSON 文件中删除该对象" />
                                    <Button x:Name="DiscardBtn" Content="放弃未保存修改" Style="{DynamicResource OutlineBtn}" Padding="14,7" FontSize="12"
                                            MinWidth="0" Margin="8,0,0,0" Click="OnDiscardEdits" ToolTip="从磁盘重新加载当前文件" />
                                    <Button x:Name="SaveBtn" Content="💾 保存修改（写入所有文件）" Style="{DynamicResource GradientBtn}"
                                            Padding="16,7" FontSize="12" MinWidth="0" Margin="8,0,0,0"
                                            Click="OnSaveEdits" IsEnabled="False" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <DataGrid x:Name="DataGrid1"
                                              IsReadOnly="True"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              AutoGenerateColumns="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              ClipToBounds="True"
                                              AutoGeneratingColumn="OnGridAutoGenerating"
                                              MouseDoubleClick="OnGridDoubleClick"
                                              SelectionChanged="OnDataSelectionChanged"
                                              PreviewMouseRightButtonDown="OnGridRightButtonDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="MenuEdit" Header="修改…" Click="OnEditSelectedRow" />
                                                <MenuItem x:Name="MenuCopyJson" Header="复制为 JSON" Click="OnCopySelectedRow" />
                                                <MenuItem x:Name="MenuCopyId" Header="复制 ID" Click="OnCopySelectedId" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                    <TextBlock x:Name="DataGridEmpty" Text="当前文件没有可显示的数据集合"
                                               FontSize="13" Foreground="{DynamicResource TextSub}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ========== Tab 2：原文 ========== -->
                    <TabItem x:Name="RawTab" Header="📜 原文">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="RawInfoText" Text="" FontSize="12" Foreground="{DynamicResource TextSub}" />
                                <TextBlock x:Name="RawHint" Text="· 只读，可选中后 Ctrl+C 复制" FontSize="12" Foreground="{DynamicResource HintText}" Margin="10,0,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer x:Name="RawScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="RawLineNo" IsReadOnly="True" Focusable="False" IsTabStop="False"
                                                 FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextSub}"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 TextAlignment="Right" MinWidth="40" Text="1"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                                        <TextBox x:Name="RawText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextMain}"
                                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="12,0,0,0"
                                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ========== Tab 3：文件列表（当前 Recipe 类型目录） ========== -->
                    <TabItem x:Name="FilesTab" Header="📁 文件列表">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="FileListHint" Text="共 0 个文件" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSub}" />
                                <TextBlock x:Name="FileListHelp" Text="· 仅当前 Recipe 类型目录 · 双击行加载到『数据列表 / 原文』"
                                           FontSize="12" Foreground="{DynamicResource HintText}" Margin="10,0,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <DataGrid x:Name="FileListGrid" IsReadOnly="True" SelectionMode="Single"
                                              SelectionUnit="FullRow" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" Background="Transparent" BorderThickness="0"
                                              MouseDoubleClick="OnFileListDoubleClick" ClipToBounds="True">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="ToolTip" Value="{Binding RelativePath}" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="FileNameCol" Header="文件名" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn x:Name="SizeCol" Header="大小" Binding="{Binding SizeText}" Width="90" />
                                            <DataGridTextColumn x:Name="ModifiedCol" Header="修改时间" Binding="{Binding ModifiedText}" Width="150" />
                                            <DataGridTextColumn x:Name="RelPathCol" Header="相对路径" Binding="{Binding RelativePath}" Width="3*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="FileListEmpty" Text="当前 Recipe 类型目录下没有 JSON 文件"
                                               FontSize="13" Foreground="{DynamicResource TextSub}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
                </Grid>
            </TabItem>

            <!-- ========== Tab 2：EC Configuration ========== -->
            <TabItem x:Name="EcConfigTab" Header="EC Configuration">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 目录栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EcPathLabel" Text="📁 Chamber 目录" FontSize="13"
                                   Foreground="{DynamicResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBox x:Name="EcRootTextBox" Grid.Column="1" Width="330" IsReadOnly="True" />
                        <Button x:Name="EcBrowseBtn" Grid.Column="2" Content="选择目录" Style="{DynamicResource OutlineBtn}"
                                Margin="10,0,0,0" Click="OnEcBrowseFolder" />
                        <Button x:Name="EcRefreshBtn" Grid.Column="3" Content="⟳" Style="{DynamicResource OutlineBtn}"
                                Width="40" MinWidth="40" Height="36" Padding="0" Margin="8,0,0,0" FontSize="16"
                                Click="OnEcRefresh" ToolTip="刷新文件列表" />
                        <TextBlock x:Name="EcRootHintText" Grid.Column="4" Text="" FontSize="12"
                                   Foreground="{DynamicResource TextSub}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：文件类型 / 文件 菜单 -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="EcTypeTitle" Text="文件类型" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}" />
                                <ListBox x:Name="EcTypeList" Grid.Row="1" Margin="0,6,0,0" MaxHeight="190"
                                         SelectionChanged="OnEcTypeChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextMain}" FontSize="13" />
                                                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextSub}"
                                                           FontSize="11.5" Margin="8,1,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EcFileTitle" Grid.Row="2" Text="文件" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}" Margin="0,12,0,0" />
                                <ListBox x:Name="EcFileList" Grid.Row="3" Margin="0,6,0,0"
                                         SelectionChanged="OnEcFileChanged" />
                            </Grid>
                        </Border>

                        <!-- 右：SheetName 分类按钮 + 数据列表 + 底部操作 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="EcSheetTitle" Text="SheetName" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMain}" />
                                        <TextBlock x:Name="EcSheetHint" Text="" FontSize="12" Foreground="{DynamicResource TextSub}"
                                                   Margin="10,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ListBox x:Name="EcSheetList" Margin="0,8,0,0" MaxHeight="112"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="OnEcSheetChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <DataGrid x:Name="EcDataGrid" IsReadOnly="True" SelectionMode="Extended"
                                              SelectionUnit="FullRow" AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False" ClipToBounds="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                              Background="Transparent" BorderThickness="0"
                                              SelectionChanged="OnEcSelectionChanged"
                                              PreviewMouseRightButtonDown="OnEcRightButtonDown">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="EcMenuAdd" Header="批量新增" Click="OnEcAdd" />
                                                <MenuItem x:Name="EcMenuEdit" Header="批量修改…" Click="OnEcEditSelected" />
                                                <MenuItem x:Name="EcMenuDelete" Header="批量删除" Click="OnEcDeleteSelected" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="EcColName" Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="128" />
                                            <DataGridTextColumn x:Name="EcColPlcLink" Header="PLCLink" Binding="{Binding PLCLink}" Width="100" MinWidth="64">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding PLCLink}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn x:Name="EcColUnit" Header="Unit" Binding="{Binding Unit}" Width="0.7*" MinWidth="42" />
                                            <DataGridTextColumn x:Name="EcColSet" Header="SetValue" Binding="{Binding SetValue}" Width="0.9*" MinWidth="60" />
                                            <DataGridTextColumn x:Name="EcColNew" Header="NewValue" Binding="{Binding NewValue}" Width="0.9*" MinWidth="60" />
                                            <DataGridTextColumn x:Name="EcColDefault" Header="DefaultValue" Binding="{Binding DefaultValue}" Width="62" />
                                            <DataGridTextColumn x:Name="EcColMin" Header="Min" Binding="{Binding Min}" Width="50" MinWidth="32" />
                                            <DataGridTextColumn x:Name="EcColMax" Header="Max" Binding="{Binding Max}" Width="50" MinWidth="32" />
                                            <DataGridTextColumn x:Name="EcColOption" Header="Option" Binding="{Binding OptionText}" Width="1.3*" MinWidth="74" />
                                            <DataGridTextColumn x:Name="EcColDiscription" Header="Discription" Binding="{Binding Discription}" Width="2*" MinWidth="84" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="EcGridEmpty" Text="当前 SheetName 没有可显示的数据"
                                               FontSize="13" Foreground="{DynamicResource TextSub}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EcRowsHint" Grid.Column="0" Text="共 0 条数据" FontSize="12"
                                           Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="EcEditBtn" Content="✏ 批量修改" Style="{DynamicResource OutlineBtn}"
                                            Padding="12,8" FontSize="12" MinWidth="0" IsEnabled="False"
                                            Click="OnEcEditSelected" ToolTipService.ShowOnDisabled="True" />
                                    <Button x:Name="EcDeleteBtn" Content="🗑 批量删除" Style="{DynamicResource OutlineBtn}"
                                            Padding="12,8" FontSize="12" MinWidth="0" Margin="8,0,0,0" IsEnabled="False"
                                            Click="OnEcDeleteSelected" ToolTipService.ShowOnDisabled="True" />
                                    <Button x:Name="EcAddBtn" Content="➕ 批量新增" Style="{DynamicResource GradientBtn}"
                                            Padding="14,8" FontSize="12" MinWidth="0" Margin="12,0,0,0"
                                            Click="OnEcAdd" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============ 日志 ============ -->
        <Border Grid.Row="2" Margin="20,12,20,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LogTitle" Text="📜 迁移变更日志" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
                    <Button x:Name="ClearLogBtn" Grid.Column="1" Content="清空" Style="{DynamicResource OutlineBtn}" Padding="14,5" FontSize="11" Click="OnClearLog" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="LogList" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" />
                </Border>
            </Grid>
        </Border>

        <!-- ============ 底部状态栏（版权垂直居中） ============ -->
        <Grid Grid.Row="3" Background="{DynamicResource TitleBarBg}" Margin="0,3,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterLeft" Grid.Column="0" Text="CPM.Recipe.ConfigrationApp 2025~2030 © Copyright.  " FontSize="14" Foreground="{DynamicResource TextDim}"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock x:Name="FooterRight" Grid.Column="1" Text="Version 1.0.0  |  Recipe Move tools"
                       FontSize="14" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,20,0" />
        </Grid>
    </Grid>
</Window>
