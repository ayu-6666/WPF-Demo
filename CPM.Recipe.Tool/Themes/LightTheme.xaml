<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============= 浅色主题色（与 DarkTheme 同键覆盖，样式仍复用 DarkTheme 中的定义） ============= -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="TitleBarBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Card2Brush" Color="#F7F9FD" />
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CodeBg" Color="#FAFBFE" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#D9DEEB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#D9DEEB" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E8EBF3" />
    <SolidColorBrush x:Key="TextMain" Color="#1F2437" />
    <SolidColorBrush x:Key="TextSub" Color="#5B627A" />
    <SolidColorBrush x:Key="TextDim" Color="#6B7285" />
    <SolidColorBrush x:Key="WindowText" Color="#38405A" />
    <SolidColorBrush x:Key="WhiteText" Color="#1F2437" />
    <SolidColorBrush x:Key="HintText" Color="#8A90A6" />
    <SolidColorBrush x:Key="IconStroke" Color="#4A5168" />
    <SolidColorBrush x:Key="ControlBg" Color="#EEF1F8" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#C9CEE0" />
    <SolidColorBrush x:Key="ComboBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboPopupBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboPopupBorder" Color="#C9CEE0" />
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#E6EAF7" />
    <SolidColorBrush x:Key="AccentOptionBrush" Color="#5B52C4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#6D5BE8" />
    <SolidColorBrush x:Key="SelectionBg" Color="#DCE0FA" />
    <SolidColorBrush x:Key="TabHoverText" Color="#37405A" />
    <SolidColorBrush x:Key="TabSelectedBg" Color="#EDF1FA" />
    <SolidColorBrush x:Key="HeaderBg" Color="#EFF2F9" />
    <SolidColorBrush x:Key="HeaderHoverBg" Color="#E3E8F5" />
    <SolidColorBrush x:Key="RowBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AltRowBg" Color="#F8FAFE" />
    <SolidColorBrush x:Key="ScrollTrack" Color="#EDF0F7" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#B4BCCE" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#6D5BE8" />
    <SolidColorBrush x:Key="WarningText" Color="#B26A00" />
    <SolidColorBrush x:Key="ErrorText" Color="#C62828" />

    <!-- 浅色下同步覆盖 SystemColors，避免下拉/弹出层仍为深色 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EEF1F8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1F2437" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1F2437" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#6366F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

</ResourceDictionary>
