<Window x:Class="CPM.Recipe.Tool.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" Foreground="{DynamicResource WindowText}">

    <!-- 全窗口半透明遮罩：覆盖 Owner，卡片居中 -->
    <Grid Background="#A60B0D16">
        <Border x:Name="Card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,0">
                    <Border x:Name="IconBadge" Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentGradient}" Margin="0,0,10,0">
                        <TextBlock x:Name="IconText" Text="ℹ" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 正文 -->
                <ScrollViewer Grid.Row="1" MaxHeight="340" Margin="20,14,20,4"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BodyText" Text="" FontSize="13" LineHeight="22"
                               Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- 按钮 -->
                <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="20,12,20,18" />
            </Grid>
        </Border>
    </Grid>
</Window>
