<Window x:Class="CPM.Recipe.Tool.EcEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EC 编辑" Height="700" Width="760" MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei"
        Foreground="{DynamicResource WindowText}" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBg}" MouseLeftButtonDown="OnHeaderDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentGradient}" Margin="0,0,10,0">
                    <TextBlock Text="EC" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Text="EC 编辑" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CloseBtn" Grid.Column="1" Width="46" Height="32" Style="{DynamicResource TitleBarBtn}"
                    Click="OnCancelClick" ToolTip="关闭">
                <Path Data="M11,11 L21,21 M21,11 L11,21" Stroke="{DynamicResource WindowText}" StrokeThickness="1.8"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- 表单区 -->
        <Border Grid.Row="1" Margin="18,14,18,0" Background="{DynamicResource CardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,16">
                <StackPanel x:Name="FormPanel">

                    <TextBlock x:Name="ModeHint" Text="" FontSize="12" Foreground="{DynamicResource TextSub}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- ECID：系统维护，不参与批量修改 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ECID" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ECIDBox" Grid.Column="2" Style="{StaticResource FieldInput}" IsReadOnly="True" />
                    </Grid>
                    <!-- Name -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkName" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="NameBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- Unit -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unit" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkUnit" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="UnitBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- PLCLink -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PLCLink" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkPlcLink" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="PlcLinkBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>
                    <!-- TemplateKey：Enum → TemplateType=1/Words=1；Text → TemplateType=2 或 3/Words=2 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TemplateKey" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkTemplateKey" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <ComboBox x:Name="TemplateKeyCombo" Grid.Column="2"
                                  SelectionChanged="OnTemplateKeyChanged" />
                    </Grid>
                    <!-- Option：仅 TemplateKey=Enum 时显示，候选值来自当前文件的真实数据 -->
                    <Grid x:Name="OptionRow" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Option" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"
                                   Margin="0,8,10,0" />
                        <CheckBox x:Name="ChkOption" Grid.Column="1" VerticalAlignment="Top" Margin="0,9,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <StackPanel Grid.Column="2">
                            <ComboBox x:Name="OptionCombo" IsEditable="True" />
                            <TextBlock x:Name="OptionHint" Text="从当前文件已有选项中选择，或输入自定义值（多个用 | 分隔）"
                                       FontSize="11.5" Foreground="{DynamicResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- SetValue -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SetValue" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkSetValue" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="SetValueBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- NewValue -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NewValue" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkNewValue" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="NewValueBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- DefaultValue -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DefaultValue" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkDefaultValue" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="DefaultValueBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- Min -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Min" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkMin" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="MinBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- Max -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkMax" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="MaxBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>

                    <!-- Discription -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discription" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="ChkDiscription" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTipService.ShowOnDisabled="True" />
                        <TextBox x:Name="DiscriptionBox" Grid.Column="2" Style="{StaticResource FieldInput}" />
                    </Grid>
                    <!-- 新增模式：数量 -->
                    <Grid x:Name="CountRow" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountLabel" Grid.Column="0" Text="新增数量" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBox x:Name="CountBox" Width="90" Text="1" Style="{StaticResource FieldInput}" />
                            <TextBlock x:Name="CountHint" Text="批量新增时按当前 SheetName 连续创建" FontSize="11.5"
                                       Foreground="{DynamicResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="18,12,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="HintText" Text="" FontSize="11.5" Foreground="{DynamicResource TextSub}" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorSummary" Text="" FontSize="11.5" Foreground="{DynamicResource ErrorText}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource OutlineBtn}" Width="96"
                        Click="OnCancelClick" IsCancel="True" />
                <Button x:Name="OkBtn" Content="确定" Style="{DynamicResource GradientBtn}" Width="110"
                        Margin="12,0,0,0" Click="OnOkClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
