<Window x:Class="Tang.RadarApplication.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="目标趋势图" Height="720" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8">
            <ComboBox x:Name="TargetSelector" Width="200" DisplayMemberPath="Id" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
            <Button Content="关闭" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <scott:WpfPlot x:Name="wpfPlotDistance" Grid.Row="0" Margin="4" />
            <scott:WpfPlot x:Name="wpfPlotSpeed" Grid.Row="1" Margin="4" />
            <scott:WpfPlot x:Name="wpfPlotAzimuth" Grid.Row="2" Margin="4" />
        </Grid>
    </Grid>
</Window>