<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Never commit a real key. Set OPENAI_API_KEY in the process environment instead. -->
    <add key="OpenAiEndpoint" value="https://api.openai.com/v1/responses" />
    <add key="OpenAiModel" value="gpt-4.1-mini" />
    <!-- Vendor CAN DLL is optional. The demo automatically uses simulation when it is absent. -->
    <add key="KvaserCanDll" value="canlib32.dll" />
  </appSettings>
</configuration>
