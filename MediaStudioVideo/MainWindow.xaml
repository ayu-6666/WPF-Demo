<Window x:Class="MediaStudioWpf48.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaStudioWpf48.ViewModels"
        xmlns:loc="clr-namespace:MediaStudioWpf48.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Media Studio"
        Width="1460" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="13"
        StateChanged="Window_StateChanged">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ============================ 自定义标题栏 ============================ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBg}"
                    BorderBrush="{DynamicResource LineColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Accent}">
                            <TextBlock Text="MS" Foreground="{DynamicResource ButtonText}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc AppTitle}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,16,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Language}"
                                AutomationProperties.AutomationId="TitleLanguage"
                                Height="34" MinWidth="78" Margin="0,0,2,0" Click="ToggleLanguage"/>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Theme}"
                                AutomationProperties.AutomationId="TitleTheme"
                                Height="34" MinWidth="72" Margin="0,0,6,0" Click="ToggleTheme"/>
                        <Border Width="1" Height="18" Background="{DynamicResource LineColor}"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE921;"
                                AutomationProperties.AutomationId="WindowMin"
                                ToolTip="{loc:Loc Minimize}" Click="Min"/>
                        <Button x:Name="MaxButton" Content="&#xE922;" ToolTip="{loc:Loc Maximize}"
                                AutomationProperties.AutomationId="WindowMax" Click="Max">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Content" Value="&#xE923;"/>
                                            <Setter Property="ToolTip" Value="{loc:Loc Restore}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                                AutomationProperties.AutomationId="WindowClose"
                                ToolTip="{loc:Loc Close}" Click="CloseWin"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ 主体 ============================ -->
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 工具箱 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="6,2,6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Tools}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource StatusChipBg}" CornerRadius="10" Padding="8,3">
                                <TextBlock Text="{loc:Loc Engine}" FontSize="{StaticResource FontXs}"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ToolList" ItemsSource="{Binding Tools}"
                                     AutomationProperties.AutomationId="ToolList"
                                     SelectedItem="{Binding Selected}"
                                     AlternationCount="2"
                                     Margin="0,0,2,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Group}"
                                                       FontSize="{StaticResource FontXs}"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:Loc NoTools}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap" Margin="16"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource LineColor}" BorderThickness="0,1,0,0"
                                Padding="6,10,6,2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Danger}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EngineReady}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding EngineText}" FontSize="{StaticResource FontSm}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧工作区 -->
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource PageTitle}" Margin="2,0,0,0"/>
                            <TextBlock Text="{Binding Selected.Help}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="2,6,0,16"/>

                            <!-- 输入与输出 -->
                            <Border Style="{StaticResource CardBorder}" Margin="{StaticResource CardGap}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc InputOutput}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>

                                    <StackPanel Margin="{StaticResource FieldGap}">
                                        <TextBlock Text="{loc:Loc InputFile}" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="InputBox"
                                                     Tag="{Binding InputHint}"
                                                     IsEnabled="{Binding IsIdle}"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                    Content="{loc:Loc SelectInput}" Click="InputClick"
                                                    AutomationProperties.AutomationId="InputBrowse"
                                                    MinWidth="104" Margin="8,0,0,0"
                                                    IsEnabled="{Binding IsIdle}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="{StaticResource FieldGap}"
                                                Visibility="{Binding ShowMusic, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc MusicFile}" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="MusicBox"
                                                     Tag="{loc:Loc MusicHint}"
                                                     IsEnabled="{Binding IsIdle}"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                    Content="{loc:Loc SelectInput}" Click="MusicClick"
                                                    AutomationProperties.AutomationId="MusicBrowse"
                                                    MinWidth="104" Margin="8,0,0,0"
                                                    IsEnabled="{Binding IsIdle}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc OutputFile}" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="OutputBox"
                                                     Tag="{loc:Loc OutputHint}"
                                                     IsEnabled="{Binding IsIdle}"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                    Content="{loc:Loc SelectOutput}" Click="OutputClick"
                                                    AutomationProperties.AutomationId="OutputBrowse"
                                                    MinWidth="104" Margin="8,0,0,0"
                                                    IsEnabled="{Binding IsIdle}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 参数配置 -->
                            <Border Style="{StaticResource CardBorder}" Margin="{StaticResource CardGap}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Parameters}" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>

                                    <UniformGrid Columns="3" Margin="-6,0,-6,0"
                                                 Visibility="{Binding ShowAnyParam, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowTiming, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc TrimStart}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Start}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowTiming, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc Duration}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Duration}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowFps, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc Fps}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Fps}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowRegion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc RegionX}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding X}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowRegion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc RegionY}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Y}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowRegion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc RegionW}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding W}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowRegion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc RegionH}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding H}"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,12"
                                                    Visibility="{Binding ShowFilter, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc RotateFilter}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="{loc:Loc NoParams}" Style="{StaticResource HintText}"
                                               Visibility="{Binding ShowNoParams, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- 任务与日志 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{loc:Loc RunLog}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource StatusChipBg}"
                                                CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontXs}"
                                                       Foreground="{DynamicResource SecondaryText}"/>
                                        </Border>
                                    </DockPanel>

                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,0,0,12"/>

                                    <TextBox Style="{StaticResource LogTextBox}"
                                             AutomationProperties.AutomationId="LogBox"
                                             Text="{Binding Log, Mode=OneWay}"
                                             Tag="{loc:Loc LogHint}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox Content="{loc:Loc OpenOutputAfter}"
                                                  IsChecked="{Binding OpenAfterDone}"
                                                  VerticalAlignment="Center"/>
                                        <Border Width="1" Height="16" Background="{DynamicResource LineColor}"
                                                Margin="16,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc LogLevel}" Style="{StaticResource FieldLabel}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                        <RadioButton Content="{loc:Loc LogVerbose}" GroupName="LogLevel"
                                                     IsChecked="{Binding DetailedLog, Mode=OneWay}"
                                                     Margin="8,0,0,0" Checked="LogVerbose_Checked"/>
                                        <RadioButton Content="{loc:Loc LogSummary}" GroupName="LogLevel"
                                                     Margin="16,0,0,0" Checked="LogSummary_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 固定在底部的操作栏 -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                            Padding="16,12" Margin="0,12,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActionHint}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="8,0,16,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="{loc:Loc Run}"
                                    AutomationProperties.AutomationId="RunButton"
                                    Command="{Binding ExecuteCommand}"
                                    MinWidth="168" Height="40"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================ 状态栏 ============================ -->
            <Border Grid.Row="2" Background="{DynamicResource FooterBg}"
                    BorderBrush="{DynamicResource LineColor}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="{loc:Loc Footer}" Foreground="{DynamicResource TextSecondary}"
                               FontSize="{StaticResource FontSm}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EngineText}" Foreground="{DynamicResource TextSecondary}"
                               FontSize="{StaticResource FontSm}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
