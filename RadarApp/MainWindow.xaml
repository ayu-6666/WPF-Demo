<Window x:Class="RadarApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadarApp"
        xmlns:con="clr-namespace:RadarApp.Converters"
        mc:Ignorable="d"
        Title="晶圆 Die-to-Die 绘制与状态管理" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <con:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <con:InserverBoolToVisibilityConverter x:Key="InserverBoolToVisibilityConverter"/>
        <!-- 让 RadioButton 看起来像左侧菜单 -->
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FF3F3F46"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Rectangle x:Name="indicator"
                                           Width="4"
                                           HorizontalAlignment="Left"
                                           Fill="#FF007ACC"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF094771"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF007ACC"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <!-- 状态栏高度 -->
        </Grid.RowDefinitions>


        <Border Background="#FF2D2D30">
            <StackPanel x:Name="MenuPanel" Orientation="Horizontal">
                <RadioButton Content="首页"
                             GroupName="MainMenu"
                             Tag="HomePage.xaml"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <RadioButton Content="关于"
                             GroupName="MainMenu"
                             Tag="AboutPage.xaml"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <RadioButton Content="other"
                             GroupName="MainMenu"
                             Tag="others"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <RadioButton Content="设置"
                             GroupName="MainMenu"
                             Tag="others"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <RadioButton Content="工具"
                             GroupName="MainMenu"
                             Tag="others"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <RadioButton Content="视图"
                             GroupName="MainMenu"
                             Tag="others"
                             Style="{StaticResource MenuRadioButtonStyle}"
                             Checked="Menu_Checked"/>
                <CheckBox x:Name="menuBar" Visibility="Hidden"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding ElementName=menuBar,Path=IsChecked,Converter={StaticResource InserverBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧控制面板 -->
            <Border Grid.Column="0" Background="#F0F2F5" Padding="20" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="晶圆参数配置" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                    <TextBlock Text="晶圆尺寸 (英寸)" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbWaferSize" SelectionChanged="CmbWaferSize_SelectionChanged" SelectedIndex="4">
                        <ComboBoxItem Content="2 英寸"/>
                        <ComboBoxItem Content="4 英寸"/>
                        <ComboBoxItem Content="6 英寸"/>
                        <ComboBoxItem Content="8 英寸"/>
                        <ComboBoxItem Content="12 英寸"/>
                    </ComboBox>

                    <TextBlock Text="Die 宽度 (px)" Margin="0,10,0,5"/>
                    <TextBox x:Name="txtDieWidth" Text="20" TextChanged="Config_TextChanged"/>
                    <TextBlock Text="Die 高度 (px)" Margin="0,10,0,5"/>
                    <TextBox x:Name="txtDieHeight" Text="20" TextChanged="Config_TextChanged"/>
                    <TextBlock Text="切割道间距 (px)" Margin="0,10,0,5"/>
                    <TextBox x:Name="txtScribeGap" Text="4" TextChanged="Config_TextChanged"/>

                    <Separator Margin="0,15" />
                    <TextBlock Text="操作面板" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333"/>

                    <Button Content="设为有效 (绿)" Click="BtnSetValid_Click" Height="35" Margin="0,5,0,5" Background="#4CAF50" Foreground="White"/>
                    <Button Content="设为无效 (灰)" Click="BtnSetInvalid_Click" Height="35" Margin="0,5,0,5" Background="#9E9E9E" Foreground="White"/>
                    <Button Content="清除选中 (红)" Click="BtnClearSelection_Click" Height="35" Margin="0,5,0,5"/>
                    <Button Content="重置视图缩放" Click="BtnResetView_Click" Height="35" Margin="0,5,0,5" Background="#2196F3" Foreground="White"/>
                </StackPanel>
            </Border>

            <!-- 右侧绘制区域 -->
            <Border Grid.Column="1" Background="White">
                <local:WaferCanvas x:Name="waferCanvas" />
            </Border>
        </Grid>
        <Frame x:Name="MainFrame"
               Grid.Row="1" Visibility="{Binding ElementName=menuBar,Path=IsChecked,Converter={StaticResource BoolToVisibilityConverter}}"
               NavigationUIVisibility="Hidden"
               JournalOwnership="OwnsJournal"/>
        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#EAEAEA" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="txtHoveredIndex" Text="当前悬浮: 无" FontWeight="SemiBold" Foreground="#333"/>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="txtInfo" Text="操作提示: 滚轮缩放 | 左键点击/拖拽选择 | Ctrl多选 | 右键重置" Foreground="#666"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>