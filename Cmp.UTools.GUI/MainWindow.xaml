<Window x:Class="Cmp.UTools.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Cmp.UTools.GUI" xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="960">
    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="12 5 2 5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0" LastChildFill="False" Background="#283593">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse Width="40" Height="40" Fill="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="White" Opacity="0.6"/>
                    </Ellipse.Stroke>
                </Ellipse>
            </StackPanel>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6,0,12,0" Height="80">
                <TextBlock Text="文件格式转换器" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}" Margin="10 10 5 2"/>
                <TextBlock Text="Convert between Excel/CSV/JSON/XML/Config" FontSize="12" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" x:Name="SysTime" 
                           Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}" HorizontalAlignment="Right" Margin="10 5" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0 5 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="6">
                <Label Content="选择文件:" VerticalAlignment="Center" />
                <TextBox Text="{Binding InputPath}" Width="420" Margin="6,5" Style="{StaticResource MaterialDesignOutlinedTextBox}" IsReadOnly="True"/>
                <Button Content="..."  Command="{Binding BrowseFileCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6,7,0,7" />
                <ComboBox ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding SelectedTargetFormat}" Width="100" Margin="6" Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                <Button Content="预览" Command="{Binding PreviewCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="6" />
                <Button Content="转换" Command="{Binding ConvertCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="6" />
            </StackPanel>


            <Border Grid.Row="1" BorderBrush="#2e2e2e" BorderThickness="1">
                <DataGrid  AutoGenerateColumns="False" ItemsSource="{Binding PreviewTable}" IsReadOnly="True" CanUserAddRows="False" Foreground="Black"
                           VirtualizingPanel.IsVirtualizing="True"  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                           RowHeight="30"
                           RowBackground="White" AlternationCount="2" AlternatingRowBackground="#f5f5f5"/>
                <!--<RichTextBox Grid.Row="2" Margin="6" Height="120" IsReadOnly="True" Name="LogBox" />-->
            </Border>

            <Border VerticalAlignment="Bottom" Background="{DynamicResource PrimaryHueMidBrush}"  Grid.Row="2" Margin="0 6 0 0" Padding="0 15">

                <StackPanel Margin="10 5">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White">
                        <Run Text="选中文件：" Foreground="White" FontSize="12" />
                        <Run Text="{ Binding InputPath }" Foreground="White" FontSize="12" />
                        <Run Text="| 转换类型" Foreground="White" FontSize="12" />
                        <Run Text="{ Binding SelectedTargetFormat}" Foreground="White" FontSize="12" />
                        <Run Text="| 总记录：" Foreground="White" FontSize="12" />
                        <Run Text="{ Binding TotalRecords }" Foreground="White" FontSize="12" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Run Text="© 2024 Cmp.UTools.GUI. All rights reserved." Foreground="White" FontSize="12" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
