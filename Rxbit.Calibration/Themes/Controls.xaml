<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Rxbit.Calibration.Controls"
                    xmlns:conv="clr-namespace:Rxbit.Calibration.Core"
                    xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <!-- ================= 转换器 ================= -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:EqToBoolConverter x:Key="EqToBool" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:PageKeyToCheckedConverter x:Key="PageKeyToChecked" />
    <conv:BoolToOnOffConverter x:Key="BoolToOnOff" />

    <!-- ================= 基础文字 ================= -->
    <!-- 注意：不强制设置 Foreground，让窗口根节点继承白色；
         否则会覆盖卡片内部深色按钮的文字颜色 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= SciCard 深灰卡片 ================= -->
    <Style TargetType="{x:Type ctl:SciCard}">
        <Setter Property="Padding" Value="16,16,16,16" />
        <Setter Property="CornerRadiusValue" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SciCard}">
                    <Border CornerRadius="{TemplateBinding CornerRadiusValue}"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderDimBrush}"
                            BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 运行模式渐变圆形按钮 ================= -->
    <Style x:Key="RunModeButton" TargetType="Button">
        <Setter Property="Width" Value="110" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="24" Background="{DynamicResource PrimaryGradientBrush}">
                        <Border.Effect><DropShadowEffect Color="#6366F1" BlurRadius="22" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 浅描边扁按钮（手动参数/自动参数切换、翻页箭头） ================= -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Foreground" Value="#B8C0D4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="18" Background="#1C1F2E"
                            BorderBrush="#454B68" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7B61FF" />
                            <Setter Property="Foreground" Value="#E0E4FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 翻页箭头圆胶囊按钮 -->
    <Style x:Key="PagerArrow" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="20" Background="#252838"
                            BorderBrush="#454B68" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7B61FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 获取请求码/紫蓝渐变按钮 ================= -->
    <Style x:Key="GradientButton" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource PrimaryGradientBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= iOS 风格开关 ToggleSwitch ================= -->
    <Style x:Key="IosToggleSwitch" TargetType="ctl:ToggleSwitch">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:ToggleSwitch">
                    <Border x:Name="Track" Width="52" Height="28" CornerRadius="14"
                            Background="#3E4462">
                        <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,3,0,0">
                            <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.3" /></Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#7B61FF" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,3,3,0" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsOn" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="#3E4462" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,3,0,0" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 侧边导航图标按钮 ================= -->
    <Style x:Key="SideNavItem" TargetType="RadioButton">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Foreground" Value="#6B7190" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Rectangle x:Name="AccentBar" Width="3" Height="0" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Fill="{DynamicResource NavAccentBrush}" RadiusX="1.5" RadiusY="1.5" />
                        <Border x:Name="HoverBg" CornerRadius="8" Background="Transparent" Margin="4,4,4,4" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverBg" Property="Background" Value="#2A2D42" />
                            <Setter TargetName="AccentBar" Property="Height" Value="28" />
                            <Setter Property="Foreground" Value="#F2F4FF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Background" Value="#2A2D42" />
                            <Setter Property="Foreground" Value="#B8C0D4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 表格样式 ================= -->
    <Style x:Key="IoTableHeader" TargetType="Border">
        <Setter Property="Background" Value="#2A2D42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>

    <Style x:Key="IoRowCell" TargetType="Border">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- 翻页箭头 -->
    <Style x:Key="PageArrowLeft" TargetType="Button" BasedOn="{StaticResource PagerArrow}">
        <Setter Property="Content">
            <Setter.Value>
                <Path Data="M8,2 L2,10 L8,18" Stroke="#B8C0D4" StrokeThickness="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageArrowRight" TargetType="Button" BasedOn="{StaticResource PagerArrow}">
        <Setter Property="Content">
            <Setter.Value>
                <Path Data="M2,2 L8,10 L2,18" Stroke="#B8C0D4" StrokeThickness="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 授权弹窗输入格 ================= -->
    <Style x:Key="AuthDigit" TargetType="TextBox">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F2F4FF" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8" Background="#2A2D42"
                            BorderBrush="#363A4F" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7B61FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 扁平输入框（轴数值） ================= -->
    <Style x:Key="AxisNumberBox" TargetType="TextBox">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#F2F4FF" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="#2A2D42"
                            BorderBrush="#363A4F" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7B61FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 轴手动控制 +/- 按钮 ================= -->
    <Style x:Key="AxisStepButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#D6DBEC" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="#2A2D42"
                            BorderBrush="#363A4F" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7B61FF" />
                            <Setter Property="Foreground" Value="#E0E4FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 下拉框 ================= -->
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#D6DBEC" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="14,8" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2D42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="#F2F4FF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="8" Background="#2A2D42"
                                            BorderBrush="#363A4F" BorderThickness="1">
                                        <Grid>
                                            <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path HorizontalAlignment="Right" Margin="0,0,12,0"
                                                  Data="M0,0 L7,0 L3.5,4 Z" Fill="#9CA3B8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,0" Background="#252838" BorderBrush="#363A4F" BorderThickness="1" CornerRadius="8">
                                <Border.Effect><DropShadowEffect Color="#000" BlurRadius="16" ShadowDepth="4" Opacity="0.6" /></Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 底部状态栏样式 ================= -->
    <Style x:Key="StatusChip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#6B7190" />
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>

</ResourceDictionary>
