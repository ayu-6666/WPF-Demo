<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 基础色板 ============ -->
    <!-- 主背景：均匀深灰蓝 -->
    <Color x:Key="BgDeepColor">#181B28</Color>
    <Color x:Key="BgColor">#1C1F2E</Color>
    <Color x:Key="BgLighterColor">#22253A</Color>

    <!-- 卡片背景 -->
    <Color x:Key="CardBgColor">#252838</Color>
    <Color x:Key="CardBgSoftColor">#2A2D42</Color>

    <!-- 主题色：紫蓝渐变 -->
    <Color x:Key="PurpleColor">#7B61FF</Color>
    <Color x:Key="BlueAccentColor">#4A8CFF</Color>
    <Color x:Key="CyanAccentColor">#5AC8FA</Color>
    <Color x:Key="TealColor">#10B981</Color>

    <!-- 边框 -->
    <Color x:Key="BorderDimColor">#363A4F</Color>
    <Color x:Key="BorderLightColor">#454B68</Color>

    <!-- 文字 -->
    <Color x:Key="TextMainColor">#F2F4FF</Color>
    <Color x:Key="TextSubColor">#9CA3B8</Color>
    <Color x:Key="TextFaintColor">#6B7190</Color>

    <!-- 状态 -->
    <Color x:Key="OnColor">#7B61FF</Color>
    <Color x:Key="OffColor">#404560</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="WarnColor">#F5B82E</Color>

    <!-- ============ 画刷 ============ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardBgSoftBrush" Color="{StaticResource CardBgSoftColor}" />
    <SolidColorBrush x:Key="CardBgLightBrush" Color="{StaticResource BgLighterColor}" />
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}" />
    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSubColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="BorderDimBrush" Color="{StaticResource BorderDimColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="OnBrush" Color="{StaticResource OnColor}" />
    <SolidColorBrush x:Key="OffBrush" Color="{StaticResource OffColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />

    <!-- 运行模式按钮紫蓝渐变 -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8E7CFF" Offset="0" />
        <GradientStop Color="#6366F1" Offset="0.55" />
        <GradientStop Color="#3B82F6" Offset="1" />
    </LinearGradientBrush>

    <!-- 时间设置 · 左球（深紫渐变） -->
    <RadialGradientBrush x:Key="TimeBallLeftBrush" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#7C5CFF" Offset="0.55" />
        <GradientStop Color="#4B36C4" Offset="1" />
    </RadialGradientBrush>

    <!-- 时间设置 · 右球（浅灰蓝渐变） -->
    <RadialGradientBrush x:Key="TimeBallRightBrush" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#E6EDF8" Offset="0" />
        <GradientStop Color="#C5CFE2" Offset="0.55" />
        <GradientStop Color="#8FA0C0" Offset="1" />
    </RadialGradientBrush>

    <!-- 选中导航左侧竖线 -->
    <SolidColorBrush x:Key="NavAccentBrush" Color="{StaticResource PurpleColor}" />

</ResourceDictionary>
