<UserControl x:Class="Rxbit.Calibration.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rxbit.Calibration.Controls"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             FontFamily="Microsoft YaHei">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="310" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 时间设置卡片 ===== -->
        <ctl:SciCard Grid.Row="0" Grid.Column="0" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左时钟图标 -->
                <Border Width="48" Height="48" Margin="0,0,18,0" CornerRadius="12" Background="#3D3B6F">
                    <md:PackIcon Kind="Clock" Width="26" Height="26" Foreground="#B7ADFD"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 中央哑铃形双球 -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Canvas Grid.Column="1" Width="320" Height="180">
                        <!-- 连接横条（背景层，与球体融为一体） -->
                        <Rectangle Canvas.Left="132" Canvas.Top="82" Width="56" Height="16" Fill="#2A2D42" />
                        <!-- 左球：紫渐变 -->
                        <Ellipse Canvas.Left="30" Canvas.Top="16" Width="140" Height="140" Fill="{DynamicResource TimeBallLeftBrush}" />
                        <!-- 右球：浅灰蓝渐变 -->
                        <Ellipse Canvas.Left="150" Canvas.Top="24" Width="140" Height="140" Fill="{DynamicResource TimeBallRightBrush}" />
                        <!-- 左球高光 -->
                        <Ellipse Canvas.Left="58" Canvas.Top="36" Width="46" Height="30" Fill="#40FFFFFF" />
                        <Ellipse Canvas.Left="178" Canvas.Top="44" Width="46" Height="30" Fill="#40FFFFFF" />
                        <!-- 左球数字 -->
                        <TextBlock Canvas.Left="74" Canvas.Top="54" Text="{Binding WorldTimeText}" FontSize="30"
                                   FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Canvas.Left="76" Canvas.Top="94" Text="{Binding WorldLabel}" FontSize="11"
                                   Foreground="#D4CCFF" />
                        <!-- 右球数字 -->
                        <TextBlock Canvas.Left="186" Canvas.Top="54" Text="{Binding BeijingTimeText}" FontSize="30"
                                   FontWeight="Bold" Foreground="#3A4058" />
                        <TextBlock Canvas.Left="188" Canvas.Top="94" Text="{Binding BeijingLabel}" FontSize="11"
                                   Foreground="#5A6380" />
                    </Canvas>
                </Grid>

                <!-- 右上日期 -->
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding TimeDate}"
                           FontSize="13" Foreground="#6B7190" />
            </Grid>
        </ctl:SciCard>

        <!-- ===== 监视界面卡片（跨两行在右侧） ===== -->
        <ctl:SciCard Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="64" Height="64" CornerRadius="16" Background="#2A2D42" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <md:PackIcon Kind="Eye" Width="32" Height="32" Foreground="#9CA3B8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Row="0" Style="{StaticResource RunModeButton}" Content="运行模式"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Command="{Binding RunModeCommand}" Margin="0,0,0,20" />
                <TextBlock Grid.Row="1" Text="Monitoring interface  监视界面"
                           FontSize="14" Foreground="#9CA3B8" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </Grid>
        </ctl:SciCard>

        <!-- ===== 第二行容器：3 列 ===== -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 输入界面 ===== -->
            <ctl:SciCard Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2A2D42" Margin="0,0,14,0">
                            <md:PackIcon Kind="Pencil" Width="22" Height="22" Foreground="#9CA3B8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Input interface" FontSize="12" Foreground="#6B7190" />
                            <TextBlock Text="输入界面" FontSize="16" FontWeight="Bold" Foreground="#F2F4FF" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ctl:ToggleSwitch Style="{StaticResource IosToggleSwitch}" IsOn="{Binding InputIsOn, Mode=TwoWay}" />
                        <TextBlock Text="{Binding InputIsOn, Converter={StaticResource BoolToOnOff}}" FontSize="12"
                                   Foreground="#7B61FF" HorizontalAlignment="Right" Margin="0,6,2,0" />
                    </StackPanel>
                </Grid>
            </ctl:SciCard>

            <!-- ===== 输出界面 ===== -->
            <ctl:SciCard Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2A2D42" Margin="0,0,14,0">
                            <md:PackIcon Kind="PowerPlug" Width="22" Height="22" Foreground="#9CA3B8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Output interface" FontSize="12" Foreground="#6B7190" />
                            <TextBlock Text="输出界面" FontSize="16" FontWeight="Bold" Foreground="#F2F4FF" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ctl:ToggleSwitch Style="{StaticResource IosToggleSwitch}" IsOn="{Binding OutputIsOn, Mode=TwoWay}" />
                        <TextBlock Text="{Binding OutputIsOn, Converter={StaticResource BoolToOnOff}}" FontSize="12"
                                   Foreground="#6B7190" HorizontalAlignment="Right" Margin="0,6,2,0" />
                    </StackPanel>
                </Grid>
            </ctl:SciCard>

            <!-- ===== 报警信息 ===== -->
            <ctl:SciCard Grid.Row="0" Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2A2D42" Margin="0,0,16,0">
                            <md:PackIcon Kind="Bell" Width="22" Height="22" Foreground="#F5B82E"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Alarm information" FontSize="12" Foreground="#6B7190" />
                            <TextBlock Text="报警信息" FontSize="16" FontWeight="Bold" Foreground="#F2F4FF" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical" Margin="0,0,36,0">
                            <TextBlock Text="报警数量：" FontSize="14" Foreground="#D6DBEC" HorizontalAlignment="Right" />
                            <TextBlock Text="报警代码：" FontSize="14" Foreground="#D6DBEC" HorizontalAlignment="Right" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding AlarmCount}" FontSize="18" FontWeight="Bold" Foreground="#F5B82E" />
                            <TextBlock Text="{Binding AlarmCode}" FontSize="18" FontWeight="Bold" Foreground="#F5B82E" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ctl:SciCard>
        </Grid>
    </Grid>
</UserControl>
