<Window x:Class="Rxbit.Calibration.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:vm="clr-namespace:Rxbit.Calibration.ViewModels"
        xmlns:v="clr-namespace:Rxbit.Calibration.Views"
        Title="Rxbit Calibration" Width="1600" Height="900" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBgBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei"
        Foreground="{DynamicResource TextMainBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OutputViewModel}"><v:OutputView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManualParamsViewModel}"><v:ManualParamsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoParamsViewModel}"><v:AutoParamsView /></DataTemplate>
    </Window.Resources>

    <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ========== 左侧导航 ========== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="#181B28">
            <Border.BorderBrush>
                <SolidColorBrush Color="#272A3E" />
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Left="0" Top="0" Right="1" Bottom="0" />
            </Border.BorderThickness>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0" ItemsSource="{Binding SideNavs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SideNavItem}"
                                         DataContext="{Binding}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource PageKeyToChecked}" Mode="TwoWay">
                                        <Binding Path="DataContext.CurrentPageKey" RelativeSource="{RelativeSource AncestorType=Window}" Mode="OneWay" />
                                        <Binding Path="Key" Mode="OneTime" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <md:PackIcon Kind="{Binding Icon}" Width="22" Height="22" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 底部头像（点击弹用户信息） -->
                <Button Grid.Row="1" Height="56" Margin="8" Background="#1E2132" BorderThickness="0"
                        Cursor="Hand" Command="{Binding ShowUserInfoCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <Grid>
                                    <Ellipse Width="32" Height="32" Fill="#363A4F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <md:PackIcon Kind="Account" Width="20" Height="20" Foreground="#6B7190"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ========== 顶部栏 ========== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：Logo + 公司名 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <Border Width="36" Height="36" CornerRadius="8" Background="#2A2D42" Margin="0,0,14,0">
                    <md:PackIcon Kind="Cog" Width="20" Height="20" Foreground="#7B61FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding LogoTitle}" FontSize="18" FontWeight="Bold" Foreground="#F2F4FF" />
                    <TextBlock Text="{Binding Company}" FontSize="11" Foreground="#6B7190" />
                </StackPanel>
            </StackPanel>

            <!-- 右：时间胶囊 + 手动/自动按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Border Height="32" CornerRadius="16" Background="#252838" BorderBrush="#363A4F" BorderThickness="1" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TimeLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#F2F4FF" />
                        <TextBlock Text="  " FontSize="14" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="13" Foreground="#9CA3B8" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource OutlineButton}" Content="手动参数" Margin="14,0,0,0"
                        Command="{Binding ShowManualParamsCommand}" />
                <Button Style="{StaticResource OutlineButton}" Content="自动参数" Margin="10,0,0,0"
                        Command="{Binding ShowAutoParamsCommand}" />

                <!-- 最小化 -->
                <Button Width="34" Height="34" Margin="16,0,0,0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Command="{Binding MinimizeCommand}" ToolTip="最小化">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="17">
                                <Path Data="M11,17 L23,17" Stroke="#9CA3B8" StrokeThickness="2" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#888dacff" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 最大化 / 还原 -->
                <Button Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Command="{Binding ToggleMaximizeCommand}" ToolTip="最大化">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="17">
                                <Grid>
                                    <Path x:Name="IconMax" Data="M12,9 L22,9 L22,19 L12,19 Z"
                                          Stroke="#9CA3B8" StrokeThickness="1.8" />
                                    <Path x:Name="IconRestore" Data="M14,11 L21,11 L21,18 L14,18 Z M11,14 L18,14 L18,21 L11,21 Z"
                                          Stroke="#9CA3B8" StrokeThickness="1.5" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#888dacff" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                    <Setter TargetName="IconMax" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="IconRestore" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 关闭 -->
                <Button Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Command="{Binding ExitCommand}" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="17">
                                <Path Data="M11,11 L23,23 M23,11 L11,23" Stroke="#D6DBEC" StrokeThickness="2" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#C0392B" />
                                    <Setter TargetName="Border" Property="CornerRadius" Value="17" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== 内容区 ========== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="22,12,22,8" />

        <!-- ========== 底部状态栏 ========== -->
        <Grid Grid.Row="2" Grid.Column="1" Background="#181B28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="X Axis:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.X}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,32,0" />
                <TextBlock Text="Y Axis:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.Y}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,32,0" />
                <TextBlock Text="Z Axis:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.Z}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="A Axis:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.A}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,32,0" />
                <TextBlock Text="B Axis:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.B}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <TextBlock Text="主轴:" Style="{StaticResource StatusChip}" />
                <TextBlock Text="{Binding Status.Spindle}" FontSize="13" Foreground="#F2F4FF" Margin="-12,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ========== 授权弹窗 Overlay ========== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ZIndex="99"
              Visibility="{Binding ShowAuthorizeDialog, Converter={StaticResource BoolToVis}}"
              Background="#88000000">
            <Border Width="420" HorizontalAlignment="Right" Margin="24,84,24,0" CornerRadius="14"
                    Background="#252838" BorderBrush="#363A4F" BorderThickness="1">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 下拉框 + 关闭 -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}" />
                        <Button Grid.Column="1" Width="28" Height="28" Margin="12,0,0,0"
                                Command="{Binding CloseAuthorizeCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#9CA3B8" StrokeThickness="1.6" />
                        </Button>
                    </Grid>

                    <!-- 请求码标签 -->
                    <TextBlock Grid.Row="1" Text="请求码" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F2F4FF" Margin="0,0,0,10" />

                    <!-- 请求码 4 格 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,22">
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding RequestCodeSlot0}" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding RequestCodeSlot1}" Margin="10,0,0,0" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding RequestCodeSlot2}" Margin="10,0,0,0" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding RequestCodeSlot3}" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 授权码标签 -->
                    <TextBlock Grid.Row="3" Text="授权码" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F2F4FF" Margin="0,0,0,10" />

                    <!-- 授权码 5 格 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,22">
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding AuthCodeSlot0}" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding AuthCodeSlot1}" Margin="10,0,0,0" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding AuthCodeSlot2}" Margin="10,0,0,0" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding AuthCodeSlot3}" Margin="10,0,0,0" />
                        <TextBox Style="{StaticResource AuthDigit}" Text="{Binding AuthCodeSlot4}" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 获取请求码按钮 -->
                    <Button Grid.Row="5" Style="{StaticResource GradientButton}" Content="获取请求码"
                            HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 用户信息弹窗 Overlay ========== -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" ZIndex="100"
              Visibility="{Binding ShowUserInfo, Converter={StaticResource BoolToVis}}"
              Background="#88000000">
            <Border Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
                    Background="#252838" BorderBrush="#363A4F" BorderThickness="1" Padding="24,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 + 关闭 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="用户信息" FontSize="16" FontWeight="Bold" Foreground="#F2F4FF"
                                   VerticalAlignment="Center" />
                        <Button Width="28" Height="28" HorizontalAlignment="Right"
                                Command="{Binding CloseUserInfoCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="M9,9 L19,19 M19,9 L9,19" Stroke="#9CA3B8" StrokeThickness="1.6" />
                        </Button>
                    </Grid>

                    <!-- 头像 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#363A4F">
                            <md:PackIcon Kind="Account" Width="36" Height="36" Foreground="#9CA3B8"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding UserName}" FontSize="18" FontWeight="Bold" Foreground="#F2F4FF"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- 信息行 -->
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="角色" FontSize="13" Foreground="#6B7190" />
                            <TextBlock Text="{Binding UserRole}" FontSize="13" Foreground="#D6DBEC" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="权限等级" FontSize="13" Foreground="#6B7190" />
                            <TextBlock Text="{Binding UserLevel}" FontSize="13" Foreground="#D6DBEC" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="登录时间" FontSize="13" Foreground="#6B7190" />
                            <TextBlock Text="{Binding UserLoginTime}" FontSize="13" Foreground="#D6DBEC" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
