<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  视频页文案（中文）  -->
    <sys:String x:Key="Tab_Image">图像</sys:String>
    <sys:String x:Key="Tab_Video">视频</sys:String>

    <sys:String x:Key="Video_Title">视频处理</sys:String>
    <sys:String x:Key="Video_Subtitle">离线本地处理 · 不联网</sys:String>

    <sys:String x:Key="Engine_Header">处理引擎</sys:String>
    <sys:String x:Key="Engine_Label">FFmpeg 路径</sys:String>
    <sys:String x:Key="Engine_Browse">浏览</sys:String>
    <sys:String x:Key="Engine_Redetect">重新检测</sys:String>
    <sys:String x:Key="Engine_NotSet">未检测到 ffmpeg.exe，请点击“浏览”指定本地路径。</sys:String>
    <sys:String x:Key="Engine_Hint">运行时仅调用本地 ffmpeg/ffprobe，不访问网络。</sys:String>

    <sys:String x:Key="Source_Header">视频素材</sys:String>
    <sys:String x:Key="Source_Open">打开视频</sys:String>
    <sys:String x:Key="Source_Output">输出目录</sys:String>
    <sys:String x:Key="Source_None">未选择视频</sys:String>
    <sys:String x:Key="Source_Info">源文件信息</sys:String>

    <sys:String x:Key="Function_Header">处理功能</sys:String>
    <sys:String x:Key="Param_Header">参数设置</sys:String>
    <sys:String x:Key="Start">开始处理</sys:String>
    <sys:String x:Key="Cancel">取消</sys:String>
    <sys:String x:Key="Progress_Label">进度</sys:String>
    <sys:String x:Key="Status_Label">状态</sys:String>

    <sys:String x:Key="Preview_Header">预览</sys:String>
    <sys:String x:Key="Preview_Empty">选择视频后显示首帧预览</sys:String>
    <sys:String x:Key="Info_Resolution">分辨率</sys:String>
    <sys:String x:Key="Info_Duration">时长</sys:String>
    <sys:String x:Key="Info_Fps">帧率</sys:String>
    <sys:String x:Key="Info_Audio">音轨</sys:String>
    <sys:String x:Key="Info_Yes">有</sys:String>
    <sys:String x:Key="Info_No">无</sys:String>

    <sys:String x:Key="Output_Header">输出</sys:String>
    <sys:String x:Key="Output_Path">输出路径</sys:String>
    <sys:String x:Key="Output_Elapsed">耗时</sys:String>

    <sys:String x:Key="Fn_Enhance">高清修复</sys:String>
    <sys:String x:Key="Fn_Mosaic">去码（马赛克弱化）</sys:String>
    <sys:String x:Key="Fn_Watermark">去水印</sys:String>
    <sys:String x:Key="Fn_Compose">多视频合成</sys:String>
    <sys:String x:Key="Fn_Concat">视频拼接</sys:String>
    <sys:String x:Key="Fn_M3u8">M3U8 转 MP4</sys:String>
    <sys:String x:Key="Fn_Audio">提取音轨</sys:String>
    <sys:String x:Key="Fn_Trim">分段裁剪</sys:String>
    <sys:String x:Key="Fn_Gif">GIF 生成</sys:String>

    <sys:String x:Key="Param_Scale">放大倍数</sys:String>
    <sys:String x:Key="Param_Denoise">降噪强度</sys:String>
    <sys:String x:Key="Param_Sharpen">锐化强度</sys:String>
    <sys:String x:Key="Param_Temporal">时域融合帧数</sys:String>

    <sys:String x:Key="Hint_Enhance">纯滤镜方案：Lanczos 放大 + HQDN3D 降噪 + Unsharp 锐化。未使用超分模型，放大后的细节是插值结果，清晰度上限受源片限制。</sys:String>
    <sys:String x:Key="Hint_Mosaic">去噪 + 锐化 + 时域融合的近似弱化，只能降低块状观感，并非真实重建，被抹除的信息无法恢复。</sys:String>
    <sys:String x:Key="Hint_Watermark">在右侧预览上拖拽框选区域（可添加多个），使用 delogo 滤波逐帧插值覆盖；不重建被遮挡内容。</sys:String>
    <sys:String x:Key="Hint_Compose">以第一个视频为基准，自动统一分辨率、帧率与像素格式；并排或画中画布局，输出保留第一个视频的音轨。</sys:String>
    <sys:String x:Key="Hint_Concat">按列表顺序无缝拼接，自动归一化分辨率/帧率/像素格式；拼接输出为静音视频。</sys:String>
    <sys:String x:Key="Hint_M3u8">选择本地 m3u8 播放列表（支持相对路径 ts 分片），优先无损转封装，失败时自动重编码。若分片使用远程密钥加密，则离线无法解密。</sys:String>
    <sys:String x:Key="Hint_Audio">仅导出音轨，不重新编码视频；导出格式与码率可调。</sys:String>
    <sys:String x:Key="Hint_Trim">快速模式直接复制码流，起点会对齐到关键帧；精确模式重编码，起点按时间精确定位。</sys:String>

    <sys:String x:Key="Roi_Tip">在此拖拽框选水印区域</sys:String>
    <sys:String x:Key="Roi_Clear">清除区域</sys:String>
    <sys:String x:Key="Roi_Empty">尚未框选区域，默认使用右下角 30% 区域</sys:String>
    <sys:String x:Key="Roi_Count">已框选 {0} 个区域</sys:String>

    <sys:String x:Key="Compose_Second">第二个视频</sys:String>
    <sys:String x:Key="Compose_Pick">选择文件</sys:String>
    <sys:String x:Key="Compose_None">未选择第二个视频</sys:String>
    <sys:String x:Key="Compose_Layout">布局</sys:String>
    <sys:String x:Key="Compose_Side">并排</sys:String>
    <sys:String x:Key="Compose_Pip">画中画</sys:String>
    <sys:String x:Key="Compose_PipPos">画中画位置</sys:String>
    <sys:String x:Key="Compose_PipScale">画中画比例</sys:String>
    <sys:String x:Key="Compose_PosTL">左上</sys:String>
    <sys:String x:Key="Compose_PosTR">右上</sys:String>
    <sys:String x:Key="Compose_PosBL">左下</sys:String>
    <sys:String x:Key="Compose_PosBR">右下</sys:String>

    <sys:String x:Key="Concat_Add">添加视频</sys:String>
    <sys:String x:Key="Concat_Empty">列表为空，按顺序添加待拼接视频</sys:String>
    <sys:String x:Key="Concat_Remove">移除</sys:String>

    <sys:String x:Key="Audio_Format">音频格式</sys:String>
    <sys:String x:Key="Audio_Bitrate">码率</sys:String>
    <sys:String x:Key="Audio_Mp3">MP3</sys:String>
    <sys:String x:Key="Audio_Aac">AAC (M4A)</sys:String>
    <sys:String x:Key="Audio_Wav">WAV (PCM)</sys:String>

    <sys:String x:Key="Trim_Start">起始时间</sys:String>
    <sys:String x:Key="Trim_End">结束时间</sys:String>
    <sys:String x:Key="Trim_Mode">裁剪模式</sys:String>
    <sys:String x:Key="Trim_Fast">快速（关键帧对齐）</sys:String>
    <sys:String x:Key="Trim_Precise">精确（重编码）</sys:String>
    <sys:String x:Key="Trim_ClipLen">片段时长</sys:String>

    <sys:String x:Key="Gif_Fps">GIF 帧率</sys:String>
    <sys:String x:Key="Gif_Width">GIF 宽度</sys:String>
    <sys:String x:Key="Gif_Loop">无限循环</sys:String>
    <sys:String x:Key="Gif_Dither">抖动算法</sys:String>
    <sys:String x:Key="Gif_DitherNone">无</sys:String>
    <sys:String x:Key="Gif_DitherBayer">Bayer</sys:String>
    <sys:String x:Key="Gif_DitherFloyd">Floyd-Steinberg</sys:String>
    <sys:String x:Key="Gif_DitherSierra">Sierra 2-4A</sys:String>
    <sys:String x:Key="Hint_Gif">GIF 只支持 256 色，量化必然有损；已用 palettegen/paletteuse 全局调色板与抖动，尽量做到视觉接近原片。</sys:String>

    <sys:String x:Key="Language_Toggle">EN</sys:String>
    <sys:String x:Key="Busy_Wait">正在处理…</sys:String>
</ResourceDictionary>
