    <sys:String x:Key="Engine_Browse">Browse</sys:String>
    <sys:String x:Key="Engine_Redetect">Re-detect</sys:String>
    <sys:String x:Key="Engine_NotSet">ffmpeg.exe not found. Click Browse to pick a local path.</sys:String>
    <sys:String x:Key="Engine_Hint">Only local ffmpeg/ffprobe is invoked at runtime. No network access.</sys:String>

