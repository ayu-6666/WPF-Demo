    <sys:String x:Key="Fn_Enhance">Enhance</sys:String>
    <sys:String x:Key="Fn_Mosaic">Mosaic Weaken</sys:String>
    <sys:String x:Key="Fn_Watermark">Remove Watermark</sys:String>
    <sys:String x:Key="Fn_Compose">Multi-video Compose</sys:String>
    <sys:String x:Key="Fn_Concat">Concatenate</sys:String>
    <sys:String x:Key="Fn_M3u8">M3U8 to MP4</sys:String>
