    <sys:String x:Key="Compose_PipScale">PiP size</sys:String>
    <sys:String x:Key="Compose_PosTL">Top left</sys:String>
    <sys:String x:Key="Compose_PosTR">Top right</sys:String>
    <sys:String x:Key="Compose_PosBL">Bottom left</sys:String>
    <sys:String x:Key="Compose_PosBR">Bottom right</sys:String>

    <sys:String x:Key="Concat_Add">Add video</sys:String>
    <sys:String x:Key="Concat_Empty">List is empty; add clips in playback order</sys:String>
    <sys:String x:Key="Concat_Remove">Remove</sys:String>

    <sys:String x:Key="Audio_Format">Audio format</sys:String>
    <sys:String x:Key="Audio_Bitrate">Bitrate</sys:String>
    <sys:String x:Key="Audio_Mp3">MP3</sys:String>
    <sys:String x:Key="Audio_Aac">AAC (M4A)</sys:String>
    <sys:String x:Key="Audio_Wav">WAV (PCM)</sys:String>

    <sys:String x:Key="Trim_Start">Start time</sys:String>
    <sys:String x:Key="Trim_End">End time</sys:String>
    <sys:String x:Key="Trim_Mode">Trim mode</sys:String>
    <sys:String x:Key="Trim_Fast">Fast (keyframe aligned)</sys:String>
    <sys:String x:Key="Trim_Precise">Precise (re-encode)</sys:String>
    <sys:String x:Key="Trim_ClipLen">Clip length</sys:String>

    <sys:String x:Key="Gif_Fps">GIF frame rate</sys:String>
    <sys:String x:Key="Gif_Width">GIF width</sys:String>
    <sys:String x:Key="Gif_Loop">Loop forever</sys:String>
    <sys:String x:Key="Gif_Dither">Dithering</sys:String>
    <sys:String x:Key="Gif_DitherNone">None</sys:String>
    <sys:String x:Key="Gif_DitherBayer">Bayer</sys:String>
    <sys:String x:Key="Gif_DitherFloyd">Floyd-Steinberg</sys:String>
    <sys:String x:Key="Gif_DitherSierra">Sierra 2-4A</sys:String>
    <sys:String x:Key="Hint_Gif">GIF is limited to 256 colors, so quantization is inherently lossy. A global palette via palettegen/paletteuse plus dithering keeps it visually close.</sys:String>

    <sys:String x:Key="Language_Toggle">中文</sys:String>
