<UserControl x:Class="Tang.VideoThrimalgoAI.Views.VideoProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="700"
             Background="Transparent"
             FontFamily="Microsoft YaHei"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Foreground" Value="#CBD5E1" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧控制栏 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Video_Title}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="{DynamicResource Video_Subtitle}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Language_Toggle}"
                                Style="{StaticResource GhostButton}" Width="58" Height="30" MinHeight="30"
                                VerticalAlignment="Top" Command="{Binding ToggleLanguageCommand}" />
                    </Grid>

                    <!-- 引擎 -->
                    <TextBlock Text="{DynamicResource Engine_Header}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{DynamicResource Engine_Label}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FfmpegPath, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="NoWrap" Background="#0B1220" Foreground="#E2E8F0"
                             BorderBrush="#334155" Padding="6,5" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Engine_Browse}" Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseFfmpegCommand}" Margin="0,0,4,0" />
                        <Button Content="{DynamicResource Engine_Redetect}" Style="{StaticResource GhostButton}"
                                Command="{Binding RedetectFfmpegCommand}" Margin="4,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="{Binding EngineStatus}" Foreground="#94A3B8" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource Engine_Hint}" Style="{StaticResource HintText}" />

                    <!-- 素材 -->
                    <TextBlock Text="{DynamicResource Source_Header}" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <Button Content="{DynamicResource Source_Open}" Style="{StaticResource GlassButton}"
                                Command="{Binding OpenVideoCommand}" Margin="0,0,4,0" />
                        <Button Content="{DynamicResource Source_Output}" Style="{StaticResource GlassButton}"
                                Command="{Binding OpenOutputFolderCommand}" Margin="4,0,0,0"
                                Background="#14B8A6" BorderBrush="#14B8A6" />
                    </UniformGrid>
                    <TextBlock Text="{Binding SourceFileName}" Foreground="#E2E8F0" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                    <TextBlock Text="{Binding OutputFolder}" Foreground="#64748B" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}" Margin="0,4,0,0" />

                    <!-- 功能 -->
                    <TextBlock Text="{DynamicResource Function_Header}" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding Functions}"
                              SelectedIndex="{Binding SelectedFunctionIndex, Mode=TwoWay}"
                              Background="#0B1220" Foreground="#E2E8F0" />

                    <!-- 参数 -->
                    <TextBlock Text="{DynamicResource Param_Header}" Style="{StaticResource SectionHeader}" />
                    <StackPanel Margin="0,0,0,2">

                        <!-- 高清修复 -->
                        <StackPanel Visibility="{Binding ShowEnhance, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Param_Scale}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedIndex="{Binding SelectedScaleIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Param_Denoise}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Denoise, StringFormat={}{0:F0}}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Denoise, Mode=TwoWay}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Param_Sharpen}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Sharpen, StringFormat={}{0:F0}}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Sharpen, Mode=TwoWay}" />

                            <TextBlock Text="{DynamicResource Hint_Enhance}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- 去码 -->
                        <StackPanel Visibility="{Binding ShowMosaic, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Param_Denoise}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Denoise, StringFormat={}{0:F0}}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Denoise, Mode=TwoWay}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Param_Sharpen}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Sharpen, StringFormat={}{0:F0}}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Sharpen, Mode=TwoWay}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Param_Temporal}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding TemporalFrames, StringFormat={}{0:F0}}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="5" Value="{Binding TemporalFrames, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" />

                            <TextBlock Text="{DynamicResource Hint_Mosaic}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- 去水印 -->
                        <StackPanel Visibility="{Binding ShowWatermark, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Roi_Tip}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding RoiSummary}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="{DynamicResource Roi_Clear}" Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearRegionsCommand}" HorizontalAlignment="Left" />
                            <ItemsControl ItemsSource="{Binding WatermarkRegions}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{DynamicResource Concat_Remove}"
                                                        Style="{StaticResource GhostButton}" Height="26" MinHeight="26" Padding="8,0"
                                                        Command="{Binding DataContext.RemoveRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Hint_Watermark}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- 合成 -->
                        <StackPanel Visibility="{Binding ShowCompose, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Compose_Second}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SecondVideoName}" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SecondVideoPath}" Margin="0,0,0,6" />
                            <Button Content="{DynamicResource Compose_Pick}" Style="{StaticResource GhostButton}"
                                    Command="{Binding ChooseSecondVideoCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

                            <TextBlock Text="{DynamicResource Compose_Layout}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedIndex="{Binding SelectedLayoutIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,12" />

                            <StackPanel Visibility="{Binding IsPipLayout, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Compose_PipPos}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PipPositionOptions}" SelectedIndex="{Binding SelectedPipPositionIndex, Mode=TwoWay}"
                                          Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="{DynamicResource Compose_PipScale}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding PipScale, StringFormat={}{0:F0}%}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="15" Maximum="60" Value="{Binding PipScale, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Hint_Compose}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- 拼接 -->
                        <StackPanel Visibility="{Binding ShowConcat, Converter={StaticResource BoolToVis}}">
                            <Button Content="{DynamicResource Concat_Add}" Style="{StaticResource GlassButton}"
                                    Command="{Binding AddConcatVideosCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding ConcatSummary}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ConcatFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#CBD5E1"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{DynamicResource Concat_Remove}"
                                                        Style="{StaticResource GhostButton}" Height="26" MinHeight="26" Padding="8,0"
                                                        Command="{Binding DataContext.RemoveConcatVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Hint_Concat}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- M3U8 -->
                        <StackPanel Visibility="{Binding ShowM3u8, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Hint_M3u8}" Style="{StaticResource HintText}" Margin="0" />
                        </StackPanel>

                        <!-- 音轨 -->
                        <StackPanel Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Audio_Format}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding AudioFormatOptions}" SelectedIndex="{Binding SelectedAudioFormatIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,12" />

                            <TextBlock Text="{DynamicResource Audio_Bitrate}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedIndex="{Binding SelectedBitrateIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" />
                            <TextBlock Text="{DynamicResource Hint_Audio}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- 裁剪 -->
                        <StackPanel Visibility="{Binding ShowTrim, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Trim_Start}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding StartTimeText}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{Binding TrimMaximum}" Value="{Binding StartSeconds, Mode=TwoWay}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Trim_End}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding EndTimeText}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{Binding TrimMaximum}" Value="{Binding EndSeconds, Mode=TwoWay}" Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource Trim_Mode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TrimModeOptions}" SelectedIndex="{Binding SelectedTrimModeIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,8" />

                            <TextBlock Foreground="#94A3B8">
                                <Run Text="{DynamicResource Trim_ClipLen}" />
                                <Run Text="：" />
                                <Run Text="{Binding ClipLengthText, Mode=OneWay}" Foreground="#93C5FD" />
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Hint_Trim}" Style="{StaticResource HintText}" />
                        </StackPanel>

                        <!-- GIF -->
                        <StackPanel Visibility="{Binding ShowGif, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Gif_Fps}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding GifFps, StringFormat={}{0:F0} fps}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="3" Maximum="30" Value="{Binding GifFps, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{DynamicResource Gif_Width}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding GifWidth, StringFormat={}{0:F0} px}" Foreground="#93C5FD" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="120" Maximum="1280" Value="{Binding GifWidth, Mode=TwoWay}" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource Gif_Dither}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DitherOptions}" SelectedIndex="{Binding SelectedDitherIndex, Mode=TwoWay}"
                                      Background="#0B1220" Foreground="#E2E8F0" Margin="0,0,0,10" />

                            <CheckBox Content="{DynamicResource Gif_Loop}" IsChecked="{Binding GifLoop, Mode=TwoWay}"
                                      Foreground="#CBD5E1" />
                            <TextBlock Text="{DynamicResource Hint_Gif}" Style="{StaticResource HintText}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- 执行区固定在底部，避免随参数滚动被裁切 -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <!-- 执行 -->
                    <Button Content="{DynamicResource Start}" Style="{StaticResource GlassButton}"
                            Command="{Binding StartCommand}" MinHeight="42" Margin="0,6,0,10"
                            Background="#22C55E" BorderBrush="#22C55E" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Height="6" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="{DynamicResource Cancel}" Style="{StaticResource GhostButton}"
                                Command="{Binding CancelCommand}" Width="70" Height="30" MinHeight="30" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding ProgressText}" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右侧预览 ==================== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Preview_Header}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="{Binding SourceFileName}" Foreground="#94A3B8" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1" x:Name="PreviewHost" Background="#020817" CornerRadius="12"
                        BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{DynamicResource Preview_Empty}" Foreground="#475569" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="RoiCanvas" Background="Transparent" />
                        <Border Background="#CC0F172A" CornerRadius="6" Padding="8,4"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                IsHitTestVisible="False"
                                Visibility="{Binding ShowWatermark, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Roi_Tip}" Foreground="#E2E8F0" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,12,0,0">
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Info_Resolution}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding ResolutionText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Info_Duration}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding DurationText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Info_Fps}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding FpsText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Info_Audio}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding AudioText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Output_Path}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding OutputPath}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Output_Elapsed}" Foreground="#94A3B8" />
                            <TextBlock Text="{Binding ElapsedText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
