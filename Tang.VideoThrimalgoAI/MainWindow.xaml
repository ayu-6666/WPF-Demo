<Window x:Class="Tang.VideoThrimalgoAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Tang.VideoThrimalgoAI.Views"
        Title="Tang.VideoThrimalgoAI" Height="920" Width="1500"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0F172A"
        TextElement.Foreground="#E2E8F0"
        TextElement.FontFamily="Microsoft YaHei"
        TextElement.FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!--  统一按钮规格：固定最小高度、内边距、字号与居中对齐，文字不换行不裁切  -->
        <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        </Style>

        <!--  自绘标题栏按钮  -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  顶部 Tab：图像 / 视频  -->
        <Style x:Key="WorkbenchTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="#0B1220" BorderBrush="#334155"
                                BorderThickness="0,0,0,1" Padding="16,10,16,0">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkbenchTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8,8,0,0" Padding="18,8,18,0">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                <Border x:Name="Underline" Height="2" Background="Transparent" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#111827" />
                                <Setter TargetName="Underline" Property="Background" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 自绘标题栏 ==================== -->
        <Border Grid.Row="0" Background="#0B1220" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Tang.VideoThrimalgoAI" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <TextBlock Text="图像 / 视频修复智能工作台" FontSize="12" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}"
                            ToolTip="最小化" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}"
                            ToolTip="最大化 / 还原" Click="OnMaximizeRestoreClick" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}"
                            ToolTip="关闭" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="WorkbenchTabs" Grid.Row="1" Style="{StaticResource WorkbenchTabControl}" SelectedIndex="0">
            <TabItem Header="{DynamicResource Tab_Image}" Style="{StaticResource WorkbenchTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ==================== 主内容区 ==================== -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

            <!-- 左侧：处理控制 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="处理控制" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14" />

                        <TextBlock Text="修复模式" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ProcessingModes}"
                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  Margin="0,0,0,4"
                                  Background="#0B1220"
                                  Foreground="#E2E8F0" />

                        <TextBlock Text="修复强度（降噪 + 多尺度细节重建）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding RepairPresets}"
                                  SelectedItem="{Binding SelectedRepairPreset, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  Background="#0B1220"
                                  Foreground="#E2E8F0" />
                        <CheckBox Content="2x 放大（纯算法翻倍；启用超分模型时输出 2x）"
                                  IsChecked="{Binding Upscale2x, Mode=TwoWay}"
                                  Foreground="#CBD5E1" Margin="0,0,0,4" />
                        <TextBlock Text="超分模型（本地 ONNX 离线推理，不联网）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding SuperResolutionModels}"
                                  SelectedItem="{Binding SelectedSuperResolutionModel, Mode=TwoWay}"
                                  Margin="0,0,0,4"
                                  Background="#0B1220"
                                  Foreground="#E2E8F0" />
                        <TextBlock Text="{Binding SuperResolutionStatusText}"
                                   FontSize="11" Foreground="#7DD3FC" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="高清修复 = 保边降噪 + 细节重建 + 温和色调；启用超分模型时由本地 AI 模型重建细节（4x）"
                                   FontSize="11" Foreground="#7DD3FC" TextWrapping="Wrap" Margin="0,0,0,2" />

                        <TextBlock Text="参数调节" Style="{StaticResource SectionHeader}" />

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="亮度" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding BrightnessValue, StringFormat={}{0:F0}}"
                                       Foreground="#93C5FD" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" Value="{Binding BrightnessValue, Mode=TwoWay}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="对比度" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ContrastValue, StringFormat={}{0:F2}}"
                                       Foreground="#93C5FD" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0.5" Maximum="2.0" Value="{Binding ContrastValue, Mode=TwoWay}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="锐度" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding SharpnessValue, StringFormat={}{0:F2}}"
                                       Foreground="#93C5FD" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0.5" Maximum="2.5" Value="{Binding SharpnessValue, Mode=TwoWay}" />

                        <TextBlock Text="图像来源" Style="{StaticResource SectionHeader}" />
                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="打开图片"
                                    Style="{StaticResource GlassButton}"
                                    Command="{Binding OpenImageCommand}"
                                    Margin="0,0,4,0" />
                            <Button Content="输出目录"
                                    Style="{StaticResource GlassButton}"
                                    Command="{Binding OpenFolderCommand}"
                                    Background="#14B8A6" BorderBrush="#14B8A6"
                                    Margin="4,0,0,0" />
                        </UniformGrid>

                        <TextBlock Text="处理操作" Style="{StaticResource SectionHeader}" />
                        <Button Content="开始修复"
                                Style="{StaticResource GlassButton}"
                                Command="{Binding ProcessImageCommand}"
                                MinHeight="40"
                                Background="#22C55E" BorderBrush="#22C55E"
                                Margin="0,0,0,10" />
                        <Button Content="批量修复"
                                Style="{StaticResource GlassButton}"
                                Command="{Binding ProcessBatchCommand}"
                                MinHeight="40"
                                Background="#F59E0B" BorderBrush="#F59E0B" />

                        <ProgressBar Height="6"
                                     Margin="0,12,0,0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding BatchProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsBatchIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding BatchProgressText}"
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                   Margin="0,6,0,0">
                            <TextBlock.Visibility>
                                <Binding Path="IsBusy" Converter="{StaticResource BoolToVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>

                        <TextBlock Text="输出" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="目标目录" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding OutputFolder, Mode=TwoWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Background="#0B1220" Foreground="#E2E8F0"
                                 BorderBrush="#334155" Padding="6,5" />

                        <TextBlock Text="状态" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding StatusText}" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：预览界面 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="预览界面" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding SelectedFileName}" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#020817" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="请先点击「打开图片」加载预览"
                                       Foreground="#475569" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding CurrentImageSource}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="图像尺寸" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding ImageSizeText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="12,0">
                            <StackPanel>
                                <TextBlock Text="处理方式" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding SelectedMode}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="处理状态" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding StatusText}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

                    <!-- ==================== 最近打开 ==================== -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="最近打开：" Foreground="#CBD5E1" VerticalAlignment="Center" />
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto" MaxHeight="34">
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="8" Padding="8,4" Margin="4,0,0,0"
                                        ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab_Video}" Style="{StaticResource WorkbenchTabItem}">
                <views:VideoProcessingView />
            </TabItem>
        </TabControl>

        <!--  TabControl 仅承载页签；内容放在独立宿主中，避免内容被 TabControl 的自动化树屏蔽  -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16">
            <ContentControl Content="{Binding SelectedContent, ElementName=WorkbenchTabs}" />
        </Border>
    </Grid>
</Window>
