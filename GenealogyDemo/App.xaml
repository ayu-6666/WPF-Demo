<Application x:Class="GenealogyDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cn="clr-namespace:GenealogyDemo.Converters"
             xmlns:vm="clr-namespace:GenealogyDemo.ViewModels"
             xmlns:local="clr-namespace:System.Windows.Media.Converters;assembly=WindowsBase"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Icons (simple geometries) -->
        <DrawingImage x:Key="SymbolAdd">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF007ACC" Geometry="F1 M 0,0 L 8,0 L 8,8 L 0,8 Z M 2,4 L 6,4 M 4,2 L 4,6"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="SymbolEdit">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF007ACC" Geometry="F1 M 0,0 L 5,0 L 5,5 L 0,5 Z M 2,2 L 4,4"/>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="SymbolDelete">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FFD83B01" Geometry="F1 M 0,0 L 6,0 L 6,6 L 0,6 Z M 1,1 L 5,5 M 5,1 L 1,5"/>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
