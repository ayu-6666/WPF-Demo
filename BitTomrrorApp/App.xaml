<Application x:Class="BitTomrrorApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BitTomrrorApp"
             xmlns:conv="clr-namespace:BitTomrrorApp.Convertors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StateToColorConverter x:Key="StateToColorConverter"/>
            <conv:StateToPauseIconConverter x:Key="StateToPauseIconConverter"/>

            <!-- 主题色与画板 -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3F51B5"/>
            <SolidColorBrush x:Key="AppTitleBarBrush" Color="#283593"/>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6FA"/>
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="White"/>

            <!-- 全局按钮：圆角 + 阴影 -->
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <!-- 卡片样式 --><!--
            <Style TargetType="{x:Type materialDesign:Card}" BasedOn="{StaticResource MaterialDesignCard}">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>-->

            <!-- 圆角输入框 -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
