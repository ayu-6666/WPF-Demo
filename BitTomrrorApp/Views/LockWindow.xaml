<Window x:Class="BitTomrrorApp.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="极速资源下载器已锁定" Height="360" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#1A2A4A" BlurRadius="22" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AppTitleBarBrush}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconMaterial Kind="Lock" Foreground="White" Width="18" Height="18"/>
                    <TextBlock Text="应用已锁定" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">
                <iconPacks:PackIconMaterial Kind="ShieldLockOutline" Width="56" Height="56" Foreground="#3F51B5"
                                            HorizontalAlignment="Center"/>
                <TextBlock Text="请输入启动密码以继续" FontSize="14" FontWeight="Medium" Foreground="#37474F"
                           HorizontalAlignment="Center" Margin="0,14,0,16"/>
                <PasswordBox x:Name="PasswordBox" md:HintAssist.Hint="启动密码"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             KeyDown="PasswordBox_KeyDown"/>
                <TextBlock x:Name="ErrorText" Foreground="#E53935" FontSize="12" Margin="2,8,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button Content="解锁" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,16,0,0"
                        Click="Unlock_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
