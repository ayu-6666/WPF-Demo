<Window x:Class="BitTomrrorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BitTomrrorApp"
        xmlns:models="clr-namespace:BitTomrrorApp.Models"
        xmlns:vm="clr-namespace:BitTomrrorApp.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="极速资源下载器" Height="840" Width="960"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors" >
    <i:Interaction.Triggers>
            <i:EventTrigger  EventName="Loaded" >
                <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
            </i:EventTrigger>
        </i:Interaction.Triggers>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <!-- 数据模板：列表项卡片 -->
        <DataTemplate DataType="{x:Type models:TorrentItem}">
            <md:Card Margin="6" UniformCornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 状态指示色条 -->
                    <Border Grid.Column="0" Width="4" HorizontalAlignment="Left"
                            CornerRadius="2" Margin="-6,0,4,0"
                            Background="{Binding State, Converter={StaticResource StateToColorConverter}}"/>

                    <!-- 种子信息 + 进度 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" Foreground="#212121"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding SizeDisplay}" Foreground="#757575" FontSize="11.5"/>
                            <TextBlock Text=" · " Foreground="#BDBDBD"/>
                            <TextBlock Text="{Binding RemainingTime}" Foreground="#9E9E9E" FontSize="11.5"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                    </StackPanel>

                    <!-- 下载/上传速度 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ArrowDown" Width="14" Height="14"
                                                        Foreground="#43A047" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DownloadSpeed}" Foreground="#43A047"
                                       FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <iconPacks:PackIconMaterial Kind="ArrowUp" Width="14" Height="14"
                                                        Foreground="#FB8C00" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UploadSpeed}" Foreground="#FB8C00"
                                       FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 状态徽章 -->
                    <Border Grid.Column="3" CornerRadius="11" Padding="10,3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{Binding State, Converter={StaticResource StateToColorConverter}}">
                        <TextBlock Text="{Binding State}" Foreground="White"
                                   FontSize="11" FontWeight="Medium"/>
                    </Border>

                    <!-- 单项操作按钮 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="暂停/继续">
                            <iconPacks:PackIconMaterial Kind="{Binding State, Converter={StaticResource StateToPauseIconConverter}}"/>
                        </Button>
                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="2,0,0,0" ToolTip="删除">
                            <iconPacks:PackIconMaterial Kind="Delete" Foreground="#E53935"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </md:Card>
        </DataTemplate>
    </Window.Resources>

    <!-- 主窗口边框：圆角 + 投影 -->
    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#1A2A4A" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>  <!-- 标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 添加任务条 -->
                <RowDefinition Height="*"/>    <!-- 列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态/批量 -->
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource AppTitleBarBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <iconPacks:PackIconMaterial Kind="Download" Foreground="White" Width="22" Height="22"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="极速资源下载器" Foreground="White" FontSize="14"
                                   FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BitTomrror App" Foreground="#B0BEC5" FontSize="11"
                                   Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="最小化" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="最大化/还原" Background="Transparent">
                            <iconPacks:PackIconMaterial x:Name="MaxIcon" Kind="WindowMaximize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button Click="BtnClose_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="关闭" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 添加任务条 -->
            <Border Grid.Row="1" Background="White" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             md:HintAssist.Hint="粘贴磁力链接资源文件路径"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:TextFieldAssist.TextFieldCornerRadius="8"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Margin="12,0,0,0"
                            Command="{Binding AddTorrentCommand}" Height="44"
                            CommandParameter="{Binding Text, ElementName=InputBox}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="添加任务" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="8,0,0,0" Height="44"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="SelectFile_Click" ToolTip="选择 .torrent 文件">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileUpload" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="选择资源" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 列表区 -->
            <Grid Grid.Row="2" Margin="20 1" Background="Transparent">
                <!-- 空状态 -->
                <Border x:Name="EmptyState" Background="Transparent" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CloudDownloadOutline" Width="80" Height="80"
                                                    Foreground="blue" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有下载任务" FontSize="16" FontWeight="Medium"
                                   Foreground="#90A4AE" Margin="0,16,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="添加磁力链接或选择 .torrent 文件开始下载" FontSize="12.5"
                                   Foreground="#B0BEC5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListView x:Name="TorrentList" Visibility="Collapsed"
                          Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding TorrentItems}"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>

            <!-- 底部状态栏 + 批量操作 -->
            <Border Grid.Row="3" Background="White" Padding="20,10"
                    BorderBrush="#EEE" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 全局统计 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <iconPacks:PackIconMaterial Kind="ArrowDown" Width="16" Height="16"
                                                        Foreground="#43A047" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalDown" Text="0 KB/s" Foreground="#43A047"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <iconPacks:PackIconMaterial Kind="ArrowUp" Width="16" Height="16"
                                                        Foreground="#FB8C00" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalUp" Text="0 KB/s" Foreground="#FB8C00"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TaskCount" Text="0 个任务" Foreground="#9E9E9E"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 批量按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding BatchPauseCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TorrentList}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pause" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="批量暂停" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BatchDeleteCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TorrentList}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="批量删除" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
