<Window x:Class="BitTomrrorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BitTomrrorApp"
        xmlns:models="clr-namespace:BitTomrrorApp.Models"
        xmlns:vm="clr-namespace:BitTomrrorApp.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="极速资源下载器" Height="840" Width="960"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:DownloadTask}">
            <md:Card Margin="6" UniformCornerRadius="10">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="4" HorizontalAlignment="Left" CornerRadius="2" Margin="-6,0,4,0"
                            Background="{Binding Status, Converter={StaticResource StateToColorConverter}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#ECEFF1" CornerRadius="4" Padding="5,1" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#455A64"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis" Foreground="#212121" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,3">
                            <TextBlock Text="{Binding DownloadedText}" Foreground="#757575" FontSize="11.5"/>
                            <TextBlock Text=" · " Foreground="#BDBDBD"/>
                            <TextBlock Text="{Binding RemainingText}" Foreground="#9E9E9E" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PeerText}" Foreground="#90A4AE" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                        <TextBlock Text="{Binding ErrorText}" Foreground="#D32F2F" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ArrowDown" Width="14" Height="14"
                                                        Foreground="#43A047" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#43A047"
                                       FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <iconPacks:PackIconMaterial Kind="ArrowUp" Width="14" Height="14"
                                                        Foreground="#FB8C00" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UploadSpeedText}" Foreground="#FB8C00"
                                       FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="11" Padding="10,3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{Binding Status, Converter={StaticResource StateToColorConverter}}">
                        <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="暂停/继续">
                            <iconPacks:PackIconMaterial Kind="{Binding Status, Converter={StaticResource StateToPauseIconConverter}}"/>
                        </Button>
                        <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="2,0,0,0" ToolTip="打开保存目录">
                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Foreground="#546E7A"/>
                        </Button>
                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="2,0,0,0" ToolTip="删除任务">
                            <iconPacks:PackIconMaterial Kind="Delete" Foreground="#E53935"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </md:Card>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#1A2A4A" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource AppTitleBarBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <iconPacks:PackIconMaterial Kind="Download" Foreground="White" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="极速资源下载器" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BT · HTTP · M3U8 · Telegram · FTP" Foreground="#B0BEC5" FontSize="11"
                                   Margin="10,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="BtnSettings" Click="BtnSettings_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="个人设置中心（FTP / Telegram / 安全）" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="最小化" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="最大化/还原" Background="Transparent">
                            <iconPacks:PackIconMaterial x:Name="MaxIcon" Kind="WindowMaximize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button Click="BtnClose_Click" Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" ToolTip="关闭" Background="Transparent">
                            <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             md:HintAssist.Hint="粘贴磁力链接 / http(s) 直链 / m3u8 地址 / .torrent 文件路径"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:TextFieldAssist.TextFieldCornerRadius="8"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Margin="12,0,0,0"
                            Command="{Binding AddTorrentCommand}" Height="44"
                            CommandParameter="{Binding Text, ElementName=InputBox}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="添加任务" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="8,0,0,0" Height="44"
                            Command="{Binding AddAdvancedCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="选择类型并配置完整参数">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Tune" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="高级添加" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Margin="8,0,0,0" Height="44"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="SelectFile_Click" ToolTip="选择 .torrent 文件">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileUpload" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="选择种子" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,1" Background="Transparent">
                <Border Background="Transparent"
                        Visibility="{Binding Managed.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CloudDownloadOutline" Width="80" Height="80"
                                                    Foreground="#3F51B5" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有下载任务" FontSize="16" FontWeight="Medium"
                                   Foreground="#90A4AE" Margin="0,16,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="支持 BT 种子/磁力、HTTP 直链、M3U8、Telegram Bot、FTP" FontSize="12.5"
                                   Foreground="#B0BEC5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ListView x:Name="TorrentList" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Tasks}"
                          Visibility="{Binding Managed.HasTasks, Converter={StaticResource BoolToVisibilityConverter}}"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </Grid>

            <Border Grid.Row="3" Background="White" Padding="20,10"
                    BorderBrush="#EEE" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <iconPacks:PackIconMaterial Kind="ArrowDown" Width="16" Height="16" Foreground="#43A047" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Managed.TotalDownloadRateText}" Foreground="#43A047"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <iconPacks:PackIconMaterial Kind="ArrowUp" Width="16" Height="16" Foreground="#FB8C00" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Managed.TotalUploadRateText}" Foreground="#FB8C00"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Managed.TaskSummaryText}" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                        <Border Width="1" Height="16" Background="#E0E0E0" Margin="16,0" VerticalAlignment="Center"/>
                        <iconPacks:PackIconMaterial Kind="Filmstrip" Width="15" Height="15" Foreground="#78909C" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Managed.FfmpegStatusText}" ToolTip="{Binding Managed.FfmpegPathText}"
                                   Foreground="#78909C" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding BatchPauseCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TorrentList}"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Pause" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="批量暂停" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BatchDeleteCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=TorrentList}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="批量删除" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
