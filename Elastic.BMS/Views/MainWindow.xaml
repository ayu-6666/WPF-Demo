<Window x:Class="Elastic.BMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:vm="clr-namespace:Elastic.BMS.ViewModels"
        xmlns:v="clr-namespace:Elastic.BMS.Views"
        Title="电池监控与检测系统" Width="1920" Height="1080" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBgBrush}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft YaHei"
        Foreground="{DynamicResource TextMainBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="84" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RealtimeViewModel}"><v:RealtimeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmRecordsViewModel}"><v:AlarmRecordsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsBasicViewModel}"><v:SettingsBasicView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsCommViewModel}"><v:SettingsCommView /></DataTemplate>

        <!-- 窗控按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BFE4FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- 星空背景 -->
        <Rectangle Fill="{DynamicResource StarBrush}" />

        <!-- ================= 顶栏 ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Grid Grid.Column="0" Width="46" Height="46" HorizontalAlignment="Left" Margin="26,0,0,0"
                  VerticalAlignment="Center">
                <Rectangle RadiusX="2" RadiusY="2" Width="10" Height="26" HorizontalAlignment="Left" Fill="#3FA9FF" />
                <Rectangle RadiusX="2" RadiusY="2" Width="10" Height="34" HorizontalAlignment="Center" Fill="#7FD3FF" />
                <Rectangle RadiusX="2" RadiusY="2" Width="10" Height="20" HorizontalAlignment="Right" Fill="#2E9BFF" />
            </Grid>

            <!-- 居中标题托板 -->
            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,4,0,0" Height="62">
                <Border Width="740" Height="52" CornerRadius="10" VerticalAlignment="Top"
                        BorderBrush="#3FA9FF" BorderThickness="1.2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00123875" Offset="0" />
                            <GradientStop Color="#66265CA8" Offset="0.5" />
                            <GradientStop Color="#00123875" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#2E9BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.75" /></Border.Effect>
                </Border>
                <Border Width="560" Height="34" CornerRadius="8" VerticalAlignment="Top" Margin="0,9,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#CC1A62B8" Offset="0.5" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="电池监控与检测系统" FontSize="32" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,-10,0,0">
                    <TextBlock.Effect><DropShadowEffect Color="#9FDEFF" BlurRadius="18" ShadowDepth="0" Opacity="0.9" /></TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- 时间 + 退出 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="{Binding DateText}" FontSize="17" Foreground="#DCEBFF" VerticalAlignment="Center" />
                <Button Style="{StaticResource ExitButton}" Content="退 出" Margin="20,0,0,0"
                        Click="OnExit" />
            </StackPanel>
        </Grid>

        <!-- ================= 内容区 ================= -->
        <Grid Grid.Row="1" Margin="18,4,18,4">
            <Border CornerRadius="16" BorderThickness="2"
                    BorderBrush="{DynamicResource CardBorderBrush}" Background="#080A2246">
                <Border.Effect><DropShadowEffect Color="#2E9BFF" BlurRadius="24" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
            </Border>
            <Path Width="34" Height="34" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M2,20 L2,7 Q2,2 7,2 L20,2" Stroke="#62D8FF" StrokeThickness="2.2" />
            <Path Width="34" Height="34" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M2,20 L2,7 Q2,2 7,2 L20,2" Stroke="#62D8FF" StrokeThickness="2.2">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
            </Path>
            <Path Width="34" Height="34" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Data="M2,20 L2,7 Q2,2 7,2 L20,2" Stroke="#62D8FF" StrokeThickness="2.2">
                <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
            </Path>
            <Path Width="34" Height="34" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M2,20 L2,7 Q2,2 7,2 L20,2" Stroke="#62D8FF" StrokeThickness="2.2">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
            </Path>

            <ContentControl Content="{Binding CurrentViewModel}" Margin="16,12,16,12" />
        </Grid>

        <!-- ================= 底部导航 ================= -->
        <Grid Grid.Row="2">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="33"
                    Background="#0B1830" BorderBrush="#1E5C99" BorderThickness="1.2" Padding="8,6">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="18" ShadowDepth="0" Opacity="0.6" /></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[0]}"
                                     IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=dashboard, Mode=OneWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}" />
                        <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[1]}"
                                     IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=realtime, Mode=OneWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}" />
                        <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[2]}"
                                     IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=alarm, Mode=OneWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}" />
                        <RadioButton Style="{StaticResource BottomNavStyle}" DataContext="{Binding BottomNavs[3]}"
                                     IsChecked="{Binding DataContext.CurrentPageKey, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToBool}, ConverterParameter=settings, Mode=OneWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     CommandParameter="{Binding}" />
                    </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
