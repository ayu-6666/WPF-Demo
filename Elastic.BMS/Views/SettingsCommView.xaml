<UserControl x:Class="Elastic.BMS.Views.SettingsCommView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,26,0,0">

        <!-- ================= 网络通信设置 ================= -->
        <Border Width="400" Height="290" Margin="62,0,0,0" CornerRadius="6" Background="#F2F6FC"
                BorderBrush="#B9CCE6" BorderThickness="1">
            <Grid Margin="26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="网络通信设置" FontSize="17" FontWeight="Bold" Foreground="#16233C"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="164" Height="28" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#9DB8DC" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBox Text="{Binding Ip, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     Foreground="#16233C" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="164" Height="28" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#9DB8DC" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBox Text="{Binding Port, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     Foreground="#16233C" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Width="66" Height="28" />
                    <Button Style="{StaticResource WhiteButton}" Content="取消" Width="66" Height="28" Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 串口设置 ================= -->
        <Border Width="400" Height="440" Margin="62,0,0,0" CornerRadius="6" Background="#F2F6FC"
                BorderBrush="#B9CCE6" BorderThickness="1">
            <Grid Margin="26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="串口设置" FontSize="17" FontWeight="Bold" Foreground="#16233C"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="164" Height="28" HorizontalAlignment="Left"
                                  FontSize="14" Foreground="#16233C"
                                  ItemsSource="{Binding PortOptions}"
                                  SelectedItem="{Binding SelectedCommPort, Mode=TwoWay}" />
                    </Grid>
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="波特率" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="164" Height="28" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#9DB8DC" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBox Text="{Binding BaudRate, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     Foreground="#16233C" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数据位" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="164" Height="28" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#9DB8DC" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBox Text="{Binding DataBits, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     Foreground="#16233C" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="停止位" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="164" Height="28" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#9DB8DC" BorderThickness="1" HorizontalAlignment="Left">
                            <TextBox Text="{Binding StopBits, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                     Foreground="#16233C" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="奇偶校验位" FontSize="15" Foreground="#16233C" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="164" Height="28" HorizontalAlignment="Left"
                                  FontSize="14" Foreground="#16233C"
                                  ItemsSource="{Binding ParityOptions}"
                                  SelectedItem="{Binding Parity, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Width="66" Height="28" />
                    <Button Style="{StaticResource WhiteButton}" Content="取消" Width="66" Height="28" Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
