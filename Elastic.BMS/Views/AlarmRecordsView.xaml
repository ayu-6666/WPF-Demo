<UserControl x:Class="Elastic.BMS.Views.AlarmRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#DCEBFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#EAF4FF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="IndexTpl">
            <TextBlock Text="{Binding Index}" FontSize="13" Foreground="#16233C" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 筛选栏 ================= -->
        <Grid Grid.Row="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FilterLabel}" Text="时间" Margin="6,0,14,0" />
                <TextBox Style="{StaticResource SciTextBox}" Width="170" Text="{Binding StartDate, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FilterLabel}" Text="—" Margin="12,0" />
                <TextBox Style="{StaticResource SciTextBox}" Width="170" Text="{Binding EndDate, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource FilterLabel}" Text="类型" Margin="42,0,14,0" />
                <ComboBox Style="{StaticResource SciComboBox}" Width="170"
                          ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" />

                <Button Style="{StaticResource PrimaryButton}" Content="查询" Width="86" Height="32" Margin="26,0,0,0" />
                <Button Style="{StaticResource DarkButton}" Content="重置按钮" Width="96" Height="32" Margin="14,0,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource WhiteButton}" Content="导出" Width="90" Height="32" />
        </Grid>

        <!-- ================= 表格 ================= -->
        <Border Grid.Row="2" BorderBrush="#8FB6E8" BorderThickness="1.2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Background="#0F2449">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeader}" Text="序号" Margin="0"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeader}" Text="标题" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeader}" Text="报警信息" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeader}" Text="时间" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeader}" Text="类型" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeader}" Text="状态" />
                    <TextBlock Grid.Column="6" Style="{StaticResource TableHeader}" Text="处理" />
                </Grid>

                <!-- 数据行 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Records}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25" Background="White">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="7" BorderBrush="#9DB8DC" BorderThickness="0,0,0,1"
                                        VerticalAlignment="Bottom" />
                                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource IndexTpl}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Info}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Type}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Status}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding Handle}" FontSize="13" Foreground="#16233C"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ================= 分页 ================= -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
            <Button Style="{StaticResource DarkButton}" Content="上一页" Width="86" Height="30" />
            <Border Width="76" Height="30" Margin="16,0" CornerRadius="4" Background="#0F2449"
                    BorderBrush="#2E5C8A" BorderThickness="1">
                <TextBlock Text="{Binding PageText}" FontSize="14" Foreground="#DCEBFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource DarkButton}" Content="下一页" Width="86" Height="30" />
        </StackPanel>
    </Grid>
</UserControl>
