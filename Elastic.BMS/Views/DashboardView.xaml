<UserControl x:Class="Elastic.BMS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Elastic.BMS.Controls"
             xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <!-- 图表点 -->
        <Style x:Key="ChartDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="-2.5,-2.5,0,0" />
        </Style>
        <Style x:Key="DotContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <ItemsPanelTemplate x:Key="DotCanvas">
            <Canvas Width="1000" Height="210" />
        </ItemsPanelTemplate>

        <!-- 2x2 运行数据单元 -->
        <DataTemplate x:Key="RunStatTpl">
            <Border BorderBrush="#254970" BorderThickness="1" Margin="-0.5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="{Binding Label}" FontSize="15" Foreground="#EAF4FF" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Bold" Foreground="#34D399"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Unit}" FontSize="14" Foreground="#34D399"
                               Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="2.32*" />
        </Grid.RowDefinitions>

        <!-- ================= 总体状态 ================= -->
        <ctl:SciCard Grid.Row="0" Grid.Column="0" Title="总体状态">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 三个指标 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="0,4,0,10">
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="#F5B82E">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGreen}" Value="True">
                                                    <Setter Property="Foreground" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Label}" FontSize="15" Foreground="#DCEBFF"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2x2 图标统计框 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding MetricBoxes}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" Rows="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" Height="96" CornerRadius="4" Background="#C9D2DE" Opacity="0.92">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <md:PackIcon Kind="{Binding Icon}" Width="30" Height="30" Foreground="#7C4DFF"
                                                 VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                                        <TextBlock Text="{Binding Label}" FontSize="14" Foreground="#4A5A72" />
                                        <TextBlock Text="{Binding Value}" FontSize="16" Foreground="#16233C" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ctl:SciCard>

        <!-- ================= 电池组3D模型 ================= -->
        <Border Grid.Row="0" Grid.Column="2" Background="#0A1832"
                BorderBrush="#2E7DB8" BorderThickness="1.2">
            <Grid>
                <Path Data="M0,0 L1,1" Stretch="Fill" Stroke="#37547F" StrokeThickness="1" />
                <Path Data="M1,0 L0,1" Stretch="Fill" Stroke="#37547F" StrokeThickness="1" />
                <TextBlock Text="电池组3D模型" FontSize="20" Foreground="#EAF4FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 当前电芯状态 ================= -->
        <ctl:SciCard Grid.Row="0" Grid.Column="4" Title="当前电芯状态">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 圆形水位仪表盘 + 容量信息 -->
                <Grid Grid.Row="0" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="104" Height="104">
                        <Ellipse Stroke="#2E6FA8" StrokeThickness="8" Fill="#0B2049" />
                        <Grid Width="84" Height="84">
                            <Grid.Clip>
                                <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42" />
                            </Grid.Clip>
                            <Rectangle Fill="#0E2A56" />
                            <Rectangle Height="50.4" VerticalAlignment="Bottom">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7FD3FF" Offset="0" />
                                        <GradientStop Color="#1E88F0" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Data="M0,4 Q10.5,-4 21,4 T42,4 T63,4 T84,4 L84,8 L0,8 Z"
                                  Fill="#99BFE6FF" VerticalAlignment="Top" Margin="0,38,0,0" />
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Margin="24,0,0,0" BorderBrush="#2E5C8A" BorderThickness="1.2">
                        <Grid Margin="18,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="容量" FontSize="15" Foreground="#EAF4FF" />
                                <TextBlock Text="{Binding CapacityText}" FontSize="16" Foreground="#FFFFFF" Margin="16,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="剩余电量" FontSize="15" Foreground="#EAF4FF" />
                                <TextBlock Text="{Binding RemainText}" FontSize="16" Foreground="#FFFFFF" Margin="16,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 运行数据 2x2 -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding RunStats}" ItemTemplate="{StaticResource RunStatTpl}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" Rows="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ctl:SciCard>

        <!-- ================= 实时数据统计 ================= -->
        <ctl:SciCard Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Title="实时数据统计">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 图例 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Legends}" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,34,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding ColorHex}" />
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#DCEBFF" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 折线图 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="210" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>

                    <!-- Y 轴刻度 -->
                    <Canvas Grid.Row="0" Grid.Column="0" Width="36" Height="210" ClipToBounds="False">
                        <TextBlock Text="100" FontSize="12" Foreground="#8FB3D9" Canvas.Top="-8" Canvas.Left="6" />
                        <TextBlock Text="80" FontSize="12" Foreground="#8FB3D9" Canvas.Top="34" Canvas.Left="14" />
                        <TextBlock Text="60" FontSize="12" Foreground="#8FB3D9" Canvas.Top="76" Canvas.Left="14" />
                        <TextBlock Text="40" FontSize="12" Foreground="#8FB3D9" Canvas.Top="118" Canvas.Left="14" />
                        <TextBlock Text="20" FontSize="12" Foreground="#8FB3D9" Canvas.Top="160" Canvas.Left="14" />
                        <TextBlock Text="0" FontSize="12" Foreground="#8FB3D9" Canvas.Top="202" Canvas.Left="14" />
                    </Canvas>

                    <!-- 绘图区 -->
                    <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Fill" Height="210">
                        <Canvas Width="1000" Height="210">
                            <Rectangle Width="1000" Height="1" Canvas.Top="42" Fill="#1C3760" />
                            <Rectangle Width="1000" Height="1" Canvas.Top="84" Fill="#1C3760" />
                            <Rectangle Width="1000" Height="1" Canvas.Top="126" Fill="#1C3760" />
                            <Rectangle Width="1000" Height="1" Canvas.Top="168" Fill="#1C3760" />
                            <Rectangle Width="1000" Height="1" Canvas.Top="209" Fill="#1C3760" />

                            <Polyline Points="{Binding SocPoints}" Stroke="#4FB3FF" StrokeThickness="2" />
                            <Polyline Points="{Binding SohPoints}" Stroke="#A9D4FF" StrokeThickness="2" />

                            <ItemsControl ItemsSource="{Binding SocPoints}" ItemsPanel="{StaticResource DotCanvas}"
                                          ItemContainerStyle="{StaticResource DotContainer}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Ellipse Style="{StaticResource ChartDot}" Fill="#9FD8FF" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding SohPoints}" ItemsPanel="{StaticResource DotCanvas}"
                                          ItemContainerStyle="{StaticResource DotContainer}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Ellipse Style="{StaticResource ChartDot}" Fill="#CFE8FF" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>

                    <!-- X 轴刻度 -->
                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding XLabels}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#8FB3D9" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ctl:SciCard>

        <!-- ================= 异常报警 ================= -->
        <ctl:SciCard Grid.Row="2" Grid.Column="4" Title="异常报警">
            <ItemsControl ItemsSource="{Binding Alarms}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2E5C8A" BorderThickness="1.2" Margin="0,0,0,9" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Time}" FontSize="13" Foreground="#8FB3D9" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#EAF4FF" Margin="20,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ButtonText}" Width="52" Height="26"
                                        FontSize="13" Foreground="White" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="4" Background="#E2453C">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border.RenderTransform><TransformGroup /></Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF6A60" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ctl:SciCard>
    </Grid>
</UserControl>
