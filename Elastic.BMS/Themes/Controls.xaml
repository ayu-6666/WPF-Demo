<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Elastic.BMS.Controls"
                    xmlns:conv="clr-namespace:Elastic.BMS.Core"
                    xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">

    <!-- ================= 转换器 ================= -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:EqToBoolConverter x:Key="EqToBool" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />

    <!-- ================= 基础文字 ================= -->
    <!-- 注意：此处不设置 Foreground，改由窗口/用户控件根节点继承，
         否则会覆盖按钮等控件自身的 Foreground，导致白底按钮文字不可见 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 分组大标题（亮蓝粗体） -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#3FA9FF" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= SciCard 科技卡片 ================= -->
    <Style TargetType="{x:Type ctl:SciCard}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SciCard}">
                    <Grid>
                        <Border x:Name="CardBorder"
                                CornerRadius="{TemplateBinding CornerRadiusValue}"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.2" />
                        <!-- 四角折线 -->
                        <Path Width="20" Height="20" Margin="5"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Data="M2,12 L2,5 Q2,2 5,2 L12,2"
                              Stroke="#62D8FF" StrokeThickness="1.6" Stretch="None" />
                        <Path Width="20" Height="20" Margin="5"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Data="M2,12 L2,5 Q2,2 5,2 L12,2"
                              Stroke="#62D8FF" StrokeThickness="1.6" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                        </Path>
                        <Path Width="20" Height="20" Margin="5"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Data="M2,12 L2,5 Q2,2 5,2 L12,2"
                              Stroke="#62D8FF" StrokeThickness="1.6" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
                        </Path>
                        <Path Width="20" Height="20" Margin="5"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Data="M2,12 L2,5 Q2,2 5,2 L12,2"
                              Stroke="#62D8FF" StrokeThickness="1.6" Stretch="None">
                            <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
                        </Path>

                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <Border Grid.Row="0" Height="38"
                                    Visibility="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVis}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2E7DB8" Offset="0" />
                                        <GradientStop Color="#1A4A80" Offset="0.55" />
                                        <GradientStop Color="#0E2C56" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="Bold"
                                           Foreground="#EAF6FF" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Border>

                            <ContentPresenter Grid.Row="1" Margin="14,10,14,14" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 蓝色主按钮 ================= -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" Background="{DynamicResource PrimaryButtonBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 白底按钮 -->
    <Style x:Key="WhiteButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" Background="#F4F8FF" BorderBrush="#B9D2F2" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DDEAFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色按钮 -->
    <Style x:Key="DarkButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#132B57" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶部退出按钮 -->
    <Style x:Key="ExitButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Background="#EAF2FF" BorderBrush="#9DBEE6" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CFE4FF" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TextBox ================= -->
    <!-- 深色输入框（报警记录筛选） -->
    <Style x:Key="SciTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="CaretBrush" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="5" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5FC0FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 下拉框 ================= -->
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="12,8" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B4E9C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色下拉（报警记录-类型） -->
    <Style x:Key="SciComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="5" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1">
                                        <Grid>
                                            <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path HorizontalAlignment="Right" Margin="0,0,10,0"
                                                  Data="M0,0 L8,0 L4,5 Z" Fill="#7FB6E8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5FC0FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,4" Background="#0C1E42" BorderBrush="#3A6BA6" BorderThickness="1" CornerRadius="5">
                                <Border.Effect><DropShadowEffect Color="#000" BlurRadius="14" ShadowDepth="3" Opacity="0.6" /></Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WhiteComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="12,8" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DDEAFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 白底下拉（Pack / 端口 / 奇偶校验位） -->
    <Style x:Key="WhiteComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Width" Value="120" />
        <Setter Property="Foreground" Value="#15294C" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource WhiteComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="3" Background="White" BorderBrush="#9DB8DC" BorderThickness="1">
                                        <Grid>
                                            <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path HorizontalAlignment="Right" Margin="0,0,8,0"
                                                  Data="M0,0 L7,0 L3.5,4 Z" Fill="#5A7299" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,4" Background="White" BorderBrush="#B9D2F2" BorderThickness="1" CornerRadius="3">
                                <Border.Effect><DropShadowEffect Color="#000" BlurRadius="14" ShadowDepth="3" Opacity="0.45" /></Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 系统设置 Tab ================= -->
    <Style x:Key="BmsTabToggle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#D6E7FA" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6,6,0,0" Background="#12294F"
                            BorderBrush="#2E7DB8" BorderThickness="1,1,1,0" Padding="16,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF" />
                            <Setter Property="Foreground" Value="#1268D6" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#7FD3FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 底部导航 ================= -->
    <Style x:Key="BottomNavStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#CFE4FA" />
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="35" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Pill" CornerRadius="5" Background="Transparent" Padding="22,9" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <md:PackIcon Kind="{Binding Icon}" Width="40" Height="20" VerticalAlignment="Center"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{Binding Label}" Margin="10,0,9,0" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <Rectangle x:Name="Mark" Width="7" Height="7" Fill="#5FD0FF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="Mark" Property="Fill" Value="#1268D6" />
                            <Setter Property="Foreground" Value="#1268D6" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#1B4E9C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
